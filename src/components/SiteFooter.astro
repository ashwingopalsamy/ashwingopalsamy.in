---
import { site } from "../data/home";
import { buildMeta } from "../lib/build";
import SoundToggle from "./SoundToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

const shortSha = buildMeta.commit;
---

<footer class="site-footer">
  <div class="footer-links">
    <a class="footer-link ui-cap ui-cap--quiet ui-cap--40" href="/design/">
      <span class="ui-cap__label">Design</span>
    </a>
    <a class="footer-link ui-cap ui-cap--quiet ui-cap--40" href="/developers/">
      <span class="ui-cap__label">Developers</span>
    </a>
    <a class="footer-link ui-cap ui-cap--quiet ui-cap--40" href="/colophon/">
      <span class="ui-cap__label">Colophon</span>
    </a>
  </div>

  <button
    id="local-time"
    type="button"
    class="clock ui-cap ui-cap--quiet ui-cap--40 ui-cap--lead"
    aria-label="Pollachi time"
  >
    <span class="dot" aria-hidden="true"></span>
    <span id="clock-time" class="clock-time ui-cap__label" aria-hidden="true"><span class="digit-slot"><span class="digit-face">0</span></span><span class="digit-slot"><span class="digit-face">0</span></span><span class="digit-sep">:</span><span class="digit-slot"><span class="digit-face">0</span></span><span class="digit-slot"><span class="digit-face">0</span></span></span>
    <span class="clock-place ui-cap__label" aria-hidden="true">Pollachi</span>
    <span class="ui-tip ui-tip--above" role="tooltip">Pollachi time</span>
  </button>

  <div class="footer-dock" role="group" aria-label="Footer controls">
    <a
      class="repo-btn ui-cap ui-cap--quiet ui-cap--40 ui-cap--icon"
      href={shortSha ? `${site.repoUrl}/commit/${shortSha}` : site.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={shortSha ? `Source code at commit ${shortSha}` : "View source code on GitHub"}
    >
      <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span class="ui-tip ui-tip--above" role="tooltip"><span>Source{shortSha && <> · <span class="repo-sha">{shortSha}</span></>}</span></span>
    </a>
    <SoundToggle />
    <ThemeToggle />
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto;
    align-items: center;
    column-gap: var(--step-4);
    row-gap: var(--step-3);
    margin-top: var(--space-footer, 2.75rem);
    padding: var(--step-4) 0 calc(var(--step-6) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--muted);
    user-select: none;
    transition:
      border-color var(--t-color),
      color var(--t-color);
  }

  .footer-links {
    display: flex;
    grid-column: 2;
    grid-row: 1;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
  }

  /* the links' hit areas grow only above and below: sideways the
     neighbours already touch */
  .footer-link::before {
    inset-inline: 0;
  }

  /* the dock holds its circles at muted, ink on hover and press */
  .repo-btn.ui-cap--quiet {
    color: var(--muted);
    -webkit-touch-callout: none;
  }

  .repo-btn.ui-cap--quiet:active {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .repo-btn.ui-cap--quiet:hover {
      color: var(--ink);
    }
  }

  .repo-sha {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: calc(var(--text-xs) * 0.92);
    color: var(--muted);
  }

  /* Plain inline content: the dot sits on the rail, and the hover wash
     bleeds into the gutter the way a hung quiet capsule's does. */
  .clock {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    max-inline-size: 100%;
    min-inline-size: 0;
    margin-inline-start: calc((var(--cap-px) - var(--cap-icon-trim) + 1px) * -1);
    user-select: none;
  }

  /* wider than the capsule, and the dot is at the rail's edge: flush with
     the rail rather than centred past the gutter */
  .clock > .ui-tip {
    inset-inline-start: calc(var(--cap-px) - var(--cap-icon-trim));
    translate: none;
    transform-origin: 0 100%;
  }

  .clock-time {
    display: inline-flex;
    align-items: center;
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: var(--text-ui-sm);
    font-weight: var(--font-normal);
    letter-spacing: 0;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    line-height: 1;
  }

  .clock-place {
    font-size: var(--text-ui-sm);
    font-weight: var(--font-normal);
    color: var(--ghost);
  }

  .digit-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    inline-size: 0.6em;
    text-align: center;
  }

  /* A digit arrives from 50% below, blurred, and sharpens. The blur radius
     is never animated: the script cross-fades the sharp face against this
     copy, whose blur is fixed at the gesture's peak (2px) and so rasterises
     once. Only the copy's opacity and the slot's transform move, and the
     copy exists only for the length of one tick. */
  .digit-ghost {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    filter: blur(2px);
    pointer-events: none;
  }

  .digit-sep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 0.35em;
    text-align: center;
    color: var(--faint);
    line-height: 1;
    user-select: none;
  }

  .dot {
    --presence: var(--acc-green);
    position: relative;
    inline-size: calc(var(--step) * 2);
    block-size: calc(var(--step) * 2);
    flex: none;
    border-radius: 50%;
    background: var(--presence);
    transition: background-color var(--t-color);
  }

  /* The pulse ring is a same-colour disc concentric with the dot, so it is
     invisible over the dot and reads as a ring outside it. Scaling 8px to
     16px gives the 0 to 4px band a box-shadow spread would draw, on
     transform + opacity instead of paint. */
  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: color-mix(in oklch, var(--presence) 50%, transparent);
    opacity: 0;
    pointer-events: none;
    animation: dot-pulse var(--dur-pulse) var(--ease-pulse) infinite;
  }

  .clock[data-idle] .dot::after {
    animation-play-state: paused;
  }

  @keyframes dot-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* three bare 40 circles in a row, no track. The last glyph's edge, not
     its circle's, sits on the rail (the 18px theme glyph centred in 40). */
  .footer-dock {
    --dock-hang: calc((var(--cap-40) - var(--step) * 4.5) / 2);
    display: inline-flex;
    grid-column: 3;
    grid-row: 1;
    align-items: center;
    justify-self: end;
    gap: var(--step-1);
    margin-inline-end: calc(var(--dock-hang) * -1);
  }

  /* The last circle's tooltip is flush with the rail rather than centred
     past the gutter. Named, not :last-child: dev leaves the toggles'
     <script>s between the buttons. */
  .footer-dock :global(.theme-toggle > .ui-tip) {
    inset-inline-start: auto;
    inset-inline-end: calc(var(--dock-hang) - 1px);
    translate: none;
    transform-origin: 100% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot::after {
      animation: none;
    }
  }

  @media (max-width: 38rem) {
    .site-footer {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      column-gap: var(--step-2);
      margin-top: clamp(1.75rem, 4vw, 2.5rem);
      padding: 1rem 0 calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }

    .footer-dock {
      grid-column: 2;
    }

    .footer-links {
      grid-column: 1 / -1;
      grid-row: 2;
    }

  }

  @media (max-width: 22rem) {
    .footer-link {
      --cap-px: var(--cap-px-32);
    }

    .clock-place {
      display: none;
    }
  }
</style>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  import { onPageCleanup, pageSignal } from "../scripts/lifecycle";
  import { playAccent } from "../scripts/sound";
  import { tickPresence } from "../scripts/presence";
  import "../scripts/tooltip";

  const ASHWIN_TZ = "Asia/Kolkata";
  const PLACE = "Pollachi";
  const DIGITS = 4;
  const MINUTE = 60_000;
  const visitorTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
  // "Asia/Calcutta" is the legacy name engines still report for Kolkata.
  const sameZone = visitorTz === ASHWIN_TZ || visitorTz === "Asia/Calcutta";
  const visitorPlace = visitorTz.split("/").pop()!.replace(/_/g, " ");
  // The view outlives a page: the document does, and so does the visitor's choice.
  let showYours = false;

  interface ClockContext {
    signal: AbortSignal;
    footer: HTMLElement;
    button: HTMLButtonElement;
    tooltip: HTMLElement | null;
    place: HTMLElement | null;
    dot: HTMLElement | null;
    slots: HTMLElement[];
    faces: HTMLElement[];
    snaps: Array<{ ghost: HTMLElement; animations: Animation[] } | undefined>;
    timer?: ReturnType<typeof setTimeout>;
    inView: boolean;
    lastMinute: number;
  }

  let clock: ClockContext | null = null;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let snapTiming: KeyframeAnimationOptions | undefined;

  /* The tick gesture takes its duration and curve from the motion tokens.
     Read once, on first use: WAAPI cannot resolve var() in timing. */
  function getSnapTiming(): KeyframeAnimationOptions {
    if (!snapTiming) {
      const root = getComputedStyle(document.documentElement);
      snapTiming = {
        duration: parseFloat(root.getPropertyValue("--dur-enter")) || 240,
        easing: root.getPropertyValue("--ease-enter").trim() || "cubic-bezier(0.16, 1, 0.3, 1)",
      };
    }
    return snapTiming;
  }

  const hhmm = (timeZone: string) =>
    new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone,
    });
  const fmtAshwin = hhmm(ASHWIN_TZ);
  const fmtYours = sameZone ? fmtAshwin : hhmm(visitorTz);

  function getTimeDigits(now: Date): string[] {
    const parts: Record<string, string> = {};
    for (const part of (showYours ? fmtYours : fmtAshwin).formatToParts(now)) {
      parts[part.type] = part.value;
    }
    const h = (parts.hour || "00").padStart(2, "0");
    const m = (parts.minute || "00").padStart(2, "0");
    return [h[0]!, h[1]!, m[0]!, m[1]!];
  }

  /* One sentence per view. The tooltip promises the toggle only where there
     is one: a visitor in Pollachi's own zone has nothing to switch to. */
  function viewCopy(): { place: string; tip: string } {
    if (sameZone) return { place: PLACE, tip: "Pollachi time" };
    return showYours
      ? { place: visitorPlace, tip: "Your time, tap for Pollachi" }
      : { place: PLACE, tip: "Pollachi time, tap for yours" };
  }

  /* The incoming footer is swapped in with the live time and the visitor's
     chosen view already showing, so the digits do not flash 00:00 and the
     place does not snap back to Pollachi before the clock initialises. */
  function prepareClock(event: Event) {
    const incoming = (event as TransitionBeforeSwapEvent).newDocument;
    const digits = getTimeDigits(new Date());
    const copy = viewCopy();
    incoming.querySelectorAll<HTMLElement>(".site-footer .digit-face").forEach((face, index) => {
      if (digits[index] !== undefined) face.textContent = digits[index]!;
    });
    const place = incoming.querySelector<HTMLElement>(".site-footer .clock-place");
    if (place) place.textContent = copy.place;
    const tip = incoming.querySelector<HTMLElement>(".site-footer #local-time [role=\"tooltip\"]");
    if (tip) tip.textContent = copy.tip;
  }

  function clearSnap(context: ClockContext, index: number) {
    const snap = context.snaps[index];
    if (!snap) return;
    context.snaps[index] = undefined;
    snap.animations.forEach((animation) => animation.cancel());
    snap.ghost.remove();
  }

  /* The digit arrives from 50% below at 15% opacity, blurred 2px, and settles
     sharp. The blur radius stays constant: a blurred copy fades out while the
     sharp face fades in, and the slot carries both. Starting an animation
     needs no layout flush, unlike restarting a CSS class. */
  function snapDigit(context: ClockContext, index: number, digit: string) {
    const slot = context.slots[index];
    const face = context.faces[index];
    if (!slot || !face) return;
    const ghost = face.cloneNode(false) as HTMLElement;
    ghost.className = "digit-ghost";
    ghost.setAttribute("aria-hidden", "true");
    ghost.textContent = digit;
    slot.appendChild(ghost);

    const timing = getSnapTiming();
    const ghostFade = ghost.animate(
      [{ opacity: 0.15 }, { opacity: 0.35, offset: 0.5 }, { opacity: 0 }],
      timing,
    );
    context.snaps[index] = {
      ghost,
      animations: [
        slot.animate([{ transform: "translateY(50%)" }, { transform: "translateY(0)" }], timing),
        face.animate([{ opacity: 0 }, { opacity: 0.35, offset: 0.5 }, { opacity: 1 }], timing),
        ghostFade,
      ],
    };
    ghostFade.onfinish = () => {
      if (context.snaps[index]?.ghost === ghost) context.snaps[index] = undefined;
      ghost.remove();
    };
  }

  function updateDigits(context: ClockContext, digits: string[], animate: boolean) {
    const motion = animate && !reduceMotion.matches;
    digits.forEach((d, i) => {
      const face = context.faces[i];
      if (!face || face.textContent === d) return;
      clearSnap(context, i);
      face.textContent = d;
      if (motion) snapDigit(context, i, d);
    });
  }

  function render(context: ClockContext, force = false, animate = true) {
    if (context.signal.aborted || !context.footer.isConnected) return;
    const now = new Date();
    const minute = Math.floor(now.getTime() / MINUTE);
    if (!force && context.lastMinute === minute) return;
    context.lastMinute = minute;
    const presence = tickPresence(now);
    const { dot, tooltip, place, button } = context;
    if (dot) {
      if (dot.style.getPropertyValue("--presence") !== presence.token) dot.style.setProperty("--presence", presence.token);
      if (dot.dataset.presence !== presence.state) dot.dataset.presence = presence.state;
    }

    const digits = getTimeDigits(now);
    const copy = viewCopy();
    if (tooltip && tooltip.textContent !== copy.tip) tooltip.textContent = copy.tip;
    if (place && place.textContent !== copy.place) place.textContent = copy.place;
    const time = `${digits[0]}${digits[1]}:${digits[2]}${digits[3]}`;
    const toggle = sameZone ? "" : showYours ? ". Show Pollachi time." : ". Show your time.";
    const label = showYours ? `Your time · ${time}${toggle}` : `${presence.label} · ${time}${toggle}`;
    if (button.getAttribute("aria-label") !== label) button.setAttribute("aria-label", label);
    if (context.faces.length === DIGITS) updateDigits(context, digits, animate);
  }

  function stopClock(context: ClockContext) {
    if (context.timer !== undefined) {
      clearTimeout(context.timer);
      context.timer = undefined;
    }
  }

  /* One timer per minute, aimed at the next minute boundary, so the digits
     change when the minute does instead of up to a poll interval late. */
  function armClock(context: ClockContext) {
    context.timer = setTimeout(() => {
      context.timer = undefined;
      if (context.signal.aborted || !context.footer.isConnected) return;
      render(context);
      armClock(context);
    }, MINUTE - (Date.now() % MINUTE));
  }

  /* Ticks only while the clock is on screen and the tab is visible. Coming
     back, it shows the current time at once without animating the gap. */
  function syncClock(context: ClockContext) {
    const live = context.inView
      && document.visibilityState === "visible"
      && !context.signal.aborted
      && context.footer.isConnected;
    context.button.toggleAttribute("data-idle", !live);
    if (!live) {
      stopClock(context);
      return;
    }
    if (context.timer !== undefined) return;
    render(context, true, false);
    armClock(context);
  }

  function init() {
    const signal = pageSignal();
    if (clock?.signal === signal) return;
    const footer = document.querySelector<HTMLElement>(".site-footer");
    const btn = footer?.querySelector<HTMLButtonElement>("#local-time");
    if (!footer || !btn || signal.aborted) return;

    const context: ClockContext = {
      signal,
      footer,
      button: btn,
      tooltip: btn.querySelector<HTMLElement>('[role="tooltip"]'),
      place: footer.querySelector<HTMLElement>(".clock-place"),
      dot: footer.querySelector<HTMLElement>(".dot"),
      slots: Array.from(footer.querySelectorAll<HTMLElement>(".digit-slot")),
      faces: Array.from(footer.querySelectorAll<HTMLElement>(".digit-face")),
      snaps: [],
      inView: false,
      lastMinute: -1,
    };
    clock = context;
    btn.dataset.enhanced = "true";
    btn.addEventListener("click", () => {
      if (sameZone) return;
      showYours = !showYours;
      playAccent("tick");
      render(context, true);
    }, { signal });
    // A stopped clock can hold a stale label; refresh it before focus is read.
    btn.addEventListener("focus", () => render(context, true, false), { signal });
    document.addEventListener("visibilitychange", () => syncClock(context), { signal });
    // The margin starts the clock just before it scrolls into view.
    const observer = new IntersectionObserver((entries) => {
      context.inView = entries[entries.length - 1]!.isIntersecting;
      syncClock(context);
    }, { rootMargin: "160px 0px" });
    observer.observe(btn);
    onPageCleanup(() => {
      observer.disconnect();
      stopClock(context);
      if (clock === context) clock = null;
    }, signal);
    // First paint shows the right time even when the clock starts off screen.
    render(context, true, false);
  }

  document.addEventListener("astro:before-swap", prepareClock);
  init();
  document.addEventListener("astro:page-load", init);
</script>
