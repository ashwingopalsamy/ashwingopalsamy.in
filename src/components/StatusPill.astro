---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span class:list={["status-pill", className]}>{label}</span>

<style>
  .status-pill {
    display: inline-flex;
    align-items: center;
    min-block-size: calc(var(--step) * 5);
    padding-inline: var(--step-2);
    border-radius: var(--r-pill);
    background: var(--canvas);
    border: 1px solid var(--chrome-surface-border);
    box-shadow: var(--chrome-surface-shadow);
    color: var(--muted);
    font-size: var(--text-2xs);
    font-weight: var(--font-medium);
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
