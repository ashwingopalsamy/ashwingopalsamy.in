---
/**
 * A badge states a fact and is never pressable (controls.css `.ui-badge`).
 * Labels read lowercase and a known meaning adds its dot, so colour is never
 * the only signal. In a title's text flow the caller puts the last word, a
 * no-break space and this badge in one nowrap span.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;

const lowered = label.trim().toLowerCase();
const text = lowered === "coming soon" ? "soon" : lowered;

const tones: Record<string, string> = {
  reading: "reading",
  watching: "reading",
  soon: "soon",
  live: "live",
  new: "new",
  down: "down",
  unavailable: "down",
};
---

<span class:list={["ui-badge", className]} data-tone={tones[text]}>{text}</span>
