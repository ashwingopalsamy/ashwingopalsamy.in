---
import LibraryRow from "./LibraryRow.astro";
import type { LibraryCatalogItem } from "../lib/library-list";

interface Props {
  items: LibraryCatalogItem[];
  linkedTags: Set<string>;
  /** retired: every empty list says the same thing */
  empty?: string;
  density?: "overview" | "full";
}

const { items, linkedTags, density = "full" } = Astro.props;
---

<ul class:list={["library-rows", "surface-stack", `is-${density}`]}>
  {items.length > 0
    ? items.map((item) => <LibraryRow item={item} linkedTags={linkedTags} density={density} />)
    : <li class="ui-row ui-row--static" aria-live="polite"><span class="ui-row__title">Nothing here yet.</span></li>}
</ul>

<style>
  /* A static row is not a target: pointing at one neither lights it nor
     dims its neighbours. */
  .library-rows:has(> :global(.is-static):hover) > :global(*) {
    opacity: 1;
    filter: none;
  }
</style>
