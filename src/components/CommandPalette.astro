---
/**
 * CommandPalette - ⌘K surface. Markup only; behaviour in palette.ts.
 * Opened via keyboard (⌘K / /) or any [data-palette-entry] / .palette-trigger.
 */
import Icon from "./Icon.astro";
---

<div
  id="command-palette"
  class="palette"
  role="dialog"
  aria-modal="true"
  aria-label="Command Palette"
  aria-hidden="true"
  hidden
>
  <div class="palette-backdrop" aria-hidden="true"></div>
  <div class="palette-panel" tabindex="-1">
    <div class="palette-chrome">
      <button type="button" class="palette-back ui-cap ui-cap--quiet ui-cap--40 ui-cap--icon" aria-label="Back" aria-keyshortcuts="Escape" hidden>
        <Icon name="arrow-left" size={16} class="palette-svg" />
      </button>
      <span id="palette-mobile-title" class="palette-mobile-title" tabindex="-1">Commands</span>
      <div id="palette-query-slot-desktop" class="palette-query-slot">
        <div id="palette-query-shell" class="palette-query-shell">
          <label class="palette-search" for="palette-input">
            <span class="palette-search-icon-box" aria-hidden="true">
              <Icon name="search" size={18} class="palette-search-ico" />
            </span>
            <input
              id="palette-input"
              type="search"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="Search or run a command"
              role="combobox"
              aria-expanded="true"
              aria-controls="palette-list"
              aria-autocomplete="list"
            />
          </label>
        </div>
      </div>
      <div id="palette-context-shell" class="palette-context-shell" hidden>
        <span id="palette-context-title" class="palette-context-title" aria-live="polite"></span>
      </div>
      <button type="button" class="palette-close ui-cap ui-cap--quiet ui-cap--40 ui-cap--icon" aria-label="Close command palette" aria-keyshortcuts="Escape">
        <Icon name="close" size={16} class="palette-svg" />
      </button>
    </div>
    <div class="palette-list-wrap">
      <div id="palette-list" class="palette-list" role="listbox" aria-label="Results" tabindex="-1"></div>
    </div>
    <div id="palette-mobile-dock" class="palette-mobile-dock">
      <div class="palette-mobile-query-stage">
        <div class="palette-mobile-input-area">
          <button id="palette-mobile-search-launch" type="button" class="palette-mobile-search-launch">
            <Icon name="search" size={17} class="palette-search-ico" />
            <span class="palette-mobile-search-prompt">Search site and commands</span>
          </button>
          <div id="palette-query-slot-mobile" class="palette-query-slot palette-query-slot-mobile"></div>
        </div>
        <button id="palette-mobile-close" type="button" class="palette-mobile-close ui-cap ui-cap--quiet ui-cap--40 ui-cap--icon" aria-label="Close command palette">
          <Icon name="close" size={16} class="palette-svg" />
        </button>
      </div>
    </div>
    <div id="palette-footer" class="palette-footer" aria-hidden="true">
      <span id="palette-count" class="palette-count"></span>
      <div id="palette-footer-hints" class="palette-footer-hints"></div>
    </div>
    <div id="palette-status" class="visually-hidden" role="status" aria-live="polite"></div>
  </div>
</div>

<script>
  import { pageSignal } from "../scripts/lifecycle";

  let paletteLoaded = false;
  let paletteLoading: Promise<typeof import("../scripts/palette")> | null = null;
  let paletteOpenIntent = 0;

  function loadPaletteModule() {
    if (!paletteLoading) {
      paletteLoading = import("../scripts/palette").then((m) => {
        paletteLoaded = true;
        return m;
      }).catch((error: unknown) => {
        paletteLoading = null;
        throw error;
      });
    }
    return paletteLoading;
  }

  function open(mode?: "directory" | "search" | "help", instant?: boolean) {
    const signal = pageSignal();
    const intent = ++paletteOpenIntent;
    void loadPaletteModule().then((m) => {
      if (signal.aborted || intent !== paletteOpenIntent) return;
      m.openPalette(mode, instant);
    }).catch(() => undefined);
  }

  // Leaving the page cancels an open that is still waiting for the module.
  document.addEventListener("astro:before-preparation", () => {
    paletteOpenIntent += 1;
  });
  window.addEventListener("pagehide", () => {
    paletteOpenIntent += 1;
  });

  document.addEventListener(
    "pointerover",
    (e) => {
      if (paletteLoaded) return;
      if ((e.target as HTMLElement | null)?.closest(".palette-trigger, .header-palette-trigger, [data-palette-entry]")) {
        void loadPaletteModule().catch(() => undefined);
      }
    },
    { passive: true },
  );

  document.addEventListener(
    "click",
    (event) => {
      if (paletteLoaded) return;
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        ".palette-trigger, .header-palette-trigger, [data-palette-entry]",
      );
      if (!trigger) return;
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      const isMobile = window.matchMedia("(max-width: 38rem)").matches;
      const requestedMode =
        (trigger as HTMLElement).dataset?.paletteEntry === "directory" && isMobile
          ? "directory"
          : "search";
      open(requestedMode);
    },
    { capture: true },
  );

  document.addEventListener("keydown", (e) => {
    if (paletteLoaded) return;
    // A bare modifier press is the likely start of Cmd/Ctrl+K: fetch the chunk now.
    if ((e.key === "Meta" || e.key === "Control") && !e.repeat) {
      void loadPaletteModule().catch(() => undefined);
      return;
    }
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      e.preventDefault();
      open("search", true);
      return;
    }
    const tag = (e.target as HTMLElement | null)?.tagName;
    const isInput =
      tag === "INPUT" ||
      tag === "TEXTAREA" ||
      (e.target as HTMLElement | null)?.isContentEditable;
    if (isInput) return;
    if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      open("search", true);
      return;
    }
    if (e.key === "?" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      open("help", true);
      return;
    }
  });

  import type { PaletteOpenMode } from "../scripts/palette";

  declare global {
    interface Window {
      __openPalette?: (mode?: PaletteOpenMode, instant?: boolean) => void;
    }
  }
  window.__openPalette = open;
</script>

<style is:global>
  .palette {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-overlay) + 5);
    display: grid;
    place-items: start center;
    width: 100vw;
    max-inline-size: 100vw;
    box-sizing: border-box;
    padding: clamp(4.5rem, 11vh, 7.5rem) var(--gutter) 2rem;
    pointer-events: none;
  }
  .palette.is-open {
    pointer-events: auto;
  }
  .palette[hidden] {
    display: none;
  }

  :root[data-palette="open"] body > :not(.site-chrome) {
    pointer-events: none;
  }

  /* The backdrop owns its own blur/tint transition. Fading the whole
     palette via opacity would make it a backdrop root: the blur below
     would sample nothing until opacity reached 1 and then pop in.

     The blur radius no longer animates. Interpolating a backdrop blur
     from 0px to 4px re-runs a full-viewport gaussian at a new kernel
     size on every frame of the open. Holding the radius constant and
     moving the layer's alpha instead is the same gesture: the backdrop
     is rasterised once and then alpha-composited, which the compositor
     does for free. */
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background-color var(--dur-tint) var(--ease-exit);
  }
  .palette-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(4px) saturate(110%);
    backdrop-filter: blur(4px) saturate(110%);
    opacity: 0;
    transition: opacity var(--dur-tint) var(--ease-exit);
  }
  .palette.is-open .palette-backdrop {
    background: color-mix(in oklch, var(--ink) 23%, transparent);
    transition-duration: var(--dur-overlay);
    transition-timing-function: var(--ease-enter);
  }
  .palette.is-open .palette-backdrop::after {
    opacity: 1;
    transition-duration: var(--dur-overlay);
    transition-timing-function: var(--ease-enter);
  }
  .palette.is-instant .palette-backdrop,
  .palette.is-instant .palette-backdrop::after {
    transition: none;
  }

  .palette-panel {
    position: relative;
    width: min(40rem, 100%);
    min-inline-size: 0;
    max-inline-size: 100%;
    max-height: min(38rem, calc(100dvh - 7rem));
    display: flex;
    flex-direction: column;
    border-radius: var(--r-5);
    border: 1px solid var(--edge);
    background: color-mix(in oklch, var(--canvas) 94%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(130%);
    backdrop-filter: blur(24px) saturate(130%);
    box-shadow: var(--shadow-3);
    overflow: hidden;
    opacity: 0;
    transform: translateY(var(--travel-step)) scale(0.985);
    transform-origin: top center;
    filter: blur(2px);
    transition:
      opacity var(--dur-exit) var(--ease-exit),
      transform var(--dur-exit) var(--ease-exit),
      filter var(--dur-exit) var(--ease-exit);
  }
  /* The panel's own blur is kept — it is what makes the palette read as
     resolving rather than appearing — but it now clears in a third of
     the time. It was previously legible-blurred for 250ms, which is
     long enough to register as the interface being slow rather than as
     an effect. Transform and opacity carry the rest of the distance. */
  .palette.is-open .palette-panel {
    opacity: 1;
    transform: none;
    filter: blur(0);
    transition:
      opacity var(--dur-shift) var(--ease-enter),
      transform var(--dur-overlay) var(--ease-spring-snap),
      filter var(--dur-tint) var(--ease-enter);
  }
  .palette.is-instant .palette-panel {
    transition: none;
  }

  .palette-chrome {
    display: flex;
    align-items: center;
    gap: var(--step-2);
    min-height: 60px;
    padding: var(--step-2) var(--step-3);
    border-bottom: 1px solid var(--edge-soft);
  }

  .palette-query-slot {
    display: flex;
    flex: 1;
    min-inline-size: 0;
  }

  .palette-mobile-title {
    display: none;
  }

  .palette-back[hidden],
  .palette-context-shell[hidden] {
    display: none;
  }

  .palette-query-shell,
  .palette-context-shell {
    flex: 1;
    min-inline-size: 0;
  }

  /* A single-line field is a pill like every other control. The input
     drops its own outline; the pill carries the focus ring. */
  .palette-search {
    display: flex;
    align-items: center;
    gap: var(--step-3);
    min-width: 0;
    block-size: var(--cap-40);
    padding-inline: var(--step-3);
    border-radius: var(--r-pill);
  }

  .palette-search:focus-within {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .palette-search-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .palette-search-ico {
    flex-shrink: 0;
    color: var(--faint);
    width: calc(var(--step) * 5);
    height: calc(var(--step) * 5);
  }

  .palette-context-shell {
    display: flex;
    align-items: center;
  }

  .palette-context-title {
    display: block;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: 1.3;
    white-space: normal;
  }

  #palette-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    line-height: 1.3;
    outline: none;
  }
  #palette-input::placeholder {
    color: var(--faint);
  }

  #palette-input::-webkit-search-decoration,
  #palette-input::-webkit-search-cancel-button,
  #palette-input::-webkit-search-results-button,
  #palette-input::-webkit-search-results-decoration {
    appearance: none;
  }

  .palette-list-wrap {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .palette-list-wrap::before,
  .palette-list-wrap::after {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    height: var(--step-3);
    pointer-events: none;
    content: "";
    opacity: 0.7;
  }

  .palette-list-wrap::before {
    top: 0;
    background: linear-gradient(var(--canvas), transparent);
  }

  .palette-list-wrap::after {
    bottom: 0;
    background: linear-gradient(transparent, var(--canvas));
  }

  .palette-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: var(--step-2) var(--step-2) var(--step-3);
    overscroll-behavior: contain;
    scrollbar-color: var(--edge-strong) transparent;
    scrollbar-width: thin;
  }

  .palette-mobile-dock {
    display: none;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .palette-group {
    padding: var(--step-4) var(--step-2) var(--step-2);
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .palette-group:first-child {
    padding-top: var(--step-2);
  }

  /* A result is a .ui-row: it brings the layout, the puddle, the press and
     the ring. The active option is the puddle, whether the pointer or the
     arrow keys put it there. Rows sit inside the list's own padding, so they
     do not bleed past it the way rail rows do. */
  .palette-item {
    gap: var(--step-3);
    margin: 0;
    padding-block: var(--step-2);
  }

  .palette-item[aria-selected="true"]::before {
    opacity: 1;
    transition: opacity var(--t-color);
  }

  /* One puddle at a time: the pointer resting on a row the keys have moved
     off does not keep a second one lit. */
  .palette-item:not([aria-selected="true"]):hover::before {
    opacity: 0;
  }

  .palette-item[aria-selected="true"] .palette-icon {
    background: var(--wash-press);
    color: var(--ink);
  }

  .palette-item[aria-selected="true"] .ui-row__meta {
    color: var(--muted);
  }

  .palette-item[aria-selected="true"] .ui-row__glyph {
    color: var(--ink);
  }

  .palette-item-main {
    display: flex;
    flex-direction: column;
  }

  .palette-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: var(--cap-32);
    block-size: var(--cap-32);
    border-radius: var(--r-3);
    background: var(--wash);
    color: var(--muted);
    transition:
      background-color var(--t-color),
      color var(--t-color);
  }

  .palette-icon svg {
    width: var(--step-4);
    height: var(--step-4);
  }

  .palette-svg {
    display: inline-block;
    width: var(--step-4);
    height: var(--step-4);
    flex: 0 0 auto;
  }

  .palette-brand-icon {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  /* size and weight come from .ui-row__title */
  .palette-label {
    display: flex;
    align-items: center;
    gap: var(--step-2);
    min-width: 0;
  }

  .palette-label-text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .palette-subtitle {
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }

  .palette-value {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .palette-excerpt {
    margin-block-start: calc(var(--step) / 2);
    color: var(--ghost);
    font-size: var(--text-ui-sm);
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .palette-excerpt mark {
    background: var(--wash-press);
    color: var(--ink);
    border-radius: var(--r-pill);
    padding: 0 0.3em;
  }

  .palette-meta {
    flex: 0 0 auto;
    max-inline-size: 8rem;
    overflow-wrap: anywhere;
    text-align: end;
    white-space: normal;
  }

  .palette-keys {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--step-1);
  }

  .palette-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .palette-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--step-3);
    min-height: 2.75rem;
    padding: var(--step-2) var(--step-3);
    border-top: 1px solid var(--edge-soft);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .palette-count {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .palette-footer-hints {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--step-4);
    min-width: 0;
  }

  .palette-footer-hints span {
    display: inline-flex;
    align-items: center;
    gap: var(--step-2);
    white-space: nowrap;
  }

  @media (max-width: 38rem) {
    .palette {
      place-items: end center;
      padding: 0;
      top: var(--palette-visual-top, 0px);
      bottom: auto;
      block-size: var(--palette-visual-height, 100dvh);
    }
    .palette-panel {
      width: 100%;
      max-height: min(92dvh, 42rem);
      block-size: min(92dvh, 42rem);
      border-radius: var(--r-5) var(--r-5) 0 0;
      transform: translateY(100%);
      padding-bottom: 0;
      /* On a phone the sheet covers nearly the whole screen, so its 24px
         backdrop blur re-ran over almost every pixel on each frame of the
         slide and of every list scroll. Through a 94% canvas the blurred,
         dimmed page contributed about 1.4% ink, which is now baked into
         an opaque fill instead: the same pixels without the blur pass. */
      background: color-mix(in oklch, var(--ink) 1.4%, var(--canvas));
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .palette.is-open .palette-panel {
      transform: none;
    }

    .palette-chrome {
      min-height: 56px;
      padding: var(--step-2) var(--mobile-gutter-end) var(--step-2) var(--mobile-gutter-start);
      display: flex;
      align-items: center;
      gap: var(--step-2);
      border-bottom: 1px solid var(--edge-soft);
    }

    .palette-chrome > .palette-close,
    .palette-chrome > .palette-query-slot {
      display: none !important;
    }

    .palette-chrome > .palette-back[hidden] {
      display: none !important;
    }

    .palette-mobile-title {
      display: block;
      min-inline-size: 0;
      max-inline-size: 100%;
      color: var(--ink);
      font-size: var(--text-md);
      font-weight: var(--font-medium);
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .palette-mobile-title[hidden] {
      display: none !important;
    }

    .palette-chrome > .palette-context-shell {
      display: flex;
      align-items: center;
      min-inline-size: 0;
      flex: 1;
    }

    .palette-chrome > .palette-context-shell[hidden] {
      display: none !important;
    }

    .palette-footer {
      display: none;
    }

    .palette-keys {
      display: none !important;
    }

    .palette-list {
      padding-inline: var(--mobile-gutter-start) var(--mobile-gutter-end);
      padding-bottom: var(--step-5);
      scroll-padding-block: var(--step-3);
    }

    .palette-mobile-dock {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: center;
      padding: var(--step-3) var(--mobile-gutter-end) calc(var(--step-3) + env(safe-area-inset-bottom, 0px)) var(--mobile-gutter-start);
      background: linear-gradient(to top, var(--canvas) 85%, color-mix(in oklch, var(--canvas) 85%, transparent) 95%, transparent);
      box-sizing: border-box;
      min-inline-size: 0;
      max-inline-size: 100%;
    }

    .palette-mobile-query-stage {
      position: relative;
      display: flex;
      align-items: center;
      flex: 1;
      min-inline-size: 0;
      max-inline-size: 100%;
      height: var(--cap-48);
      min-height: var(--cap-48);
      padding: 0 calc(var(--track-inset) - 1px) 0 var(--step-3);
      border: 1px solid transparent;
      border-radius: var(--r-pill);
      /* in-flow glass, as the footer dock: opaque fill under a gradient rim */
      background:
        var(--glass-sheen) padding-box,
        linear-gradient(var(--glass-fill), var(--glass-fill)) padding-box,
        var(--glass-rim) border-box;
      box-shadow: var(--glass-spec), var(--lift-0);
      /* No backdrop blur: the stage sits inside the dock's opaque canvas
         band, where blurring flat canvas produced identical pixels. */
      box-sizing: border-box;
      overflow: hidden;
    }

    /* typing: the rim lights, as a glass control does on hover */
    .palette[data-palette-mode="search"] .palette-mobile-query-stage {
      background:
        var(--glass-sheen) padding-box,
        linear-gradient(var(--glass-fill), var(--glass-fill)) padding-box,
        var(--glass-rim-hover) border-box;
    }

    .palette-mobile-input-area {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      flex: 1;
      min-inline-size: 0;
      height: 100%;
      align-items: center;
    }

    .palette-mobile-search-launch {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      display: flex;
      align-items: center;
      gap: var(--step-3);
      inline-size: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      border-radius: var(--r-pill);
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      text-align: start;
      cursor: pointer;
      transition:
        opacity var(--dur-tint) var(--ease-enter),
        transform var(--dur-tint) var(--ease-enter);
    }

    .palette-mobile-search-launch .palette-search-ico {
      flex-shrink: 0;
      color: var(--faint);
