---
/**
 * CommandPalette - ⌘K surface. Markup only; behaviour in palette.ts.
 * Opened via keyboard (⌘K / /); the homepage text hint is server-rendered
 * in index.astro (hidden without JS via the data-theme gate below).
 */
import Icon from "./Icon.astro";
---

<div
  id="command-palette"
  class="palette"
  role="dialog"
  aria-modal="true"
  aria-label="Command Palette"
  aria-hidden="true"
  hidden
>
  <div class="palette-backdrop" aria-hidden="true"></div>
  <div class="palette-panel" tabindex="-1">
    <div class="palette-chrome">
      <button type="button" class="palette-back" aria-label="Back" aria-keyshortcuts="Escape" hidden>
        <Icon name="arrow-left" size={17} class="palette-svg" />
      </button>
      <span id="palette-mobile-title" class="palette-mobile-title" tabindex="-1">Commands</span>
      <div id="palette-query-slot-desktop" class="palette-query-slot">
        <div id="palette-query-shell" class="palette-query-shell">
          <label class="palette-search" for="palette-input">
            <span class="palette-search-icon-box" aria-hidden="true">
              <Icon name="search" size={18} class="palette-search-ico" />
            </span>
            <input
              id="palette-input"
              type="search"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="Search or run a command"
              role="combobox"
              aria-expanded="true"
              aria-controls="palette-list"
              aria-autocomplete="list"
            />
          </label>
        </div>
      </div>
      <div id="palette-context-shell" class="palette-context-shell" hidden>
        <span id="palette-context-title" class="palette-context-title" aria-live="polite"></span>
      </div>
      <button type="button" class="palette-close" aria-label="Close command palette" aria-keyshortcuts="Escape">
        <Icon name="close" size={17} class="palette-svg" />
      </button>
    </div>
    <div class="palette-list-wrap">
      <div id="palette-list" class="palette-list" role="listbox" aria-label="Results" tabindex="-1"></div>
    </div>
    <div id="palette-mobile-dock" class="palette-mobile-dock">
      <div class="palette-mobile-query-stage">
        <div class="palette-mobile-input-area">
          <button id="palette-mobile-search-launch" type="button" class="palette-mobile-search-launch">
            <Icon name="search" size={17} class="palette-search-ico" />
            <span class="palette-mobile-search-prompt">Search site and commands</span>
          </button>
          <div id="palette-query-slot-mobile" class="palette-query-slot palette-query-slot-mobile"></div>
        </div>
        <button id="palette-mobile-close" type="button" class="palette-mobile-close" aria-label="Close command palette">
          <Icon name="close" size={15} class="palette-svg" />
        </button>
      </div>
    </div>
    <div id="palette-footer" class="palette-footer" aria-hidden="true">
      <span id="palette-count" class="palette-count"></span>
      <div id="palette-footer-hints" class="palette-footer-hints"></div>
    </div>
    <div id="palette-status" class="visually-hidden" role="status" aria-live="polite"></div>
  </div>
</div>

<script>
  let paletteLoaded = false;
  let paletteLoading: Promise<typeof import("../scripts/palette")> | null = null;

  function loadPaletteModule() {
    if (!paletteLoading) {
      paletteLoading = import("../scripts/palette").then((m) => {
        paletteLoaded = true;
        return m;
      });
    }
    return paletteLoading;
  }

  function open(mode?: "directory" | "search" | "help", instant?: boolean) {
    loadPaletteModule().then((m) => {
      m.openPalette(mode, instant);
    });
  }

  document.addEventListener(
    "pointerover",
    (e) => {
      if (paletteLoaded) return;
      if ((e.target as HTMLElement | null)?.closest(".palette-trigger, .header-palette-trigger, [data-palette-entry], .palette-home-hint")) {
        loadPaletteModule();
      }
    },
    { passive: true },
  );

  document.addEventListener(
    "click",
    (event) => {
      if (paletteLoaded) return;
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        ".palette-trigger, .header-palette-trigger, [data-palette-entry], .palette-home-hint",
      );
      if (!trigger) return;
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      const isMobile = window.matchMedia("(max-width: 38rem)").matches;
      const requestedMode =
        (trigger as HTMLElement).dataset?.paletteEntry === "directory" && isMobile
          ? "directory"
          : "search";
      open(requestedMode);
    },
    { capture: true },
  );

  document.addEventListener("keydown", (e) => {
    if (paletteLoaded) return;
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      e.preventDefault();
      open("search", true);
      return;
    }
    const tag = (e.target as HTMLElement | null)?.tagName;
    const isInput =
      tag === "INPUT" ||
      tag === "TEXTAREA" ||
      (e.target as HTMLElement | null)?.isContentEditable;
    if (isInput) return;
    if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      open("search", true);
      return;
    }
    if (e.key === "?" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      open("help", true);
      return;
    }
  });

  import type { PaletteOpenMode } from "../scripts/palette";

  declare global {
    interface Window {
      __openPalette?: (mode?: PaletteOpenMode, instant?: boolean) => void;
    }
  }
  window.__openPalette = open;
</script>

<style is:global>
  .palette {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-overlay) + 5);
    display: grid;
    place-items: start center;
    width: 100vw;
    max-inline-size: 100vw;
    box-sizing: border-box;
    padding: clamp(4.5rem, 11vh, 7.5rem) var(--gutter) 2rem;
    pointer-events: none;
  }
  .palette.is-open {
    pointer-events: auto;
  }
  .palette[hidden] {
    display: none;
  }

  :root[data-palette="open"] body > :not(.site-chrome) {
    pointer-events: none;
  }

  /* the backdrop owns its own blur/tint transition. Fading the whole
     palette via opacity would make it a backdrop root: the blur below
     would sample nothing until opacity reached 1 and then pop in. */
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
    -webkit-backdrop-filter: blur(0px) saturate(110%);
    backdrop-filter: blur(0px) saturate(110%);
    transition:
      background-color 150ms var(--ease),
      backdrop-filter 150ms var(--ease),
      -webkit-backdrop-filter 150ms var(--ease);
  }
  .palette.is-open .palette-backdrop {
    background: color-mix(in oklch, var(--ink) 23%, transparent);
    -webkit-backdrop-filter: blur(4px) saturate(110%);
    backdrop-filter: blur(4px) saturate(110%);
    transition-duration: 250ms;
  }
  .palette.is-instant .palette-backdrop {
    transition: none;
  }

  .palette-panel {
    position: relative;
    width: min(40rem, 100%);
    min-inline-size: 0;
    max-inline-size: 100%;
    max-height: min(38rem, calc(100dvh - 7rem));
    display: flex;
    flex-direction: column;
    border-radius: var(--r-5);
    border: 1px solid color-mix(in oklch, var(--ink) 13%, transparent);
    background: color-mix(in oklch, var(--canvas) 94%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(130%);
    backdrop-filter: blur(24px) saturate(130%);
    box-shadow: var(--shadow-3);
    overflow: hidden;
    opacity: 0;
    transform: translateY(8px) scale(0.985);
    transform-origin: top center;
    filter: blur(2px);
    will-change: opacity, transform, filter;
    transition:
      opacity 150ms var(--ease),
      transform 150ms var(--ease),
      filter 150ms var(--ease);
  }
  .palette.is-open .palette-panel {
    opacity: 1;
    transform: none;
    filter: blur(0);
    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease),
      filter 250ms var(--ease);
  }
  .palette.is-instant .palette-panel {
    transition: none;
  }

  .palette-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 60px;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
  }

  .palette-query-slot {
    display: flex;
    flex: 1;
    min-inline-size: 0;
  }

  .palette-mobile-title {
    display: none;
  }

  .palette-back {
    appearance: none;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .palette-back:hover,
  .palette-back:focus-visible {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 7%, transparent);
  }

  .palette-back[hidden],
  .palette-context-shell[hidden] {
    display: none;
  }

  .palette-query-shell,
  .palette-context-shell {
    flex: 1;
    min-inline-size: 0;
  }

  .palette-search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .palette-search-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .palette-search-ico {
    flex-shrink: 0;
    color: var(--faint);
    width: 18px;
    height: 18px;
  }

  .palette-context-shell {
    display: flex;
    align-items: center;
  }

  .palette-context-title {
    display: block;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: 1.3;
    white-space: normal;
  }

  #palette-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    line-height: 1.3;
    outline: none;
  }
  #palette-input::placeholder {
    color: var(--faint);
  }

  #palette-input::-webkit-search-decoration,
  #palette-input::-webkit-search-cancel-button,
  #palette-input::-webkit-search-results-button,
  #palette-input::-webkit-search-results-decoration {
    appearance: none;
  }

  .palette-close {
    appearance: none;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition:
      color var(--t-color),
      border-color var(--t-color),
      transform var(--dur-1) var(--ease);
  }
  .palette-close:hover {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 7%, transparent);
    border-color: color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .palette-close:focus-visible {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 7%, transparent);
  }
  .palette-close:active {
    transform: scale(0.96);
  }

  .palette-list-wrap {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .palette-list-wrap::before,
  .palette-list-wrap::after {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    height: 0.8rem;
    pointer-events: none;
    content: "";
    opacity: 0.7;
  }

  .palette-list-wrap::before {
    top: 0;
    background: linear-gradient(var(--canvas), transparent);
  }

  .palette-list-wrap::after {
    bottom: 0;
    background: linear-gradient(transparent, var(--canvas));
  }

  .palette-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: var(--space-2) var(--space-2) var(--space-3);
    overscroll-behavior: contain;
    scrollbar-color: color-mix(in oklch, var(--ink) 24%, transparent) transparent;
    scrollbar-width: thin;
  }

  .palette-mobile-dock {
    display: none;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .palette-group {
    padding: var(--space-4) var(--space-2) var(--space-2);
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .palette-group:first-child {
    padding-top: var(--space-2);
  }

  .palette-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.25rem;
    min-inline-size: 0;
    margin-block: 2px;
    padding: 0.55rem var(--space-3);
    border-radius: var(--r-4);
    cursor: pointer;
    color: var(--ink);
    border: 1px solid transparent;
    background: transparent;
    transition:
      background-color var(--t-color),
      border-color var(--t-color),
      box-shadow var(--t-color),
      transform var(--t-move);
  }

  .palette-item[aria-selected="true"] {
    background: color-mix(in oklch, var(--ink) 6.5%, var(--canvas));
    border-color: color-mix(in oklch, var(--ink) 12%, transparent);
    box-shadow:
      0 2px 8px color-mix(in oklch, var(--ink) 6%, transparent),
      inset 0 1px 0 color-mix(in oklch, var(--color-1) 22%, transparent);
    transform: translateY(-1px);
  }

  .palette-item[aria-selected="true"] .palette-icon {
    background: color-mix(in oklch, var(--ink) 9%, transparent);
    color: var(--ink);
  }

  .palette-item[aria-selected="true"] .palette-label-text {
    font-weight: var(--font-semibold);
  }

  .palette-item[aria-selected="true"] .palette-subtitle {
    color: color-mix(in oklch, var(--ink) 72%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .palette-item:hover {
      background: color-mix(in oklch, var(--ink) 4%, transparent);
      border-color: color-mix(in oklch, var(--ink) 8%, transparent);
      transform: translateY(-1px);
    }

    .palette-item:hover .palette-icon {
      background: color-mix(in oklch, var(--ink) 6%, transparent);
      color: var(--ink);
    }

    .palette-item[aria-selected="true"]:hover {
      background: color-mix(in oklch, var(--ink) 7.5%, var(--canvas));
      border-color: color-mix(in oklch, var(--ink) 14%, transparent);
      box-shadow:
        0 4px 12px color-mix(in oklch, var(--ink) 8%, transparent),
        inset 0 1px 0 color-mix(in oklch, var(--color-1) 26%, transparent);
    }
  }

  .palette-item:active {
    background: color-mix(in oklch, var(--ink) 12%, transparent);
    transform: translateY(0) scale(0.985);
    transition: background-color var(--t-color), transform var(--dur-1) var(--ease);
  }

  .palette-item-main {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .palette-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-3);
    background: color-mix(in oklch, var(--ink) 3%, transparent);
    color: var(--muted);
    transition:
      background-color var(--t-color),
      color var(--t-color),
      transform var(--t-move);
  }

  .palette-icon svg {
    width: 17px;
    height: 17px;
  }

  .palette-lucide,
  .palette-svg {
    display: inline-block;
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
  }

  .palette-brand-icon {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .palette-icon .palette-brand-icon {
    width: 16px;
    height: 16px;
  }

  .palette-search-ico {
    width: 18px;
    height: 18px;
  }

  .palette-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
    line-height: 1.3;
    transition: color var(--t-color);
  }

  .palette-label-text {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    transition: font-weight var(--t-color);
  }

  .palette-badge {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-height: 1.15rem;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: color-mix(in oklch, var(--ink) 4%, transparent);
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transition:
      background-color var(--t-color),
      border-color var(--t-color),
      color var(--t-color);
  }

  .palette-item[aria-selected="true"] .palette-badge {
    border-color: var(--rule-strong);
    background: color-mix(in oklch, var(--ink) 8%, transparent);
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .palette-item:hover .palette-badge {
      border-color: var(--rule-strong);
      background: color-mix(in oklch, var(--ink) 8%, transparent);
      color: var(--ink);
    }
  }

  .palette-subtitle {
    display: block;
    max-inline-size: 100%;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition: color var(--t-color);
  }

  .palette-value {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .palette-excerpt {
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .palette-excerpt mark {
    background: color-mix(in oklch, var(--color-5) 35%, transparent);
    color: inherit;
    border-radius: var(--r-pill);
    padding: 0 0.3em;
  }

  .palette-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 1.5rem;
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.68rem;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    padding: 0.1rem 0.45rem;
    transition:
      color var(--t-color),
      border-color var(--t-color),
      background-color var(--t-color);
  }

  .palette-item[aria-selected="true"] .palette-kbd {
    color: var(--ink);
    border-color: var(--rule-strong);
    background: color-mix(in oklch, var(--ink) 4%, transparent);
  }

  .palette-meta {
    flex: 0 0 auto;
    max-inline-size: 8rem;
    overflow-wrap: anywhere;
    color: var(--faint);
    font-size: var(--text-xs);
    white-space: normal;
  }

  .palette-external {
    display: inline-grid;
    place-items: center;
  }

  .palette-external svg {
    width: 14px;
    height: 14px;
  }

  .palette-external .palette-lucide,
  .palette-external .palette-svg {
    width: 14px;
    height: 14px;
  }

  .palette-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--faint);
    font-size: var(--text-sm);
  }

  .palette-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .palette-count {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .palette-footer-hints {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    min-width: 0;
  }

  .palette-footer-hints span {
    white-space: nowrap;
  }

  .palette-footer kbd {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.68rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-pill);
    padding: 0.08rem 0.45rem;
    color: var(--muted);
  }

  .palette-home-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--faint);
    text-decoration-color: transparent;
    cursor: pointer;
    transition: color var(--t-color);
  }
  .palette-home-hint:hover,
  .palette-home-hint:focus-visible {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }
  .palette-home-hint kbd {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.78em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-pill);
    padding: 0.12em 0.5em;
    color: var(--muted);
  }

  /* no-JS: the boot script is the only thing that sets data-theme, so this
     hides the server-rendered hint from visitors who can never open it */
  :root:not([data-theme]) .palette-home-hint {
    display: none;
  }

  /* joins the hero line cascade as a 6th slot (after line 5's 250ms).
     Gated on data-motion; static with reduced motion. */
  :root[data-motion="on"]:not([data-intro-animated="true"]) .palette-home-hint {
    opacity: 0;
    transform: translateY(12px);
    animation: palette-hint-in 620ms var(--ease-spring) both;
    animation-delay: 300ms;
  }
  :root[data-intro-animated="true"] .palette-home-hint {
    opacity: 1;
