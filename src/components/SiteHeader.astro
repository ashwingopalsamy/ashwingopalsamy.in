---
import Icon from "./Icon.astro";
import {
  activeNavigationIndex,
  desktopNavigation,
  isNavigationItemActive,
  mobileNavigation,
  resolveBackTarget,
} from "../data/navigation";

const path = Astro.url.pathname;
const desktopActiveIndex = activeNavigationIndex(path, desktopNavigation);
const mobileActiveIndex = activeNavigationIndex(path, mobileNavigation);
const backTarget = resolveBackTarget(path);
---

<header class="site-header">
  <div class="scroll-veil" aria-hidden="true"></div>
  <a
    href={backTarget.href}
    class="wordmark logo-control nav-glass chrome-surface"
    aria-label={backTarget.label}
    data-state={backTarget.isHome ? "home" : "back"}
  >
    <span class="logo-mark" aria-hidden="true">
      <svg
        viewBox="0 0 1080 1080"
        width="28"
        height="28"
        fill="currentColor"
        class="wordmark-logo"
        aria-hidden="true"
      >
        <path d="M376.935 380.038h74.012v287.088h-74.012V633.25q-33.276 41.915-93.518 41.915-57.374 0-98.682-43.638Q144 587.316 144 523.582t40.735-107.37Q226.043 372 283.417 372q60.242 0 93.518 41.915zm-136.548 202.11q22.376 22.393 56.799 22.393 34.425 0 56.8-22.393 22.949-22.966 22.949-58.566t-22.949-57.991q-22.375-22.967-56.8-22.967t-56.799 22.967q-22.376 22.392-22.376 57.991t22.376 58.566m497.412-202.11h72.29v273.308q0 66.605-44.178 101.629Q722.309 790 660.345 790q-46.472 0-82.044-17.799-34.996-17.8-53.931-52.25l63.111-36.174q21.802 40.193 75.159 40.193 34.999 0 55.078-18.374t20.081-52.25v-31.005q-32.702 43.637-91.797 43.637-60.816 0-102.125-42.489-40.734-43.063-40.735-104.5 0-60.862 41.309-103.926T646.002 372q59.095 0 91.797 43.637zm-138.27 195.794q22.951 21.82 57.947 21.819 34.999 0 57.373-21.819 22.95-22.392 22.95-56.843 0-33.877-22.95-55.695-22.375-22.393-57.373-22.393-34.996 0-57.947 22.393-22.375 21.818-22.375 55.695 0 34.45 22.375 56.843m355.128 84.404q-14.345 14.354-34.424 14.355-20.082 0-34.424-14.355-14.344-14.353-14.343-34.45t14.343-34.451 34.424-14.354q20.08 0 34.424 14.354Q969 605.689 969 625.786t-14.343 34.45" />
      </svg>
    </span>
    <span class="logo-back" aria-hidden="true">
      <Icon name="arrow-left" size={16} />
    </span>
  </a>

  {/* The tooltip is the chip's sibling, not its child: the chip's own
      backdrop-filter and transition name make it a backdrop root, which
      would leave the tooltip's blur nothing to sample. */}
  <div class="header-actions">
    <a
      class="header-palette-trigger palette-trigger nav-glass chrome-surface"
      href="/library/"
      aria-label="Search"
      aria-keyshortcuts="Meta+K Control+K"
      data-palette-entry="directory"
    >
      <Icon name="search" size={16} class="trigger-search" />
      <Icon name="command" size={18} class="trigger-command" />
    </a>
    <span class="ui-tip" role="tooltip">Search<span class="ui-kbd"><Icon name="command" size={12} strokeWidth={2.2} /></span><span class="ui-kbd">K</span></span>
  </div>

  <nav class="site-nav nav-glass chrome-surface" aria-label="Pages" data-no-active={desktopActiveIndex < 0 ? "true" : undefined} data-active-index={String(Math.max(0, desktopActiveIndex))}>
    <span class="nav-selection" aria-hidden="true"></span>
    {desktopNavigation.map((item) => {
      const active = isNavigationItemActive(path, item.href);
      return (
        <a
          class:list={["quiet-link", { active }]}
          href={item.href}
          style={`view-transition-name: nav-${item.label}`}
          aria-label={item.ariaLabel || item.label}
          aria-current={active ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
    <span class="nav-ink" aria-hidden="true" inert>
      {desktopNavigation.map((item) => <span class="quiet-link">{item.label}</span>)}
    </span>
  </nav>

  <nav class="site-nav-bottom" aria-label="Pages" data-no-active={mobileActiveIndex < 0 ? "true" : undefined} data-active-index={String(Math.max(0, mobileActiveIndex))}>
    <span class="nav-selection" aria-hidden="true"></span>
    {mobileNavigation.map((item) => {
      const active = isNavigationItemActive(path, item.href);
      return (
        <a
          class:list={["tab", { active }]}
          href={item.href}
          style={`view-transition-name: nav-tab-${item.label}`}
          aria-label={item.ariaLabel || item.label}
          aria-current={active ? "page" : undefined}
        >
          <span class="tab-icon" aria-hidden="true"><Icon name={item.icon} size={15} /></span>
          <span class="tab-label">{item.label}</span>
        </a>
      );
    })}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--step-4);
    min-inline-size: 0;
    max-inline-size: 100%;
    padding-top: calc(var(--step) * 11);
    pointer-events: none;
  }

  /* Each glass surface is lifted out of the root snapshot individually so
     the route blur never touches persistent chrome.
     
     The name must go on the frosted element itself, never on a wrapper
     around it. view-transition-name makes an element a backdrop root, and
     a backdrop root cuts its DESCENDANTS off from the page behind them —
     so naming .site-header left every pill inside it sampling nothing and
     rendering as plain transparency. An element's own backdrop-filter
     resolves against its ancestor backdrop root, so naming the leaf is
     safe. */
  .logo-control {
    view-transition-name: chrome-logo;
  }

  .site-nav {
    view-transition-name: chrome-nav;
  }

  .header-palette-trigger {
    view-transition-name: chrome-action;
  }

  /* Named apart from the nav so the route transition can slide it (motion.css);
     desktop and bottom pills get distinct names because both can render. */
  .site-nav .nav-selection {
    view-transition-name: nav-selection;
  }

  .site-nav-bottom .nav-selection {
    view-transition-name: nav-selection-bottom;
  }

  /* Each label is its own layer too (named inline from the nav data), so
     during a route change it paints above the sliding pill instead of
     being covered by it. */
  .site-nav .quiet-link,
  .site-nav-bottom .tab {
    view-transition-class: nav-label;
  }

  /* The glyphs inside the logo trade places across routes (motion.css); the
     frosted disc around them holds still as chrome-logo. */
  .logo-mark {
    view-transition-name: chrome-logo-mark;
  }

  .logo-back {
    view-transition-name: chrome-logo-back;
  }

  .logo-control,
  .logo-control *,
  .site-nav,
  .site-nav *,
  .header-palette-trigger,
  .header-palette-trigger *,
  .site-nav-bottom,
  .site-nav-bottom * {
    pointer-events: auto;
  }

  .nav-glass {
    border-radius: var(--r-pill);
  }

  .logo-control {
    position: relative;
    display: grid;
    grid-template-areas: "logo-stack";
    width: var(--chrome-size);
    height: var(--chrome-size);
    flex: 0 0 var(--chrome-size);
    place-items: center;
    padding: 0;
    border-radius: 50%;
    text-decoration: none;
    overflow: hidden;
    transition: transform var(--dur-tint) var(--ease-enter), background-color var(--t-color), border-color var(--t-color);
  }

  .logo-mark,
  .logo-back {
    grid-area: logo-stack;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition:
      opacity var(--dur-tint) var(--ease-enter),
      filter var(--dur-tint) var(--ease-enter),
      transform var(--dur-tint) var(--ease-enter),
      visibility var(--dur-tint);
  }

  .logo-mark {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
    pointer-events: auto;
    visibility: visible;
  }

  .logo-back {
    color: var(--muted);
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.75);
    pointer-events: none;
    visibility: hidden;
    transition:
      color var(--t-color),
      opacity var(--dur-tint) var(--ease-enter),
      filter var(--dur-tint) var(--ease-enter),
      transform var(--dur-tint) var(--ease-enter),
      visibility var(--dur-tint);
  }

  .logo-back :global(.ui-icon) {
    display: block;
    transform-origin: center;
    transition: transform var(--dur-tint) var(--ease-enter);
  }

  .logo-control[data-state="back"] .logo-mark {
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.75);
    pointer-events: none;
    visibility: hidden;
  }

  .logo-control[data-state="back"] .logo-back {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
    pointer-events: auto;
    visibility: visible;
  }

  .wordmark-logo {
    display: block;
    width: 28px;
    height: 28px;
    color: var(--ink);
    transition: transform var(--dur-tint) var(--ease-enter), color var(--t-color);
  }

  .site-nav {
    --nav-slot: calc(var(--step) * 18);
    --nav-gap: var(--step-1);
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, var(--nav-slot));
    gap: var(--nav-gap);
    block-size: var(--chrome-size);
    box-sizing: border-box;
    padding: var(--step-1);
    /* 8px from the search chip; the header's own gap is 16 */
    margin-inline-start: calc(var(--step-2) - var(--step-4));
    min-inline-size: 0;
    max-inline-size: 100%;
    font-size: var(--text-ui);
  }

  /* Slot offsets are a variable rather than a transform per index, so the
     pill's position and its travel squash are separate properties and can
     run on separate timelines without fighting each other. */
  .site-nav,
  .site-nav-bottom {
    --pill-x: 0px;
  }

  .site-nav[data-active-index="1"],
  .site-nav-bottom[data-active-index="1"] {
    --pill-x: calc(100% + (var(--nav-gap) * 1));
  }

  .site-nav[data-active-index="2"],
  .site-nav-bottom[data-active-index="2"] {
    --pill-x: calc(200% + (var(--nav-gap) * 2));
  }

  .site-nav-bottom[data-active-index="3"] {
    --pill-x: calc(300% + (var(--nav-gap) * 3));
  }

  .site-nav-bottom[data-active-index="4"] {
    --pill-x: calc(400% + (var(--nav-gap) * 4));
  }

  .nav-selection {
    position: absolute;
    inset-block: var(--step-1);
    inset-inline-start: var(--step-1);
    width: var(--nav-slot);
    border-radius: var(--r-pill);
    background: var(--ink);
    box-shadow: var(--shadow-1);
    pointer-events: none;
    transform: translate3d(var(--pill-x), 0, 0);
    transform-origin: center;
    transition:
      transform var(--dur-shift) var(--ease-spring-snap),
      background-color var(--t-color),
      opacity var(--t-color);
  }

  .site-nav[data-no-active] .nav-selection,
  .site-nav-bottom[data-no-active] .nav-selection {
    opacity: 0;
  }

  /* The header persists across routes, so a CSS transition on the pill (or
     the logo glyphs) would start at the old state while the view-transition
     group captures the new one: the morph then has nothing to travel. During
     a view transition the group does the moving (motion.css). */
  @supports (view-transition-name: none) {
    :root[data-astro-transition] .nav-selection {
      transition: background-color var(--t-color), opacity var(--t-color);
    }

    :root[data-astro-transition] .logo-mark,
    :root[data-astro-transition] .logo-back,
    :root[data-astro-transition] .logo-back :global(.ui-icon) {
      transition: none;
    }
  }

  .site-nav .quiet-link {
    position: relative;
    z-index: 1;
    display: grid;
    block-size: 100%;
    line-height: 1;
    place-items: center;
    padding-inline: var(--step-2);
    border-radius: var(--r-pill);
    text-decoration: none;
    transition:
      color var(--t-color),
      background-color var(--t-color),
      opacity var(--t-color),
      transform var(--dur-press) var(--ease-snap);
  }

  .site-nav .quiet-link.active {
    color: var(--canvas);
  }

  /* Ink-through: the labels again in canvas ink, clipped to the pill's slot
     on the pill's spring, so a label inverts exactly where the ink passes
     under it. The slots are fixed, so the clip is pure CSS from the same
     active index the pill reads. Named so that during a route transition it
     paints above the sliding pill and the cross-fading labels; its new
     snapshot is live, so the clip keeps travelling there. */
  .site-nav {
    --ink-x: 0px;
  }

  .site-nav[data-active-index="1"] {
    --ink-x: calc(var(--nav-slot) + var(--nav-gap));
  }

  .site-nav[data-active-index="2"] {
    --ink-x: calc((var(--nav-slot) + var(--nav-gap)) * 2);
  }

  .nav-ink {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, var(--nav-slot));
    gap: var(--nav-gap);
    padding: var(--step-1);
    pointer-events: none;
    clip-path: inset(
      var(--step-1)
      calc(100% - var(--step-1) - var(--ink-x) - var(--nav-slot))
      var(--step-1)
      calc(var(--step-1) + var(--ink-x))
      round var(--r-pill)
    );
    transition: opacity var(--t-color);
    view-transition-name: nav-ink;
  }

  .nav-ink .quiet-link {
    color: var(--canvas);
  }

  .site-nav[data-no-active] .nav-ink {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-ink {
      transition:
        opacity var(--t-color),
        clip-path var(--dur-shift) var(--ease-spring-snap);
    }
  }

  :global(::view-transition-group(nav-ink)),
  :global(::view-transition-new(nav-ink)) {
    animation: none;
  }

  :global(::view-transition-old(nav-ink)) {
    display: none;
  }

  .header-actions {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--step-2);
    min-inline-size: 0;
    margin-inline-start: auto;
  }

  .header-palette-trigger {
    display: grid;
    width: var(--chrome-size);
    height: var(--chrome-size);
    place-items: center;
    padding: 0;
    color: var(--muted);
    text-decoration: none;
  }

  /* Desktop searches; on phones the same chip opens the command directory. */
  .header-palette-trigger :global(.trigger-command) {
    display: none;
  }

  /* The veil: content dissolves under the chrome instead of sliding
     visibly between the floating chips. One fixed band at a constant
     radius, shown only once the page has scrolled (the script below). */
  .scroll-veil {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: var(--header-zone);
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--canvas) 78%, transparent),
      color-mix(in oklch, var(--canvas) 0%, transparent)
    );
    -webkit-backdrop-filter: blur(calc(var(--step) * 2.5));
    backdrop-filter: blur(calc(var(--step) * 2.5));
    -webkit-mask-image: linear-gradient(180deg, black 62%, transparent);
    mask-image: linear-gradient(180deg, black 62%, transparent);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-shift) var(--ease-enter),
      visibility 0s linear var(--dur-shift);
  }

  :global(:root[data-scrolled]) .scroll-veil {
    visibility: visible;
    opacity: 1;
    transition:
      opacity var(--dur-shift) var(--ease-enter),
      visibility 0s;
  }

  /* in the persisted .site-chrome, which is static: top 0 is the document's */
  :global(.veil-sentinel) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-transparency: reduce) {
    .scroll-veil {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (forced-colors: active) {
    .nav-ink {
      display: none;
    }
  }

  .site-nav-bottom {
    display: none;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .logo-control:active,
  .header-palette-trigger:active,
  .site-nav a:active,
  .site-nav-bottom a:active {
    transform: scale(var(--press-scale));
    transition-duration: var(--dur-press);
    transition-timing-function: var(--ease-snap);
  }

  @media (hover: hover) and (pointer: fine) {
    .logo-control[data-state="home"]:hover .wordmark-logo,
    .logo-control[data-state="home"]:focus-visible .wordmark-logo {
      transform: scale(1.04);
    }

    .logo-control[data-state="back"]:hover .logo-back,
    .logo-control[data-state="back"]:focus-visible .logo-back {
      color: var(--ink);
    }

    .logo-control[data-state="back"]:hover .logo-back :global(.ui-icon),
    .logo-control[data-state="back"]:focus-visible .logo-back :global(.ui-icon) {
      transform: scale(1.28);
    }

    .site-nav .quiet-link:not(.active):hover,
    .site-nav .quiet-link:not(.active):focus-visible {
      color: var(--ink);
      background: color-mix(in oklch, var(--ink) 4.5%, transparent);
    }

    .header-palette-trigger:hover,
    .header-palette-trigger:focus-visible {
      color: var(--ink);
    }
  }

  @media (max-width: 38rem) {
    .site-header {
      padding-top: calc((var(--step) * 5) + env(safe-area-inset-top, 0px));
      pointer-events: auto;
    }

    .site-nav {
      display: none;
    }

    .site-header .chrome-surface {
      background: var(--chrome-surface-bg);
      -webkit-backdrop-filter: blur(20px) saturate(170%);
      backdrop-filter: blur(20px) saturate(170%);
    }

    .header-palette-trigger :global(.trigger-search) {
      display: none;
    }

    .header-palette-trigger :global(.trigger-command) {
      display: block;
    }

    /* no ⌘ on a phone, and the chip opens the directory here */
    .header-actions > :global(.ui-tip) {
      display: none;
    }

    .site-nav-bottom {
      /* 4 gaps of 2px + 2 x 4px padding = 16px, which is what the slot
         width subtracts. Keep the three in step if any of them changes. */
      --nav-gap: calc(var(--step) / 2);
      --nav-slot: calc((100% - var(--step-4)) / 5);
      position: fixed;
      right: var(--mobile-gutter-end);
      bottom: calc((var(--step) * 5) + env(safe-area-inset-bottom, 0px));
      left: var(--mobile-gutter-start);
      z-index: var(--z-sticky);
      display: grid;
      min-inline-size: 0;
      max-inline-size: 100%;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--nav-gap);
      padding: var(--step-1);
      border: var(--hairline) solid var(--chrome-surface-border);
      border-radius: var(--r-pill);
      background: var(--chrome-surface-bg);
      box-shadow: var(--shadow-2), var(--shadow-inset);
      -webkit-backdrop-filter: blur(20px) saturate(170%);
      backdrop-filter: blur(20px) saturate(170%);
      view-transition-name: chrome-bottom;
    }

    .site-nav-bottom .nav-selection {
      inset-block: var(--step-1);
      width: var(--nav-slot);
    }

    .site-nav-bottom .tab {
      position: relative;
      z-index: 1;
      display: grid;
      min-width: 0;
      max-width: 100%;
      min-inline-size: 0;
      min-height: var(--control-hit);
      grid-template-columns: var(--step-4) auto;
      align-items: center;
      justify-content: center;
      gap: calc(var(--step) * 1.5);
      padding-inline: 0;
      border-radius: var(--r-pill);
      color: var(--muted);
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      text-decoration: none;
      transition: color var(--t-color), transform var(--dur-press) var(--ease-snap);
    }

    .site-nav-bottom .tab.active {
      color: var(--canvas);
    }

    /* The icon does not just appear on selection: it springs in from
       slightly small while the label holds position, so the tab reads as
       gaining an icon rather than swapping contents. */
    .tab-icon {
      display: grid;
      width: var(--step-4);
      place-items: center;
      opacity: 0;
      scale: 0.6;
      transition:
        opacity var(--dur-tint) linear,
        scale var(--dur-shift) var(--ease-spring-pop);
    }

    .tab.active .tab-icon {
      opacity: 1;
      scale: 1;
    }

    .tab-label {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-selection {
      transition: opacity var(--t-color), background-color var(--t-color);
    }

    .tab-icon {
      scale: 1;
      transition: opacity var(--t-color);
    }

    .logo-control,
    .logo-mark,
    .logo-back,
    .logo-back :global(.ui-icon),
    .header-palette-trigger,
    .site-nav a,
    .site-nav-bottom a,
    .wordmark-logo {
      transform: none !important;
      transition: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  import "../scripts/tooltip";

  /* The veil is on once the page has scrolled at all. A zero-height
     sentinel at the top of the document tells an IntersectionObserver;
     nothing listens to scroll. It lives in the persisted chrome, so it
     outlives navigations, and so does this module: it runs once per
     document. The flag sits on <html>, which the router rebuilds on every
     swap, so it is re-derived after each one (scroll is already restored
     by then). */
  const FLAG = "data-scrolled";
  const root = document.documentElement;
  const sentinel = document.createElement("div");
  sentinel.className = "veil-sentinel";
  sentinel.setAttribute("aria-hidden", "true");

  const observer = new IntersectionObserver((entries) => {
    const scrolled = !entries[entries.length - 1].isIntersecting;
    if (root.hasAttribute(FLAG) !== scrolled) root.toggleAttribute(FLAG, scrolled);
  });

  function mount() {
    if (sentinel.isConnected) return;
    (document.querySelector(".site-chrome") ?? document.body).prepend(sentinel);
    observer.observe(sentinel);
  }

  mount();
  document.addEventListener("astro:after-swap", () => {
    mount();
    root.toggleAttribute(FLAG, window.scrollY > 0);
  });
</script>
