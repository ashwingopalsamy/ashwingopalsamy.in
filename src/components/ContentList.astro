---
import type { CraftItem, NoteItem, PersonItem } from "../data/home";
import Icon from "./Icon.astro";

/**
 * ContentList - one row pattern for craft, notes, and good people, on the
 * shared .ui-row. Linked rows light a puddle under the pointer and nudge
 * their arrow; the rest of the stack dims. Placeholder rows are static
 * (a div, no glyph, no hover) and carry a "sample" badge.
 */

interface Props {
  id: string;
  /** omit when the page layout already carries the label */
  label?: string;
  items: (CraftItem | NoteItem | PersonItem)[];
  variant: "craft" | "notes" | "people";
}

const { id, label, items, variant } = Astro.props;

function isNote(item: Props["items"][number]): item is NoteItem {
  return "title" in item;
}

function formatDate(iso: string): string {
  return new Date(`${iso}T00:00:00`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}
---

{
  items.length > 0 && (
    <section id={id} aria-labelledby={label ? `${id}-label` : undefined} data-enter>
      {label && (
        <h2 id={`${id}-label`} class="content-list-heading">
          {label}
        </h2>
      )}
      <ul class="rows surface-stack" data-variant={variant} role="list">
        {items.map((item) => {
          const title = isNote(item)
            ? item.title
            : (item as CraftItem | PersonItem).name;
          const detail = isNote(item)
            ? formatDate(item.date)
            : (item as CraftItem | PersonItem).sentence;
          const lede = isNote(item) ? item.sentence : undefined;
          const sub = variant === "craft" ? detail : variant === "notes" ? lede : undefined;
          const external = Boolean(item.href) && /^https?:\/\//.test(item.href!);

          const inner = (
            <>
              <span class="row-main">
                <span class="ui-row__title">
                  {title}
                  {item.placeholder && <>&nbsp;<span class="ui-badge">sample</span></>}
                </span>
                {sub && <span class="ui-row__sub">{sub}</span>}
              </span>
              {isNote(item) && (
                <time class="ui-row__meta" datetime={item.date}>{detail}</time>
              )}
              <span class:list={["ui-row__glyph", { "ui-row__glyph--ext": external }]} aria-hidden="true">
                {item.href && <Icon name={external ? "arrow-up-right" : "arrow-right"} size={16} />}
              </span>
            </>
          );

          return (
            <li>
              {item.href ? (
                <a class:list={["ui-row", { "ui-row--multiline": Boolean(sub) }]} data-fx="spot" href={item.href}>
                  {inner}
                </a>
              ) : (
                <div class:list={["ui-row", "ui-row--static", { "ui-row--multiline": Boolean(sub) }]}>
                  {inner}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  section {
    margin-top: 0;
  }

  .content-list-heading {
    margin: 0 0 1.25rem;
    font-size: var(--type-section-size);
    font-weight: 580;
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: var(--leading-tight);
  }

  .row-main {
    flex: 1;
    min-inline-size: 0;
  }

  /* work: the name and its sentence side by side, one column on phones */
  .rows[data-variant="craft"] .row-main {
    display: grid;
    grid-template-columns: minmax(calc(var(--step) * 50), 0.75fr) minmax(0, 1.25fr);
    align-items: baseline;
    gap: var(--step-4);
  }

  .rows[data-variant="craft"] .ui-row__sub {
    margin-block-start: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 38rem) {
    .rows[data-variant="craft"] .row-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .rows[data-variant="craft"] .ui-row__sub {
      margin-block-start: calc(var(--step) / 2);
    }
  }
</style>
