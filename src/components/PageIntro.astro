---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}

const { title, lede, eyebrow } = Astro.props;
---

<header class="page-intro" data-enter>
  {eyebrow && <p class="page-intro-eyebrow">{eyebrow}</p>}
  <h1><slot name="mark" />{title}</h1>
  <slot />
  {lede && <p class="page-intro-lede">{lede}</p>}
</header>

<style>
  /* The one head: every titled page, detail pages and tags included. */
  .page-intro {
    display: grid;
    gap: calc(var(--step) * 5);
    max-inline-size: 100%;
    margin: 0 0 var(--step-6);
  }

  .page-intro-eyebrow,
  .page-intro-lede,
  .page-intro h1 {
    margin: 0;
  }

  .page-intro-eyebrow {
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* one measure for a page name and a long post title alike */
  .page-intro h1 {
    max-inline-size: 26ch;
    color: var(--ink);
    font-size: var(--type-page-title-size);
    font-weight: var(--type-page-title-weight);
    letter-spacing: var(--type-page-title-tracking);
    line-height: var(--type-page-title-leading);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .page-intro-lede {
    max-inline-size: 64ch;
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 38rem) {
    .page-intro {
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .page-intro h1 {
      max-inline-size: 100%;
    }
  }
</style>
