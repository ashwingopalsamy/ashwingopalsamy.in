---
interface Props {
  id?: string;
  title: string;
  count?: number | string;
  accent?: string;
}

const { id, title, count, accent } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<header class="section-heading" style={accent ? `--section-accent: ${accent}` : undefined}>
  <div class="section-heading-copy">
    {accent && <span class="section-heading-marker" aria-hidden="true"></span>}
    <h2 id={id}>{title}</h2>
    {count !== undefined && <span class="section-heading-count">{count}</span>}
  </div>
  {hasAction && <div class="section-heading-action"><slot name="action" /></div>}
</header>

<style>
  .section-heading {
    display: flex;
    min-inline-size: 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: 0.85rem;
  }

  .section-heading-copy {
    display: inline-flex;
    min-inline-size: 0;
    align-items: center;
    gap: 0.6rem;
  }

  .section-heading h2,
  .section-heading-count {
    margin: 0;
  }

  .section-heading h2 {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 580;
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  .section-heading-marker {
    inline-size: 6px;
    block-size: 6px;
    flex: 0 0 6px;
    background: var(--section-accent);
    transform: rotate(45deg);
    border-radius: 0.75px;
  }

  .section-heading-count {
    color: var(--ghost);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .section-heading-action {
    flex: 0 0 auto;
    min-inline-size: 0;
  }
</style>
