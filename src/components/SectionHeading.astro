---
interface Props {
  id?: string;
  title: string;
  accent?: string;
}

const { id, title, accent } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<header class="section-heading" style={accent ? `--section-accent: ${accent}` : undefined}>
  <div class="section-heading-copy">
    {accent && <span class="section-heading-marker" aria-hidden="true"></span>}
    <h2 id={id}>{title}</h2>
  </div>
  {hasAction && <div class="section-heading-action"><slot name="action" /></div>}
</header>

<style>
  .section-heading {
    display: flex;
    min-inline-size: 0;
    /* one height with or without an action, so the first row sits at the
       same offset under every heading */
    min-block-size: var(--cap-32);
    align-items: center;
    justify-content: space-between;
    gap: var(--step-3);
    margin-bottom: var(--step-1);
  }

  .section-heading-copy {
    display: inline-flex;
    min-inline-size: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: var(--type-section-size);
    font-weight: 580;
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  .section-heading-marker {
    inline-size: var(--dot-6);
    block-size: var(--dot-6);
    flex: 0 0 var(--dot-6);
    background: var(--section-accent);
    transform: rotate(45deg);
    border-radius: var(--r-diamond);
  }

  .section-heading-action {
    flex: 0 0 auto;
    min-inline-size: 0;
  }
</style>
