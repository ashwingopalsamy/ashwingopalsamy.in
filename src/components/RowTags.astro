---
/**
 * Tag chips (controls.css `.ui-chip`). A tag with a page links to it; one
 * without is the same chip as a label, with no pointer behaviour. `active`
 * is the tag currently filtering: selected, with a close icon, and pressing
 * it clears the filter.
 */
import Icon from "./Icon.astro";
import { isLinkedTag, tagHref } from "../lib/tags";

interface Props {
  tags: string[];
  linked: Set<string>;
  label?: string;
  active?: string;
  clearHref?: string;
}

const { tags, linked, label = "Tags", active, clearHref = "/library/tags/" } = Astro.props;
---

{tags.length > 0 && (
  <span class="row-tags" role="group" aria-label={label}>
    {tags.map((tag) => (
      tag === active ? (
        <a class="ui-chip ui-cap--lead ui-cap--trail" href={clearHref} aria-pressed="true" aria-label={`Remove filter: ${tag}`}>
          <Icon name="hash" size={12} strokeWidth={2.2} class="ui-chip__hash" />
          <span class="ui-cap__label">{tag}</span>
          <Icon name="close" size={12} strokeWidth={2.2} />
        </a>
      ) : isLinkedTag(tag, linked) ? (
        <a class="ui-chip ui-cap--lead" href={tagHref(tag)}>
          <Icon name="hash" size={12} strokeWidth={2.2} class="ui-chip__hash" />
          <span class="ui-cap__label">{tag}</span>
        </a>
      ) : (
        <span class="ui-chip ui-cap--lead row-tag-label">
          <Icon name="hash" size={12} strokeWidth={2.2} class="ui-chip__hash" />
          <span class="ui-cap__label">{tag}</span>
        </span>
      )
    ))}
  </span>
)}

<style>
  .row-tag-label {
    pointer-events: none;
  }

  .row-tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2);
    max-inline-size: 100%;
    min-inline-size: 0;
  }
</style>
