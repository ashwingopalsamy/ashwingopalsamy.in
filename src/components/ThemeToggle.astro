---
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  aria-pressed="false"
>
  <svg
    class="tt-icon"
    width="18"
    height="18"
    viewBox="0 0 32 32"
    aria-hidden="true"
    fill="currentColor"
    style="--toggles-expand--duration:250ms;overflow:visible"
  >
    <defs>
      <clipPath id="tt-clip">
        <path class="tt-clip-path" d="M0-11h25a1 1 0 0017 13v30H0Z" />
      </clipPath>
    </defs>
    <g clip-path="url(#tt-clip)">
      <circle class="tt-circle" cx="16" cy="16" r="8.4" />
      <path
        class="tt-rays"
        d="M18.3 3.2c0 1.3-1 2.3-2.3 2.3s-2.3-1-2.3-2.3S14.7.9 16 .9s2.3 1 2.3 2.3zm-4.6 25.6c0-1.3 1-2.3 2.3-2.3s2.3 1 2.3 2.3-1 2.3-2.3 2.3-2.3-1-2.3-2.3zm15.1-10.5c-1.3 0-2.3-1-2.3-2.3s1-2.3 2.3-2.3 2.3 1 2.3 2.3-1 2.3-2.3 2.3zM3.2 13.7c1.3 0 2.3 1 2.3 2.3s-1 2.3-2.3 2.3S.9 17.3.9 16s1-2.3 2.3-2.3zm5.8-7C9 7.9 7.9 9 6.7 9S4.4 8 4.4 6.7s1-2.3 2.3-2.3S9 5.4 9 6.7zm16.3 21c-1.3 0-2.3-1-2.3-2.3s1-2.3 2.3-2.3 2.3 1 2.3 2.3-1 2.3-2.3 2.3zm2.4-21c0 1.3-1 2.3-2.3 2.3S23 7.9 23 6.7s1-2.3 2.3-2.3 2.4 1 2.4 2.3zM6.7 23C8 23 9 24 9 25.3s-1 2.3-2.3 2.3-2.3-1-2.3-2.3 1-2.3 2.3-2.3z"
      />
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    border-radius: 50%;
    user-select: none;
    transition:
      color var(--t-color),
      background-color var(--t-color),
      transform var(--t-move);
  }

  .theme-toggle::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--ink);
    background: color-mix(in oklch, var(--ink) 6%, transparent);
  }

  .theme-toggle:active {
    transform: scale(0.94);
    transition: transform 90ms var(--ease);
  }

  :global(.tt-icon) {
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover :global(.tt-icon) {
      transform: scale(1.1);
    }
  }

  .theme-toggle:active :global(.tt-icon) {
    transform: scale(0.92);
  }

  :global(.tt-clip-path) {
    transition-property: d, translate;
    transition-duration: calc(var(--toggles-expand--duration) * 0.6);
    transition-timing-function: cubic-bezier(0, 0, 0.5, 1);
    transition-delay: 0s;
  }

  :global([data-theme="dark"] .tt-clip-path) {
    d: path("M-9 3h25a1 1 0 0017 13v30H0Z");
    transition-timing-function: cubic-bezier(0, 0, 0, 1.25);
    transition-delay: calc(var(--toggles-expand--duration) * 0.4);
  }

  @supports not (d: path("M0 0")) {
    :global([data-theme="dark"] .tt-clip-path) {
      translate: -9px 14px;
    }
  }

  :global(.tt-circle) {
    transform-origin: center;
    transition: transform calc(var(--toggles-expand--duration) * 0.65) cubic-bezier(0, 0, 0, 1.25) calc(var(--toggles-expand--duration) * 0.35);
  }

  :global([data-theme="dark"] .tt-circle) {
    transform: scale(1.4);
    transition: transform calc(var(--toggles-expand--duration) * 0.65) cubic-bezier(0, 0, 0, 1.25);
  }

  :global(.tt-rays) {
    transform-origin: center;
    transition: transform calc(var(--toggles-expand--duration) * 0.65) cubic-bezier(0, 0, 0, 1.25) calc(var(--toggles-expand--duration) * 0.35);
  }

  :global([data-theme="dark"] .tt-rays) {
    transform: scale(0.75);
    transition: transform calc(var(--toggles-expand--duration) * 0.65) cubic-bezier(0, 0, 0, 1.25);
  }
</style>

<style is:global>
  .theme-veil {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
  }
</style>

<script>
  import { playAccent } from "../scripts/sound";

  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  type Theme = "light" | "dark";

  function storedTheme(): Theme | null {
    try {
      const v = localStorage.getItem("theme");
      return v === "light" || v === "dark" ? v : null;
    } catch {
      return null;
    }
  }

  function currentTheme(): Theme {
    return root.dataset.theme === "dark" ? "dark" : "light";
  }

  function apply(theme: Theme, persist: boolean) {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem("theme", theme);
      } catch {
        /* private mode */
      }
    }
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(theme === "dark"));
    });
    const tc = document.querySelector('meta[name="theme-color"]:not([media])');
    const canvasHex = getComputedStyle(root).getPropertyValue("--canvas-hex").trim();
    if (tc && canvasHex) tc.setAttribute("content", canvasHex);
  }

  let veil: HTMLDivElement | null = null;
  let veilTimer: number | undefined;
  let currentAnim: Animation | null = null;

  function runVeil(oldHex: string) {
    const el = document.body;
    if (typeof el.animate !== "function") return;

    if (!veil) {
      veil = document.createElement("div");
      veil.className = "theme-veil";
      veil.setAttribute("aria-hidden", "true");
    }

    const cs = getComputedStyle(root);
    const easing = cs.getPropertyValue("--ease").trim() || "ease";
    const duration = parseInt(cs.getPropertyValue("--dur-3"), 10) || 200;

    currentAnim?.cancel();
    veil.remove();
    veil.style.background = oldHex;
    document.body.appendChild(veil);

    currentAnim = veil.animate(
      [{ opacity: 1 }, { opacity: 0 }],
      { duration, easing, fill: "forwards" },
    );
    const mine = currentAnim;

    window.clearTimeout(veilTimer);
    veilTimer = window.setTimeout(() => veil?.remove(), duration + 200);
    mine.finished
      .then(() => {
        if (currentAnim === mine) veil?.remove();
      })
      .catch(() => {
        /* canceled by a newer flip */
      });
  }

  function setThemeFromClick(next: Theme) {
    const oldHex = getComputedStyle(root).getPropertyValue("--canvas-hex").trim();
    if (!oldHex) return;
    apply(next, true);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canVeil = !reduce && root.dataset.motion === "on";
    if (!canVeil) return;

    runVeil(oldHex);
  }

  function init() {
    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
      if (btn.dataset.enhanced) return;
      btn.dataset.enhanced = "true";
      btn.addEventListener("click", () => {
        setThemeFromClick(currentTheme() === "dark" ? "light" : "dark");
        playAccent("theme");
      });
    });
    apply(currentTheme(), false);
  }

  init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => veil?.remove());

  media.addEventListener("change", (e) => {
    if (!storedTheme()) apply(e.matches ? "dark" : "light", false);
  });

  window.addEventListener("storage", (e) => {
    if (e.key === "theme") {
      apply(e.newValue === "dark" ? "dark" : "light", false);
    }
  });
</script>
