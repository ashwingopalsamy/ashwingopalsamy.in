---
import Connect from "./Connect.astro";
import Icon from "./Icon.astro";
import SocialProfilePreviews from "./SocialProfilePreviews.astro";
import { resumeUrl, site, socials } from "../data/home";
import { getGithubContributions } from "../lib/github-contributions";

const quickLinks = socials.filter(
  (social) => social.id === "github" || social.id === "linkedin" || social.id === "x",
);
const contributions = await getGithubContributions();
---

<div class="refined-home">
  <section class="refined-intro" aria-label="Introduction">
    <h1 class="visually-hidden">{site.name} · Staff Software Engineer, Payments Infrastructure</h1>
    <p class="refined-lede">
      Hey! I'm <a class="ui-link" href="/more/" aria-label="More about Ashwin">Ashwin</a>. I build the infrastructure behind global payments.
    </p>
    <p class="refined-context">
      I work remotely as a Staff Software Engineer at <a class="ui-link" href="https://developers.pismo.io/pismo-docs" target="_blank" rel="noopener noreferrer">Pismo, a Visa company<Icon name="arrow-up-right" /></a>, and study AI at <a class="ui-link" href="https://cdso.utexas.edu/msai" target="_blank" rel="noopener noreferrer">UT Austin<Icon name="arrow-up-right" /></a> alongside work.
    </p>
    <p class="refined-context">
      Off the clock, I'm happiest around good machinery and cars, or lost in anthropology, history, and long-form craft. Here’s my <a class="ui-link" href="/library/">library</a>, <a class="ui-link" href="/more/photos/">photos I take</a>, and <a class="ui-link" href="/more/cafe/">cafes I try</a>.
    </p>
  </section>

  <section class="refined-contact" aria-label="Contact and profiles">
    <h2 class="visually-hidden">Contact and profiles</h2>
    <div class="refined-contact__row">
      <div class="refined-cta-row">
        <a class="ui-cap ui-cap--ink ui-cap--48" data-fx="magnet" href={site.cal} target="_blank" rel="noopener noreferrer"><span class="ui-cap__label">Let's talk</span></a>
        {resumeUrl && <a class="ui-cap ui-cap--glass ui-cap--48" data-fx="spot" href={resumeUrl} download="AshwinGopalsamy_Resume.pdf" data-astro-prefetch="false"><span class="ui-cap__label">Resume</span></a>}
      </div>
      <span class="refined-row-sep" aria-hidden="true"></span>
      <div class="refined-socials">
        <SocialProfilePreviews links={quickLinks} contributions={contributions} />
      </div>
    </div>
  </section>

  <hr class="page-rule" />

  <Connect />
</div>

<style>
  .refined-intro {
    margin-top: 0;
    font-size: var(--text-md);
  }

  .refined-lede {
    max-width: var(--measure-hero);
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .refined-context {
    max-width: var(--measure-hero);
    margin: 1.5em 0 0;
    color: var(--ghost);
    line-height: var(--leading-relaxed);
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: pretty;
  }

  .refined-home > .page-rule {
    margin-block: var(--space-rule);
  }

  .refined-home :global(.connect-grid) {
    grid-template-columns: 1fr;
    grid-template-rows: 152px 200px;
    gap: var(--step-4);
  }

  .refined-home :global(.quote-block) {
    margin-top: var(--step-5);
  }

  .refined-contact {
    margin-top: var(--step-6);
  }

  .refined-contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-3);
  }

  .refined-cta-row,
  .refined-socials {
    display: inline-flex;
    align-items: center;
    gap: var(--step-2);
  }

  .refined-row-sep {
    width: 1px;
    height: var(--step-4);
    flex-shrink: 0;
    background: var(--rule-strong);
  }

  @media (min-width: 42.5rem) {
    .refined-home :global(.connect-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 152px;
    }

    .refined-home :global(.connect-grid .loc-card) {
      min-height: 0;
      height: 152px;
    }
  }

  @media (max-width: 38rem) {
    .refined-contact__row {
      align-items: stretch;
      flex-direction: column;
      gap: var(--step-4);
    }

    .refined-cta-row {
      width: 100%;
      max-width: 21rem;
    }

    .refined-cta-row > .ui-cap {
      flex: 1 1 0;
    }

    .refined-row-sep {
      display: none;
    }

    .refined-home :global(.connect-grid) {
      grid-template-columns: 1fr;
      grid-template-rows: 152px 200px;
      gap: var(--step-5);
    }

    .refined-home :global(.connect-grid .loc-card) {
      min-height: 200px;
      height: 200px;
    }
  }
</style>
