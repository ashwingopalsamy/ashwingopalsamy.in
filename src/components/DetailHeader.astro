---
import PageIntro from "./PageIntro.astro";

interface Props {
  title: string;
  lede?: string;
}

/* A detail page's head is the page head; its meta and actions are the
   control row under it. The header chip is the way back. */
const { title, lede } = Astro.props;
const hasMeta = Astro.slots.has("meta");
const hasAction = Astro.slots.has("action");
---

<PageIntro title={title} lede={lede} />
{(hasMeta || hasAction) && (
  <div class="page-bar detail-meta-bar" data-enter>
    {hasMeta && <div class="page-bar__start detail-meta-left"><slot name="meta" /></div>}
    {hasAction && <div class="page-bar__end detail-meta-actions"><slot name="action" /></div>}
  </div>
)}

<style>
  .detail-meta-left {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2) var(--step-3);
    font-size: var(--text-ui-sm);
    color: var(--ghost);
    min-inline-size: 0;
  }

  .detail-meta-bar :global(.detail-sep),
  .detail-meta-left :global(.detail-sep) {
    color: var(--faint);
    font-weight: var(--font-bold);
    user-select: none;
    line-height: 1;
  }

  .detail-meta-left :global(.detail-date),
  .detail-meta-left :global(time) {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: var(--text-ui-sm);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .detail-meta-left :global(.detail-tag-list) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-meta-left :global(.detail-tag-list li) {
    display: inline-flex;
    margin: 0;
    padding: 0;
  }

  .detail-meta-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--step-2);
    flex-shrink: 0;
  }

  @media (max-width: 38rem) {
    .detail-meta-left {
      gap: var(--step-1) var(--step-2);
    }
  }
</style>
