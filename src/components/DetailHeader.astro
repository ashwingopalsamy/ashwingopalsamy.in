---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
const hasMeta = Astro.slots.has("meta");
const hasAction = Astro.slots.has("action");
---

<header class="detail-header" data-enter>
  <h1 class="detail-title">{title}</h1>
  {lede && <p class="detail-lede">{lede}</p>}
  {(hasMeta || hasAction) && (
    <div class="detail-meta-bar">
      {hasMeta && <div class="detail-meta-left"><slot name="meta" /></div>}
      {hasMeta && hasAction && <span class="detail-sep" aria-hidden="true">·</span>}
      {hasAction && <div class="detail-meta-actions"><slot name="action" /></div>}
    </div>
  )}
</header>

<style>
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: calc(var(--step) * 5);
    max-inline-size: 100%;
    padding-bottom: 1.5rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--rule);
    transition: border-color var(--t-color);
  }

  .detail-title,
  .detail-lede {
    margin: 0;
  }

  .detail-title {
    max-inline-size: 26ch;
    color: var(--ink);
    font-size: var(--type-detail-title-size);
    font-weight: var(--type-detail-title-weight);
    letter-spacing: var(--type-detail-title-tracking);
    line-height: var(--type-detail-title-leading);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .detail-lede {
    max-inline-size: 64ch;
    color: var(--muted);
    font-size: clamp(1rem, 0.98rem + 0.15vw, 1.08rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .detail-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--step-2) var(--step-3);
    padding-top: 0.25rem;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .detail-meta-left {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2) var(--step-3);
    font-size: var(--text-sm);
    color: var(--ghost);
    min-inline-size: 0;
  }

  .detail-meta-bar :global(.detail-sep),
  .detail-meta-left :global(.detail-sep) {
    color: var(--faint);
    font-weight: var(--font-bold);
    user-select: none;
    line-height: 1;
  }

  .detail-meta-left :global(.detail-date),
  .detail-meta-left :global(time) {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: var(--text-sm);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .detail-meta-left :global(.detail-tag-list) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-1) var(--step-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-meta-left :global(.detail-tag-list li) {
    display: inline-flex;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
  }

  .detail-meta-left :global(.detail-tag),
  .detail-meta-left :global(.note-tag) {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ghost);
    background: var(--canvas);
    border: 1px solid var(--chrome-surface-border);
    box-shadow: var(--chrome-surface-shadow);
    padding: 0.12rem var(--step-2);
    border-radius: var(--r-pill);
    text-decoration: none;
    line-height: 1.25;
    transition:
      color var(--t-color),
      background-color var(--t-color),
      border-color var(--t-color),
      box-shadow var(--t-color);
  }

  .detail-meta-left :global(a.detail-tag:hover),
  .detail-meta-left :global(a.note-tag:hover) {
    color: var(--ink);
    border-color: color-mix(in oklch, var(--ink) 18%, transparent);
    background: color-mix(in oklch, var(--ink) 3%, var(--canvas));
  }

  .detail-meta-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--step-1);
    flex-shrink: 0;
  }

  .detail-meta-actions :global(a),
  .detail-meta-actions :global(button) {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    margin: 0;
    border-radius: 50%;
    background: color-mix(in oklch, var(--ink) 3%, transparent);
    border: 1px solid var(--chrome-surface-border);
    color: var(--muted);
    cursor: pointer;
    text-decoration: none;
    line-height: 1;
    transition:
      background-color var(--t-color),
      border-color var(--t-color),
      box-shadow var(--t-color),
      color var(--t-color),
      transform var(--dur-press) var(--ease-snap);
  }

  /* 28px to look at, 44px to hit */
  .detail-meta-actions :global(a)::before,
  .detail-meta-actions :global(button)::before {
    content: "";
    position: absolute;
    inset: calc((var(--control-hit) - 28px) / -2);
    border-radius: 50%;
  }

  .detail-meta-actions :global(a:hover),
  .detail-meta-actions :global(a:focus-visible),
  .detail-meta-actions :global(button:hover),
  .detail-meta-actions :global(button:focus-visible) {
    background: color-mix(in oklch, var(--ink) 7%, transparent);
    color: var(--ink);
    border-color: color-mix(in oklch, var(--ink) 18%, transparent);
  }

  .detail-meta-actions :global(.ui-icon) {
    display: block;
    transition: transform var(--dur-press) var(--ease-enter);
  }

  .detail-meta-actions :global(a:hover .ui-icon),
  .detail-meta-actions :global(a:focus-visible .ui-icon) {
    transform: scale(1.08);
  }

  .detail-meta-actions :global(a:active),
  .detail-meta-actions :global(button:active) {
    background: color-mix(in oklch, var(--ink) 9%, transparent);
    transform: scale(0.92);
  }

  @media (max-width: 38rem) {
    .detail-header {
      gap: var(--step-3);
      padding-bottom: calc(var(--step) * 5);
      margin-bottom: 1.5rem;
    }

    .detail-meta-bar {
      gap: 0.5rem;
    }

    .detail-meta-left {
      gap: var(--step-1) var(--step-2);
      font-size: var(--text-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-meta-actions :global(a),
    .detail-meta-actions :global(button),
    .detail-meta-actions :global(.ui-icon) {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
