---
import Icon from "./Icon.astro";
import StatusPill from "./StatusPill.astro";
import type { LibraryCatalogItem } from "../lib/library-list";

interface Props {
  item: LibraryCatalogItem;
  linkedTags?: Set<string>;
  density?: "overview" | "full";
}

const { item, density = "full" } = Astro.props;
const date = item.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const dateTime = item.date.toISOString().slice(0, 10);
const isLinked = Boolean(item.href);
const isExternal = item.kind === "articles";
const status = item.kind === "books"
  ? item.status === "reading" ? "reading" : item.status === "dropped" ? "dropped" : null
  : item.kind === "watch"
    ? item.status === "watching" ? "watching" : item.status === "dropped" ? "dropped" : null
    : null;
const trailingMeta = item.kind === "notes"
  ? date
  : item.kind === "books"
    ? item.author
    : item.kind === "watch"
      ? item.platform
      : item.kind === "articles"
        ? item.hostname || item.source
        : date;
const label = isExternal ? `Open ${item.title}, external site` : `Open ${item.title}`;

// The badge rides in the title's text flow, glued to the last word by a
// non-breaking space, so it wraps with that word and never alone.
const cut = item.title.lastIndexOf(" ");
const head = cut > 0 ? item.title.slice(0, cut + 1) : "";
const tail = cut > 0 ? item.title.slice(cut + 1) : item.title;
---

<li class:list={["library-row", `is-${item.kind}`, { "is-linked": isLinked, "is-overview": density === "overview" }]}>
  {isLinked ? (
    <a
      class="ui-row"
      data-fx="spot"
      href={item.href!}
      aria-label={label}
      {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      <span class="ui-row__title">
        {status ? <>{head}<span class="library-row-tail">{tail}&nbsp;<StatusPill label={status} /></span></> : item.title}
      </span>
      {item.kind === "notes" ? (
        <time class="ui-row__meta library-row-meta" datetime={dateTime}>{trailingMeta}</time>
      ) : (
        <span class="ui-row__meta library-row-meta">{trailingMeta}</span>
      )}
      <span class:list={["ui-row__glyph", { "ui-row__glyph--ext": isExternal }]} aria-hidden="true">
        <Icon name={isExternal ? "arrow-up-right" : "arrow-right"} size={16} />
      </span>
    </a>
  ) : (
    <div class="ui-row ui-row--static">
      <span class="ui-row__title">
        {status ? <>{head}<span class="library-row-tail">{tail}&nbsp;<StatusPill label={status} /></span></> : item.title}
      </span>
      {item.kind === "notes" ? (
        <time class="ui-row__meta library-row-meta" datetime={dateTime}>{trailingMeta}</time>
      ) : (
        <span class="ui-row__meta library-row-meta">{trailingMeta}</span>
      )}
      <span class="ui-row__glyph" aria-hidden="true"></span>
    </div>
  )}
</li>

<style>
  .library-row-tail {
    white-space: nowrap;
  }

  /* a long hostname or author yields to the title rather than crushing it */
  .library-row-meta {
    max-inline-size: clamp(calc(var(--step) * 28), 28vw, calc(var(--step) * 60));
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
