---
import Icon from "./Icon.astro";
import StatusPill from "./StatusPill.astro";
import type { LibraryCatalogItem } from "../lib/library-list";

interface Props {
  item: LibraryCatalogItem;
  linkedTags?: Set<string>;
  density?: "overview" | "full";
}

const { item, density = "full" } = Astro.props;
const date = item.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const dateTime = item.date.toISOString().slice(0, 10);
const isLinked = Boolean(item.href);
const isExternal = item.kind === "articles";
const status = item.kind === "books"
  ? item.status === "reading" ? "Reading" : item.status === "dropped" ? "Dropped" : null
  : item.kind === "watch"
    ? item.status === "watching" ? "Watching" : item.status === "dropped" ? "Dropped" : null
    : null;
const trailingMeta = item.kind === "notes"
  ? date
  : item.kind === "books"
    ? item.author
    : item.kind === "watch"
      ? item.platform
      : item.kind === "articles"
        ? item.hostname || item.source
        : date;
const label = isExternal ? `Open ${item.title}, external site` : `Open ${item.title}`;
---

<li class:list={["library-row", `is-${item.kind}`, { "is-linked": isLinked, "is-overview": density === "overview" }]}>
  {isLinked ? (
    <a
      class="library-row-shell is-link"
      href={item.href!}
      aria-label={label}
      {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      <div class="library-row-main">
        <span class="library-row-title">{item.title}</span>
        {status && <StatusPill label={status} class="library-row-status" />}
      </div>
      <div class="library-row-trailing">
        {item.kind === "notes" ? (
          <time class="library-row-meta is-date" datetime={dateTime}>{trailingMeta}</time>
        ) : (
          <span class="library-row-meta">{trailingMeta}</span>
        )}
        <span class:list={["library-row-direction", { "is-external": isExternal }]} aria-hidden="true">
          <Icon name={isExternal ? "arrow-up-right" : "chevron-right"} size={14} />
        </span>
      </div>
    </a>
  ) : (
    <div class="library-row-shell">
      <div class="library-row-main">
        <span class="library-row-title">{item.title}</span>
        {status && <StatusPill label={status} class="library-row-status" />}
      </div>
      <div class="library-row-trailing">
        {item.kind === "notes" ? (
          <time class="library-row-meta is-date" datetime={dateTime}>{trailingMeta}</time>
        ) : (
          <span class="library-row-meta">{trailingMeta}</span>
        )}
        <span class="library-row-direction is-empty" aria-hidden="true" />
      </div>
    </div>
  )}
</li>

<style>
  .library-row {
    margin: 0;
    transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
  }

  .library-row-shell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: 2.25rem;
    gap: var(--space-4);
    padding: 0.65rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--r-3);
    background: var(--surface-row-rest);
    border: none;
    box-shadow: none;
    text-decoration: none;
    color: inherit;
    transition:
      background-color var(--t-color),
      transform var(--dur-1) var(--ease-out);
  }

  .library-row-shell:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .library-row-main {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-inline-size: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .library-row-title {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--t-color);
  }

  .library-row-main :global(.library-row-status) {
    min-block-size: 1.125rem;
    font-size: 0.5625rem;
    padding-inline: 0.38rem;
    flex-shrink: 0;
  }

  .library-row-trailing {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .library-row-meta {
    color: var(--ghost);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 400;
    white-space: nowrap;
    line-height: 1;
    max-width: clamp(7rem, 28vw, 15rem);
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--t-color);
  }

  .library-row-meta.is-date {
    font-variant-numeric: tabular-nums;
  }

  .library-row-direction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ghost);
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: color var(--t-color), transform var(--dur-2) var(--ease-out);
  }

  .library-row-direction.is-empty {
    visibility: hidden;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .library-row.is-linked:hover .library-row-shell,
    .library-row.is-linked:focus-within .library-row-shell {
      background: var(--surface-row-hover);
    }

    .library-row.is-linked:hover .library-row-meta,
    .library-row.is-linked:focus-within .library-row-meta {
      color: var(--muted);
    }

    .library-row.is-linked:hover .library-row-direction,
    .library-row.is-linked:focus-within .library-row-direction {
      color: var(--ink);
    }

    .library-row.is-linked:hover .library-row-direction:not(.is-external),
    .library-row.is-linked:focus-within .library-row-direction:not(.is-external) {
      transform: translateX(3px);
    }

    .library-row.is-linked:hover .library-row-direction.is-external,
    .library-row.is-linked:focus-within .library-row-direction.is-external {
      transform: translate(2px, -2px);
    }
  }

  .library-row.is-linked:active .library-row-shell {
    background: var(--surface-row-press);
    transform: scale(0.995);
  }

  @media (max-width: 38rem) {
    .library-row-shell {
      min-block-size: 2.25rem;
      padding: 0.6rem 0.65rem;
      margin-inline: -0.65rem;
      gap: var(--space-2);
    }

    .library-row-main {
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .library-row-direction {
      transform: none !important;
    }
  }
</style>

