---
import Connect from "./Connect.astro";
import SocialProfilePreviews from "./SocialProfilePreviews.astro";
import { resumeUrl, site, socials } from "../data/home";
import { getGithubContributions } from "../lib/github-contributions";

const quickLinks = socials.filter(
  (social) => social.id === "github" || social.id === "linkedin" || social.id === "x",
);
const contributions = await getGithubContributions();
---

<div class="enriched-home">
  <section class="enriched-intro" aria-label="Introduction">
    <h1 class="visually-hidden">{site.name} · Staff Software Engineer, Payments Infrastructure</h1>
    <p class="enriched-lede">
      Hey! I'm <a href="/more/" aria-label="More about Ashwin">Ashwin</a>. I build the infrastructure behind global payments.
    </p>
    <p class="enriched-context">
      I work remotely as a Staff Software Engineer at <a href="https://developers.pismo.io/pismo-docs" target="_blank" rel="noopener noreferrer">Pismo, a Visa company</a>, and study AI at <a href="https://cdso.utexas.edu/msai" target="_blank" rel="noopener noreferrer">UT Austin</a> alongside work.
    </p>
    <p class="enriched-context">
      Off the clock, I'm happiest around good machinery and cars, or lost in anthropology, history, and long-form craft. Here’s my <a href="/library/">library</a>, <a href="/more/photos/">photos I take</a>, and <a href="/more/cafe/">cafes I try</a>.
    </p>
  </section>

  <section class="enriched-contact" aria-label="Contact and profiles">
    <h2 class="visually-hidden">Contact and profiles</h2>
    <div class="enriched-contact__row">
      <div class="enriched-cta-row">
        <a class="enriched-cta enriched-cta--primary" href={site.cal} target="_blank" rel="noopener noreferrer">Let's talk</a>
        {resumeUrl && <a class="enriched-cta enriched-cta--secondary" href={resumeUrl} download="AshwinGopalsamy_Resume.pdf" data-astro-prefetch="false">Resume</a>}
      </div>
      <span class="enriched-row-sep" aria-hidden="true"></span>
      <div class="enriched-socials">
        <SocialProfilePreviews links={quickLinks} contributions={contributions} />
      </div>
    </div>
  </section>

  <hr class="page-rule" />

  <Connect />
</div>

<style>
  .enriched-intro {
    margin-top: 0;
    font-size: var(--text-md);
  }

  .enriched-lede {
    max-width: var(--measure-hero);
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .enriched-context {
    max-width: var(--measure-hero);
    margin: 1.5em 0 0;
    color: var(--ghost);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .enriched-intro a {
    color: var(--ink);
    text-decoration: none;
    text-decoration-color: color-mix(in oklch, var(--ink) 55%, transparent);
    text-decoration-thickness: 0.75px;
    text-underline-offset: 0.2em;
  }

  .enriched-intro a:hover,
  .enriched-intro a:focus-visible {
    text-decoration-line: underline;
  }

  .enriched-home > .page-rule {
    margin-block: var(--space-rule);
  }

  .enriched-home :global(.connect-grid) {
    grid-template-columns: 1fr;
    grid-template-rows: 152px 200px;
    gap: var(--space-4);
  }

  .enriched-home :global(.quote-block) {
    margin-top: var(--space-5);
  }

  .enriched-contact {
    margin-top: var(--space-6);
  }

  .enriched-contact__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .enriched-cta-row,
  .enriched-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .enriched-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.3rem;
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--t-move), background-color var(--t-color), border-color var(--t-color), color var(--t-color);
  }

  .enriched-cta:hover,
  .enriched-cta:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--shadow-1);
  }

  .enriched-cta:active {
    transform: scale(var(--press-scale, .978));
    transition: transform var(--dur-press, 70ms) var(--ease-snap);
  }

  .enriched-cta--primary {
    background: var(--ink);
    color: var(--canvas);
  }

  .enriched-cta--secondary {
    border: 1px solid var(--cta-secondary-border);
    background: var(--cta-secondary-bg);
    color: var(--ink);
  }

  .enriched-row-sep {
    width: 1px;
    height: 1.1rem;
    flex-shrink: 0;
    background: var(--rule-strong);
  }

  .enriched-socials {
    gap: 1rem;
  }

  .enriched-socials :global(.social-preview__avatar) {
    display: none !important;
  }

  .enriched-socials :global(.social-preview__panel) {
    background: var(--canvas);
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-2);
    filter: blur(3px);
    transition:
      inset-inline-start var(--dur-3) cubic-bezier(0.33, 1, 0.68, 1),
      width var(--dur-3) cubic-bezier(0.33, 1, 0.68, 1),
      height var(--dur-3) cubic-bezier(0.33, 1, 0.68, 1),
      opacity var(--dur-2) var(--ease),
      filter 160ms ease-out;
  }

  .enriched-socials :global(.social-preview__panel.is-open) {
    filter: blur(0);
  }

  .enriched-socials :global(.social-preview__panel.is-instant) {
    transition: none;
  }

  .enriched-socials :global(.chip:focus-visible) {
    box-shadow: var(--shadow-inset);
  }

  .enriched-home :global(.spotify-wrap) {
    transition: box-shadow var(--t-color);
  }

  @media (hover: hover) and (pointer: fine) {
    .enriched-socials :global(.chip:hover) {
      box-shadow: var(--shadow-inset);
    }

    .enriched-home :global(.spotify-wrap:hover),
    .enriched-home :global(.loc-card:hover),
    .enriched-home :global(.spotify-wrap:focus-within),
    .enriched-home :global(.loc-card:focus-within) {
      box-shadow: var(--shadow-inset), var(--shadow-1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .enriched-socials :global(.chip:active) {
      transform: translateY(-1px) scale(var(--press-scale, .978));
      transition: transform var(--dur-1) var(--ease);
    }
  }

  @media (min-width: 42.5rem) {
    .enriched-home :global(.connect-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 152px;
    }

    .enriched-home :global(.connect-grid .loc-card) {
      min-height: 0;
      height: 152px;
    }
  }

  @media (max-width: 38rem) {
    .enriched-contact__row {
      align-items: stretch;
      flex-direction: column;
      gap: 0.9rem;
    }

    .enriched-cta-row {
      width: 100%;
      max-width: 21rem;
    }

    .enriched-cta {
      flex: 1;
    }

    .enriched-row-sep {
      display: none;
    }

    .enriched-socials {
      flex-wrap: wrap;
      gap: 0.8rem 1rem;
    }

    .enriched-home :global(.connect-grid) {
      grid-template-columns: 1fr;
      grid-template-rows: 152px 200px;
      gap: var(--space-5);
    }

    .enriched-home :global(.connect-grid .loc-card) {
      min-height: 200px;
      height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enriched-cta {
      transition: none;
    }

    .enriched-cta:hover,
    .enriched-cta:focus-visible,
    .enriched-cta:active {
      transform: none;
    }

    .enriched-socials :global(.social-preview__panel) {
      filter: none;
      transition: opacity var(--dur-2) linear;
    }

    .enriched-home :global(.spotify-wrap) {
      transition: none;
    }
  }
</style>
