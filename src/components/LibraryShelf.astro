---
import LibraryRows from "./LibraryRows.astro";
import { libraryLabels, type LibraryShelf as Shelf } from "../lib/library-list";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  shelf: Shelf;
  linkedTags: Set<string>;
}

const { shelf, linkedTags } = Astro.props;
const id = `library-shelf-${shelf.kind}`;
const label = libraryLabels[shelf.kind];
const accents = {
  books: "var(--acc-amber)",
  notes: "var(--acc-violet)",
  articles: "var(--acc-green)",
  watch: "var(--acc-blue)",
} as const;
---

<section class:list={["library-shelf", `is-${shelf.kind}`]} aria-labelledby={id}>
  <SectionHeading id={id} title={label} accent={accents[shelf.kind]}>
    <Fragment slot="action">
      <a
        class="library-all ui-cap ui-cap--quiet ui-cap--32 ui-cap--trail"
        href={`/library/?view=${shelf.kind}`}
        data-library-show-all
        data-library-view={shelf.kind}
        aria-label={`All ${shelf.total} ${label.toLowerCase()}`}
      >
        <span class="ui-cap__label">All <span class="ui-count">{shelf.total}</span></span>
        <span class="ui-arw" aria-hidden="true">
          <Icon name="arrow-right" size={14} strokeWidth={2} />
          <Icon name="arrow-right" size={14} strokeWidth={2} />
        </span>
      </a>
    </Fragment>
  </SectionHeading>
  <LibraryRows items={shelf.items} linkedTags={linkedTags} density="overview" />
</section>

<style>
  .library-shelf {
    margin-top: 0;
  }

  .library-shelf + .library-shelf {
    margin-top: clamp(2.75rem, 6vw, 3.5rem);
  }

  /* the capsule's own trailing inset, so its arrow lands on the rail with
     the rows' glyph column */
  .library-all {
    margin-inline-end: calc(var(--step-2) * -1);
  }
</style>
