---
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";

/**
 * 404 - the hidden room. Warm two-tone voice, search-palette hint, and
 * recovery destinations so even the wrong turn feels on-brand.
 *
 * Destinations are grouped by who is lost. A person who mistyped a URL
 * wants a page; an agent that followed a stale link wants a manifest.
 * Those are different lists and they are presented as different lists.
 */
const pages = [
  { href: "/", label: "Home", detail: "The introduction, and everything from there" },
  { href: "/library/", label: "Library", detail: "Notes, books, bookmarks, things watched" },
  { href: "/work/", label: "Work", detail: "Tools and side projects taken far enough to keep" },
  { href: "/links/", label: "Links", detail: "Every profile, in one place" },
];

const machineReadable = [
  { href: "/sitemap.md", label: "sitemap.md" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/ai/", label: "/ai" },
  { href: "/developers/", label: "/developers" },
];
---

<Page title="Not found" robots="noindex,follow" bodyClass="notfound-page" pagefind={false}>
  <section class="notfound" data-enter>
    <div class="nf-mark" aria-hidden="true">
      <span class="nf-404">404</span>
    </div>
    <h1 class="visually-hidden">Page Not Found</h1>
    <p class="nf-lede">This page took a wrong turn.</p>
    <p class="nf-muted">
      Nothing lives at this address. Press
      <kbd class="nf-kbd">⌘</kbd><kbd class="nf-kbd">K</kbd>
      <span class="nf-kbd-alt">(<kbd class="nf-kbd">Ctrl</kbd><kbd class="nf-kbd">K</kbd>)</span>{" "}
      to search once the palette lands, or pick the thread back up below.
    </p>

    <nav class="nf-group" aria-labelledby="nf-pages-label">
      <h2 class="nf-group-label" id="nf-pages-label">Pages</h2>
      <ul class="nf-rows" role="list">
        {pages.map((item) => (
          <li>
            <a class="nf-row" href={item.href}>
              <span class="nf-row-label">{item.label}</span>
              <span class="nf-row-detail">{item.detail}</span>
              <span class="nf-row-arrow" aria-hidden="true">
                <Icon name="chevron-right" size={15} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="nf-group" aria-labelledby="nf-machines-label">
      <h2 class="nf-group-label" id="nf-machines-label">For machines</h2>
      <ul class="nf-inline" role="list">
        {machineReadable.map((item) => (
          <li>
            <a class="nf-inline-link mono" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</Page>

<style>
  .notfound {
    max-width: 100%;
    margin-top: var(--step-3);
  }

  .nf-mark {
    position: relative;
    display: inline-block;
    margin-bottom: var(--step-5);
  }

  .nf-404 {
    font-family: "Newsreader Variable", "Iowan Old Style", Georgia, serif;
    font-style: italic;
    font-size: var(--text-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .nf-lede {
    font-size: var(--text-lg);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 var(--step-5);
  }

  .nf-muted {
    color: var(--muted);
    line-height: 1.8;
    /* one line box below the sentence, so the first group heading sits on
       the same ruling as everything else on the site */
    margin: 0 0 var(--rhythm-2);
    max-inline-size: 54ch;
    transition: color var(--t-color);
  }

  .nf-kbd {
    display: inline-block;
    min-width: 1.35em;
    padding: 0.12em 0.5em;
    margin-inline: 0.08em;
    border: var(--hairline) solid var(--chrome-surface-border);
    border-radius: var(--r-pill);
    background: var(--canvas);
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.78em;
    line-height: 1.4;
    color: var(--ink);
    text-align: center;
    box-shadow: inset 0 -1px 0 color-mix(in oklch, var(--ink) 8%, transparent);
  }

  .nf-kbd-alt {
    color: var(--faint);
    font-size: 0.92em;
  }

  /* ---------------------------------------------------------------- */
  /*  groups                                                          */
  /* ---------------------------------------------------------------- */

  .nf-group + .nf-group {
    margin-top: var(--rhythm-2);
  }

  .nf-group-label {
    margin: 0 0 var(--step-3);
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    letter-spacing: var(--type-section-tracking);
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  /* ---------------------------------------------------------------- */
  /*  page rows — the site's row pattern, not a second one            */
  /* ---------------------------------------------------------------- */

  .nf-rows {
    display: flex;
    flex-direction: column;
    gap: var(--surface-row-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-rows:hover li {
      opacity: var(--dim-opacity);
      filter: blur(var(--dim-blur));
      transition: opacity var(--dur-tint) var(--ease-enter), filter var(--dur-tint) var(--ease-enter);
    }

    .nf-rows:hover li:hover,
    .nf-rows:hover li:focus-within {
      opacity: 1;
      filter: none;
    }
  }

  .nf-rows li {
    transition: opacity var(--dur-tint) var(--ease-enter), filter var(--dur-tint) var(--ease-enter);
  }

  .nf-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(7rem, auto) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--step-4);
    padding: var(--step-3) var(--step-4);
    margin-inline: calc(var(--step-4) * -1);
    border-radius: var(--r-3);
    background: var(--surface-row-rest);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--t-color),
      transform var(--dur-press) var(--ease-snap);
  }

  /* the same hairline strike the content rows use */
  .nf-row::before {
    content: "";
    position: absolute;
    inset-block: var(--step-2);
    inset-inline-start: 0;
    width: 2px;
    border-radius: var(--r-pill);
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform var(--dur-shift) var(--ease-spring-snap);
  }

  .nf-row-label {
    font-weight: 560;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .nf-row-detail {
    color: var(--ghost);
    font-size: 0.9375rem;
    line-height: var(--leading-normal);
    transition: color var(--t-color);
  }

  .nf-row-arrow {
    align-self: center;
    color: var(--ghost);
    transition:
      transform var(--dur-shift) var(--ease-spring-pop),
      color var(--dur-tint) linear;
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-row:hover,
    .nf-row:focus-visible {
      background: var(--surface-row-hover);
    }

    .nf-row:hover::before,
    .nf-row:focus-visible::before {
      transform: scaleY(1);
    }

    .nf-row:hover .nf-row-detail,
    .nf-row:focus-visible .nf-row-detail {
      color: var(--muted);
    }

    .nf-row:hover .nf-row-arrow,
    .nf-row:focus-visible .nf-row-arrow {
      color: var(--ink);
      transform: translate3d(var(--travel-nudge), 0, 0);
    }
  }

  .nf-row:active {
    background: var(--surface-row-press);
    transform: scale(var(--press-scale-inline));
  }

  .nf-row:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  /* ---------------------------------------------------------------- */
  /*  machine-readable — one quiet line, separated by rules            */
  /* ---------------------------------------------------------------- */

  .nf-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--step-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf-inline li + li {
    padding-inline-start: var(--step-3);
    border-inline-start: var(--hairline) solid var(--rule);
  }

  .nf-inline-link {
    display: inline-block;
    padding-block: var(--step-1);
    color: var(--faint);
    font-size: var(--text-sm);
    text-decoration: none;
    text-decoration-color: transparent;
    transition: color var(--t-color), text-decoration-color var(--t-color);
  }

  .nf-inline-link:hover,
  .nf-inline-link:focus-visible {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 4px;
    text-decoration-color: currentColor;
  }

  @media (max-width: 38rem) {
    .nf-row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: var(--step-1);
      padding-inline: var(--step-3);
      margin-inline: calc(var(--step-3) * -1);
    }

    .nf-row-label {
      grid-column: 1;
    }

    .nf-row-arrow {
      grid-column: 2;
      grid-row: 1;
    }

    .nf-row-detail {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-row::before,
    .nf-row-arrow {
      transition: none;
    }
  }
</style>
