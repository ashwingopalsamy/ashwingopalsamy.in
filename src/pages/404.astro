---
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";

/**
 * 404 - the hidden room. Warm two-tone voice, search-palette hint, and
 * recovery destinations so even the wrong turn feels on-brand.
 *
 * Destinations are grouped by who is lost. A person who mistyped a URL
 * wants a page; an agent that followed a stale link wants a manifest.
 * Those are different lists and they are presented as different lists.
 */
const pages = [
  { href: "/", label: "Home", detail: "The introduction, and everything from there" },
  { href: "/library/", label: "Library", detail: "Notes, books, bookmarks, things watched" },
  { href: "/work/", label: "Work", detail: "Tools and side projects taken far enough to keep" },
  { href: "/links/", label: "Links", detail: "Every profile, in one place" },
];

const machineReadable = [
  { href: "/sitemap.md", label: "sitemap.md" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/ai/", label: "/ai" },
  { href: "/developers/", label: "/developers" },
];
---

<Page title="Not found" robots="noindex,follow" bodyClass="notfound-page" pagefind={false}>
  <section class="notfound" data-enter>
    <div class="nf-mark" aria-hidden="true">
      <span class="nf-404">404</span>
    </div>
    <h1 class="visually-hidden">Page Not Found</h1>
    <p class="nf-lede">This page took a wrong turn.</p>
    <p class="nf-muted">
      Nothing lives at this address. Press{" "}
      <kbd class="ui-kbd" aria-label="Command"><Icon name="command" size={12} strokeWidth={2.2} /></kbd><kbd class="ui-kbd">K</kbd>{" "}
      <span class="nf-kbd-alt">(<kbd class="ui-kbd">Ctrl</kbd><kbd class="ui-kbd">K</kbd>)</span>{" "}
      to search, or pick the thread back up below.
    </p>

    <nav class="nf-group" aria-labelledby="nf-pages-label">
      <h2 class="nf-group-label" id="nf-pages-label">Pages</h2>
      <ul class="nf-rows surface-stack" role="list">
        {pages.map((item) => (
          <li>
            <a class="ui-row ui-row--multiline" data-fx="spot" href={item.href}>
              <span class="nf-row-main">
                <span class="ui-row__title">{item.label}</span>
                <span class="ui-row__sub">{item.detail}</span>
              </span>
              <span class="ui-row__glyph" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="nf-group" aria-labelledby="nf-machines-label">
      <h2 class="nf-group-label" id="nf-machines-label">For machines</h2>
      <ul class="nf-inline" role="list">
        {machineReadable.map((item) => (
          <li>
            <a class="ui-link nf-inline-link mono" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</Page>

<style>
  .notfound {
    max-width: 100%;
    margin-top: var(--step-3);
  }

  .nf-mark {
    position: relative;
    display: inline-block;
    margin-bottom: var(--step-5);
  }

  .nf-404 {
    font-family: "Newsreader Variable", "Newsreader Fallback", "Iowan Old Style", Georgia, serif;
    font-style: italic;
    font-size: var(--text-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .nf-lede {
    font-size: var(--text-lg);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 var(--step-5);
  }

  .nf-muted {
    color: var(--muted);
    line-height: 1.8;
    /* one line box below the sentence, so the first group heading sits on
       the same ruling as everything else on the site */
    margin: 0 0 var(--rhythm-2);
    max-inline-size: 54ch;
    transition: color var(--t-color);
  }

  /* keycaps ride the sentence's middle, a hair apart */
  .nf-muted .ui-kbd {
    vertical-align: middle;
  }

  .nf-muted .ui-kbd + .ui-kbd {
    margin-inline-start: calc(var(--step) / 2);
  }

  .nf-kbd-alt {
    color: var(--faint);
    font-size: 0.92em;
  }

  /* ---------------------------------------------------------------- */
  /*  groups                                                          */
  /* ---------------------------------------------------------------- */

  .nf-group + .nf-group {
    margin-top: var(--rhythm-2);
  }

  .nf-group-label {
    margin: 0 0 var(--step-3);
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    letter-spacing: var(--type-section-tracking);
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  /* ---------------------------------------------------------------- */
  /*  page rows: the label and its line side by side, one column on    */
  /*  phones                                                           */
  /* ---------------------------------------------------------------- */

  .nf-row-main {
    flex: 1;
    min-inline-size: 0;
    display: grid;
    grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--step-4);
  }

  .nf-row-main .ui-row__sub {
    margin-block-start: 0;
  }

  /* ---------------------------------------------------------------- */
  /*  machine-readable: one quiet line, separated by rules             */
  /* ---------------------------------------------------------------- */

  .nf-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-1) var(--step-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf-inline li + li {
    padding-inline-start: var(--step-3);
    border-inline-start: var(--hairline) solid var(--rule);
  }

  .nf-inline-link {
    position: relative;
    font-size: var(--text-sm);
  }

  /* a 44px target around a line of text */
  .nf-inline-link::after {
    content: "";
    position: absolute;
    inset: calc(var(--step-3) * -1) calc(var(--step-2) * -1);
  }

  .mono {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
  }

  @media (max-width: 38rem) {
    .nf-row-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .nf-row-main .ui-row__sub {
      margin-block-start: calc(var(--step) / 2);
    }
  }
</style>
