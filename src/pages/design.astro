---
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import { site } from "../data/home";
import Page from "../layouts/Page.astro";
import { designDocument } from "../lib/design-document";
import { ogPath } from "../lib/og-url";
import { absUrl } from "../lib/urls";

const neutralTokens = Object.entries(designDocument.frontmatter.colors).filter(([name]) =>
  name.startsWith("neutral-"),
);

const semanticTokens = [
  {
    label: "Green",
    light: designDocument.frontmatter.colors["success-light"]!,
    dark: designDocument.frontmatter.colors["success-dark"]!,
    role: "available, success, live endpoints",
  },
  {
    label: "Amber",
    light: designDocument.frontmatter.colors["warning-light"]!,
    dark: designDocument.frontmatter.colors["warning-dark"]!,
    role: "warning, winding down",
  },
  {
    label: "Blue",
    light: designDocument.frontmatter.colors["information-light"]!,
    dark: designDocument.frontmatter.colors["information-dark"]!,
    role: "information, links",
  },
  {
    label: "Violet",
    light: designDocument.frontmatter.colors["important-light"]!,
    dark: designDocument.frontmatter.colors["important-dark"]!,
    role: "important, highlight",
  },
  {
    label: "Red",
    light: designDocument.frontmatter.colors["caution-light"]!,
    dark: designDocument.frontmatter.colors["caution-dark"]!,
    role: "caution, error, asleep (off-hours)",
  },
];

const typeWeights = [
  { weight: 400, label: "400", role: "body, reading" },
  { weight: 450, label: "450", role: "active nav" },
  { weight: 500, label: "500", role: "controls" },
  { weight: 550, label: "550", role: "headings" },
  { weight: 600, label: "600", role: "strong" },
] as const;

const motionDurations = [
  { token: "--dur-press", value: "70ms", role: "press feedback" },
  { token: "--dur-tint", value: "110ms", role: "colour only" },
  { token: "--dur-exit", value: "120ms", role: "departure" },
  { token: "--dur-nudge", value: "150ms", role: "movement under 8px" },
  { token: "--dur-shift", value: "200ms", role: "component movement" },
  { token: "--dur-enter", value: "240ms", role: "arrival" },
  { token: "--dur-overlay", value: "280ms", role: "full-surface overlays" },
];

const soundAccents = [
  { name: "tap" as const, label: "Tap", desc: "440 to 350 Hz damped glide with organic variation · 36 ms" },
  { name: "tick" as const, label: "Tick", desc: "600 Hz triangle micro-click · 28 ms" },
  { name: "select" as const, label: "Select", desc: "415 Hz sine navigation tick · 22 ms" },
  { name: "pop" as const, label: "Pop", desc: "440 to 659 Hz ascending bubble · 65 ms" },
  { name: "dismiss" as const, label: "Dismiss", desc: "659 to 440 Hz descending micro-drop · 55 ms" },
  { name: "tab" as const, label: "Tab", desc: "440 + 880 Hz dual-tone marimba · 55 ms" },
  { name: "flip" as const, label: "Flip", desc: "440 + 659 Hz triangle latch · 75 ms" },
  { name: "theme" as const, label: "Theme", desc: "523 + 784 + 1046 Hz radiant shimmer · 180 ms" },
  { name: "toggle-on" as const, label: "Toggle on", desc: "587 to 880 Hz ascending fifth · 120 ms" },
  { name: "toggle-off" as const, label: "Toggle off", desc: "880 to 587 Hz descending fifth · 120 ms" },
  { name: "action" as const, label: "Action", desc: "523 + 784 Hz affirmative chord · 110 ms" },
  { name: "copy" as const, label: "Copy", desc: "659 to 880 Hz warm harmonic confirmation · 120 ms" },
  { name: "page" as const, label: "Page", desc: "392 + 523 Hz ambient dual pulse · 220 ms" },
  { name: "chime" as const, label: "Chime", desc: "528 + 792 Hz gentle ambient chime · 450 ms" },
];

const description = "A working account of the choices behind ashwingopalsamy.in.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${absUrl("/design/")}#article`,
  url: absUrl("/design/"),
  name: "How I design this site",
  headline: "How I design this site",
  description,
  author: { "@id": `${site.url}/#person` },
  dateModified: designDocument.auditedAt,
  version: designDocument.contractVersion,
  image: ogPath("design"),
  inLanguage: "en",
};
---

<Page
  title="How I design this site"
  description={description}
  ogImage={ogPath("design")}
  ogImageAlt="How I design this site · Ashwin Gopalsamy"
  jsonLd={jsonLd}
  alternates={[{ href: absUrl("/design.md"), type: "text/markdown", title: "Design notes for ashwingopalsamy.in" }]}
>
  <article class="design-guide" data-design-guide data-enter>
    <div class="reading-progress" aria-hidden="true"><div data-progress-bar></div></div>

    <PageIntro
      title="How I design this site"
      lede="Every decision here was made at least twice: once quickly, and once after the first version felt wrong. This is the record of what I settled on and why. It is not a style guide. It is closer to a set of running notes from someone who keeps rebuilding the same site until it stops bothering him."
      eyebrow="design"
    />

    <section id="colour" class="design-chapter">
      <h2>Valyrian Steel and the one accent</h2>
      <p>Most of the site runs on nine shades of grey. Not because grey is safe, but because limiting colour to a single role gives it weight. Five semantic tones live alongside the neutral ramp for callouts, presence states, and the command palette. Each semantic colour only appears in context: paired with copy, position, shape, or an icon. Colour is never the only signal.</p>
      <p>The nine greys are OKLCH at hue 240. Plain sRGB neutrals warm as they approach white, leaving an unintentional yellow cast on light surfaces. OKLCH at hue 240 stays perceptually neutral across the full ramp: the same temperature of light at every step. Light mode uses step 1 as canvas and step 9 as ink. Dark mode reverses them exactly, and the same hierarchy holds.</p>

      <div class="tonal-showcase">
        <div class="tonal-header">
          <span class="tonal-title">Valyrian Steel</span>
          <span class="tonal-subtitle">9-step neutral ramp · OKLCH hue 240</span>
        </div>
        <div class="tonal-grid" role="toolbar" aria-label="Neutral colour tokens">
          {neutralTokens.map(([name, value], index) => (
            <button
              type="button"
              class="tonal-swatch"
              style={`--swatch: ${value}`}
              data-swatch-index={index}
              data-token={name}
              data-value={value}
              aria-pressed={index === 0 ? "true" : "false"}
              aria-label={`Select ${name}: ${value}`}
            >
              <span class="tonal-swatch-step">{index + 1}</span>
            </button>
          ))}
        </div>
        <div class="tonal-detail" aria-live="polite">
          <div class="tonal-detail-meta">
            <span class="tonal-token-tag" data-swatch-token>{neutralTokens[0]?.[0]}</span>
            <code class="ui-badge ui-badge--mono" data-swatch-value>{neutralTokens[0]?.[1]}</code>
          </div>
          <button
            type="button"
            class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead"
            data-fx="spot"
            data-swatch-copy
            data-copy={neutralTokens[0]?.[1]}
            data-state="idle"
          >
            <span class="ui-stk ui-stk--icon" aria-hidden="true">
              <span data-when="idle"><Icon name="copy" size={14} strokeWidth={2} /></span>
              <span data-when="done"><Icon name="check" size={14} strokeWidth={2} class="ui-draw" /></span>
              <span data-when="error"><Icon name="alert" size={14} strokeWidth={2} /></span>
            </span>
            <span class="ui-cap__label ui-stk">
              <span data-when="idle">Copy OKLCH</span>
              <span data-when="done">Copied</span>
              <span data-when="error">Retry</span>
            </span>
          </button>
        </div>
      </div>

      <blockquote class="naming-note">{designDocument.frontmatter.namingNote}</blockquote>

      <p>Five semantic tones carry intent across the palette: Green for success and availability, Amber for warnings and winding down, Blue for information, Violet for highlights, and Red for caution, error, and off-hours. Each appears only in context, always paired with copy, position, shape, or an icon.</p>

      <div class="semantic-grid" role="list" aria-label="Semantic colour tokens">
        {semanticTokens.map((tok) => (
          <div class="semantic-card" role="listitem">
            <div class="semantic-swatch-pair" aria-hidden="true">
              <span class="semantic-swatch-half light" style={`background: ${tok.light}`}>
                <span class="ui-badge ui-badge--mono">light</span>
              </span>
              <span class="semantic-swatch-half dark" style={`background: ${tok.dark}`}>
                <span class="ui-badge ui-badge--mono">dark</span>
              </span>
            </div>
            <div class="semantic-card-content">
              <div class="semantic-card-header">
                <span class="semantic-dot" style={`background: ${tok.light}`}></span>
                <span class="semantic-swatch-label">{tok.label}</span>
              </div>
              <p class="semantic-swatch-role">{tok.role}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="semantic-caption">Each swatch shows the light-mode value on the left and the dark-mode value on the right. The hue stays constant; only the lightness shifts.</p>
    </section>

    <section id="type" class="design-chapter">
      <h2>Three typefaces, one job each</h2>
      <p><span class="col-k">Inter</span> carries navigation, prose, and UI. <span class="col-k">Newsreader Italic</span> gets one serif moment: the naming note for the grey scale, literary asides, and quote attribution. <span class="col-k">JetBrains Mono</span> is for code, tokens, hashes, timestamps, and measurements only. Each font stays inside its lane, which means each one can lean into what it does well.</p>
      <p>Emphasis here comes from value, not weight. A word in <span class="col-k">ink</span> against a sentence in ghost does what italic or bold usually does, without adding typographic clutter. When weight does change, it changes in deliberate steps. Click through them below.</p>

      <div class="weight-specimen" data-weight-specimen>
        <div class="specimen-header">
          <span class="specimen-label">Inter weight ramp</span>
          <div class="ui-seg ui-seg--sm" data-weight-seg>
            <div class="ui-seg__track" role="group" aria-label="Inter weight">
              <span class="ui-seg__ind" aria-hidden="true"></span>
              {typeWeights.map((w, i) => (
                <button
                  type="button"
                  class="ui-seg__item"
                  data-weight={String(w.weight)}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  <span class="ui-cap__label">{w.label}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <div class="weight-display" aria-live="polite">
          <p class="weight-sample" data-weight-sample style="font-weight: 400">I work from home; on a countryside region wrapped in coconut groves, close enough to the Western Ghats that the weather has opinions.</p>
          <div class="weight-meta">
            <span class="weight-role" data-weight-role>400 - body, reading</span>
          </div>
        </div>
      </div>

      <div class="font-specimen font-serif-specimen">
        <p class="serif-sample">The exact values are in <a href="/design.md" class="ui-link inline-mono" data-astro-prefetch="false">design.md</a>. This page is the part I rewrite when the site teaches me something.</p>
        <span class="font-label">Newsreader Italic · 400 · 1.55 leading. One serif moment, used sparingly.</span>
      </div>

      <div class="font-specimen font-mono-specimen" data-mono-specimen>
        <div class="specimen-header">
          <span class="specimen-label">Baseline alignment</span>
          <button type="button" class="ui-cap ui-cap--chip ui-cap--32 ui-cap--lead" data-mono-toggle aria-pressed="true">
            <Icon name="arrow-up-down" size={14} strokeWidth={2} />
            <span class="ui-cap__label" data-mono-toggle-label>Optical shift on</span>
          </button>
        </div>
        <div class="mono-stage">
          <p class="mono-sample">
            <span data-mono-shifted class="mono-shifted">oklch(0.58 0.2 25)</span>
            <span class="mono-separator" aria-hidden="true"> vs </span>
            <span class="mono-unshifted">oklch(0.58 0.2 25)</span>
          </p>
          <p class="mono-explain">Left shifts 1 px down to align optically with Inter. Right sits on the natural baseline. Without the correction, monospace sits slightly high and reads as floating.</p>
        </div>
      </div>
    </section>

    <section id="layout" class="design-chapter">
      <h2>One rail, every page</h2>
      <p>Header, content, and footer share one fixed rail: <code class="inline-code">clamp(680px, 52vw, 800px)</code> wide, with 20 px gutters on each side. At 800 px and around 64 characters per line, a paragraph sits at the comfortable top of the reading range. Wider feels like a newspaper column that requires head movement; narrower starts to feel cramped on a desktop screen.</p>
      <p>The same rail for every route. No "wide" library view, no "narrow" notes layout. Consistency means the reader's eye always starts from the same place.</p>

      <div class="rail-specimen" data-rail-specimen data-measure="home">
        <div class="specimen-header">
          <span class="specimen-label">Reading measure</span>
          <div class="ui-seg ui-seg--sm" data-measure-seg>
            <div class="ui-seg__track" role="group" aria-label="Reading measure">
              <span class="ui-seg__ind" aria-hidden="true"></span>
              <button type="button" class="ui-seg__item" data-measure="narrow" aria-pressed="false">
                <span class="ui-cap__label">Narrow</span>
              </button>
              <button type="button" class="ui-seg__item" data-measure="home" aria-pressed="true">
                <span class="ui-cap__label">Rail</span>
              </button>
              <button type="button" class="ui-seg__item" data-measure="full" aria-pressed="false">
                <span class="ui-cap__label">Unconstrained</span>
              </button>
            </div>
          </div>
        </div>
        <div class="rail-ruler" aria-hidden="true">
          <span class="rail-ruler-line"></span>
          <span class="rail-ruler-label mono" data-rail-label>64 ch (~800 px max) · Settled reading rail</span>
        </div>
        <div class="measure-stage" aria-live="polite">
          <p class="measure-copy">A comfortable line length lets the eye glide effortlessly across ten to twelve words before sweeping back to the start of the next line. When a measure is too wide, the return sweep becomes a conscious search; when too narrow, the rhythm fractures into constant stops and starts. The 64-character rail keeps reading continuous and effortless.</p>
          <p class="measure-aside">Typography is ergonomics for the eyes: wider is not better, and narrower is not tidier.</p>
        </div>
      </div>

      <p>Below 608 px the layout shifts: the top navigation disappears and five fixed tabs appear above the safe area at the bottom. The body reserves space beneath the bar via <code class="inline-code">--mobile-chrome-clearance</code>, so the last line of any page is never hidden behind it. Section spacing is larger above a heading than below it, which gives the eye a clear signal that a new topic is starting.</p>
    </section>

    <section id="navigation" class="design-chapter">
      <h2>The sliding pill and the back arrow</h2>
      <p>The navigation indicator is one element that translates. Not two navs with active and inactive classes, not a JavaScript-measured offset: one <code class="inline-code">span</code> that slides with a <code class="inline-code">translate3d()</code> the GPU can composite without touching layout. Pressing a link changes a <code class="inline-code">data-active-index</code> attribute on the nav element. CSS rules drive the transform. Nothing repaints.</p>

      <div class="nav-specimen" data-nav-specimen data-active-index="0">
        <div class="specimen-header">
          <span class="specimen-label">GPU translation</span>
          <div class="ui-seg nav-sample" role="group" aria-label="Navigation pill specimen">
            <span class="nav-sample-pill" aria-hidden="true"></span>
            {(["home", "work", "more"] as const).map((item, i) => (
              <button
                type="button"
                class="ui-cap ui-cap--quiet ui-cap--40"
                data-nav-index={String(i)}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span class="ui-cap__label">{item}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="specimen-note" data-nav-note>One element translates. The pill never jumps; it slides.</p>
      </div>

      <p>On desktop, three items: home, work, and more. On mobile, five tabs at the bottom: home, work, AI, more, and links. The extra two on mobile exist because those pages matter more to someone on a phone. The desktop glass surface uses <code class="inline-code">blur(20px) saturate(170%)</code>. The mobile tab bar is opaque: backdrop filters on an element that scrolls with the page are expensive, and the mobile bar is fixed.</p>
      <p>The weight and measure switchers on this page are the other half of that idea: the same indicator, with one addition. A copy of the labels in canvas colour is clipped to the indicator's box, so each word inverts exactly where the ink passes under it and text and ink travel as one object.</p>

      <p>The logo slot changes based on depth. On the homepage it shows the wordmark. On every other page it shows a back arrow and navigates to the logical parent. The two states share one element via a CSS grid stack. Transitioning between them is a crossfade through blur: same element, different state, one transition.</p>

      <div class="logo-specimen" data-logo-specimen>
        <div class="specimen-header">
          <span class="specimen-label">Wordmark & back arrow crossfade</span>
          <button type="button" data-logo-toggle class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead" data-fx="spot">
            <Icon name="repeat" size={14} strokeWidth={2} />
            <span class="ui-cap__label">Toggle state</span>
          </button>
        </div>
        <div class="logo-demo-stage">
          <div class="logo-demo-circle chrome-surface" data-logo-state="home" aria-hidden="true">
            <span class="logo-demo-mark">
              <svg viewBox="0 0 1080 1080" width="28" height="28" fill="currentColor" class="wordmark-logo" aria-hidden="true">
                <path d="M376.935 380.038h74.012v287.088h-74.012V633.25q-33.276 41.915-93.518 41.915-57.374 0-98.682-43.638Q144 587.316 144 523.582t40.735-107.37Q226.043 372 283.417 372q60.242 0 93.518 41.915zm-136.548 202.11q22.376 22.393 56.799 22.393 34.425 0 56.8-22.393 22.949-22.966 22.949-58.566t-22.949-57.991q-22.375-22.967-56.8-22.967t-56.799 22.967q-22.376 22.392-22.376 57.991t22.376 58.566m497.412-202.11h72.29v273.308q0 66.605-44.178 101.629Q722.309 790 660.345 790q-46.472 0-82.044-17.799-34.996-17.8-53.931-52.25l63.111-36.174q21.802 40.193 75.159 40.193 34.999 0 55.078-18.374t20.081-52.25v-31.005q-32.702 43.637-91.797 43.637-60.816 0-102.125-42.489-40.734-43.063-40.735-104.5 0-60.862 41.309-103.926T646.002 372q59.095 0 91.797 43.637zm-138.27 195.794q22.951 21.82 57.947 21.819 34.999 0 57.373-21.819 22.95-22.392 22.95-56.843 0-33.877-22.95-55.695-22.375-22.393-57.373-22.393-34.996 0-57.947 22.393-22.375 21.818-22.375 55.695 0 34.45 22.375 56.843m355.128 84.404q-14.345 14.354-34.424 14.355-20.082 0-34.424-14.355-14.344-14.353-14.343-34.45t14.343-34.451 34.424-14.354q20.08 0 34.424 14.354Q969 605.689 969 625.786t-14.343 34.45" />
              </svg>
            </span>
            <span class="logo-demo-back-icon"><Icon name="arrow-left" size={16} /></span>
          </div>
          <div class="logo-demo-info">
            <span class="specimen-note" data-logo-note>Homepage: shows the wordmark. Anywhere else: shows back arrow.</span>
          </div>
        </div>
      </div>

      <p>Pressing <span class="kbd-combo"><kbd class="ui-kbd"><Icon name="command" size={12} strokeWidth={2.2} label="Command" /></kbd><kbd class="ui-kbd">K</kbd></span> or <kbd class="ui-kbd">/</kbd> opens the command palette, and so does the search button in the header. The search manifest is fully embedded at build time, so every result is instant with no network round-trip.</p>
    </section>

    <section id="motion" class="design-chapter">
      <h2>Seven durations, three springs</h2>
      <p>Every animation on the site draws from seven durations, each tied to how much attention the movement should ask for. 70 ms for the press itself, faster than the eye expects, which makes a control feel physically responsive. 110 ms when only colour changes and nothing moves. 120 ms for a departure, always shorter than the matching arrival. 150 ms for movement under 8 px, 200 ms for a component moving, 240 ms for something arriving that was not there, 280 ms for an overlay that deserves a breath.</p>
      <p>Releasing a press is not a duration, it is a spring. A small capsule overshoots a little and settles; a wide row or card comes back without a wobble, because on a wide target a wobble reads as a mistake. Click a circle to see how a duration feels. The same dot, seven different paces.</p>

      <div class="duration-grid" role="list" aria-label="Motion duration specimens">
        {motionDurations.map((d) => (
          <div class="duration-card" role="listitem">
            <button
              type="button"
              class="ui-cap ui-cap--glass ui-cap--icon"
              data-fx="spot"
              data-duration={d.value}
              aria-label={`Play ${d.value} animation sample`}
            >
              <span class="duration-dot" data-dot></span>
            </button>
            <div class="duration-info">
              <code class="duration-token mono">{d.token}</code>
              <span class="duration-value mono">{d.value}</span>
              <span class="duration-role">{d.role}</span>
            </div>
          </div>
        ))}
      </div>

      <p>Route transitions use <span class="col-k">blur only</span>: never opacity, never position. Any opacity below 1 during the route change causes a visible canvas flash, even for a single 16 ms frame. Blur keeps the element fully opaque while masking the content change. The outgoing page blurs in 90 ms; the incoming page clears in 200 ms. The header stays fixed throughout.</p>

      <div class="route-specimen" data-route-specimen>
        <div class="specimen-header">
          <span class="specimen-label">Zero-flash route swap</span>
          <button type="button" class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead" data-fx="spot" data-replay-route>
            <Icon name="repeat" size={14} strokeWidth={2} />
            <span class="ui-cap__label">Replay handoff</span>
          </button>
        </div>
        <div class="route-mockup">
          <div class="route-chrome" aria-hidden="true">
            <span class="route-logo">
              <svg viewBox="0 0 1080 1080" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M376.935 380.038h74.012v287.088h-74.012V633.25q-33.276 41.915-93.518 41.915-57.374 0-98.682-43.638Q144 587.316 144 523.582t40.735-107.37Q226.043 372 283.417 372q60.242 0 93.518 41.915zm-136.548 202.11q22.376 22.393 56.799 22.393 34.425 0 56.8-22.393 22.949-22.966 22.949-58.566t-22.949-57.991q-22.375-22.967-56.8-22.967t-56.799 22.967q-22.376 22.392-22.376 57.991t22.376 58.566m497.412-202.11h72.29v273.308q0 66.605-44.178 101.629Q722.309 790 660.345 790q-46.472 0-82.044-17.799-34.996-17.8-53.931-52.25l63.111-36.174q21.802 40.193 75.159 40.193 34.999 0 55.078-18.374t20.081-52.25v-31.005q-32.702 43.637-91.797 43.637-60.816 0-102.125-42.489-40.734-43.063-40.735-104.5 0-60.862 41.309-103.926T646.002 372q59.095 0 91.797 43.637zm-138.27 195.794q22.951 21.82 57.947 21.819 34.999 0 57.373-21.819 22.95-22.392 22.95-56.843 0-33.877-22.95-55.695-22.375-22.393-57.373-22.393-34.996 0-57.947 22.393-22.375 21.818-22.375 55.695 0 34.45 22.375 56.843m355.128 84.404q-14.345 14.354-34.424 14.355-20.082 0-34.424-14.355-14.344-14.353-14.343-34.45t14.343-34.451 34.424-14.354q20.08 0 34.424 14.354Q969 605.689 969 625.786t-14.343 34.45" />
              </svg>
            </span>
            <div class="ui-seg ui-seg--sm" data-route-seg>
              <div class="ui-seg__track" role="group" aria-label="Route switcher">
                <span class="ui-seg__ind" aria-hidden="true"></span>
                <button type="button" class="ui-seg__item" data-route-tab="0" aria-pressed="true">
                  <span class="ui-cap__label">home</span>
                </button>
                <button type="button" class="ui-seg__item" data-route-tab="1" aria-pressed="false">
                  <span class="ui-cap__label">work</span>
                </button>
                <button type="button" class="ui-seg__item" data-route-tab="2" aria-pressed="false">
                  <span class="ui-cap__label">more</span>
                </button>
              </div>
            </div>
          </div>
          <div class="route-stage" aria-live="polite">
            <span class="route-page route-page-old" data-route-old>home</span>
            <span class="route-page route-page-new" data-route-new>work</span>
          </div>
        </div>
        <span class="specimen-note" data-route-status>The header stays fixed. The page beneath it settles in 250 ms.</span>
      </div>

      <p>With reduced motion enabled, all travel is removed. What remains: colour transitions, opacity on show and hide, and focus feedback. The experience is complete without animation.</p>
    </section>

    <section id="sound" class="design-chapter">
      <h2>A tiny Web Audio engine</h2>
      <p>The site has fourteen interaction sounds. None of them are audio files. Each one is a few lines of Web Audio API: create an oscillator, set a frequency, ramp the gain down to near zero. The complete engine is a single TypeScript module with no runtime dependency, gentle organic micro-pitch variation to prevent auditory fatigue, and a master gain of 0.09 - quiet enough that it reads as a texture rather than a notification.</p>
      <p>Sound is on by default, controlled by the toggle in the footer, and persisted in <code class="inline-code">localStorage</code>. Open tabs stay in sync via the <code class="inline-code">storage</code> event. The <code class="inline-code">AudioContext</code> is only created from a real user gesture - before that, any call to <code class="inline-code">playAccent()</code> is a no-op.</p>

      <div class="sound-section" data-sound-grid>
        <p class="sound-muted-note" data-sound-muted-note aria-live="polite"></p>
        <div class="sound-grid">
          {soundAccents.map((accent) => (
            <button
              type="button"
              class="ui-row ui-row--multiline sound-row"
              data-accent={accent.name}
              aria-label={`Play ${accent.label} sound`}
            >
              <span class="ui-row__title">{accent.label}</span>
              <span class="ui-row__meta sound-desc">{accent.desc}</span>
              <span class="ui-row__glyph" aria-hidden="true"><Icon name="play" size={14} strokeWidth={2} /></span>
            </button>
          ))}
        </div>
      </div>

      <p>Sound carries no meaning alone. Every accent is redundant with a visual change: the theme toggle shows the sun shift before any tone plays. Someone with sound off misses nothing. The mute confirm plays before the gate flips, so the last sound you hear when muting is the descending toggle-off chord.</p>
    </section>

    <section id="interactions" class="design-chapter">
      <h2>The details that compound</h2>
      <p>Individually, none of these are remarkable. Together, they account for most of the time I spend on this site.</p>

      <h3>Pills, at five heights</h3>
      <p>Every single-line control is a pill, at one of five heights: 48 for the one primary action, 40 for segments and the footer, 32 for inline actions like copy, 28 for tags, and 20 for a badge, which only states a fact and is never pressable. Anything with more than one line is a rounded rectangle whose radius nests inside its padding. Glass is a recipe, not a blur: a sheen, an opaque fill, a gradient rim, a specular edge and a shadow, painted once. Real blur goes only where content actually moves behind the surface.</p>

      <div class="height-specimen">
        <div class="height-item">
          <a class="ui-cap ui-cap--ink" href="/contact/" data-fx="spot magnet">
            <span class="ui-cap__label">Let's talk</span>
          </a>
          <span class="height-key">48 · ink</span>
        </div>
        <div class="height-item">
          <a class="ui-cap ui-cap--glass ui-cap--40" href="/library/" data-fx="spot">
            <span class="ui-cap__label">Library</span>
          </a>
          <span class="height-key">40 · glass</span>
        </div>
        <div class="height-item">
          <button type="button" class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead" data-fx="spot" data-copy data-state="idle">
            <span class="ui-stk ui-stk--icon" aria-hidden="true">
              <span data-when="idle"><Icon name="copy" size={14} strokeWidth={2} /></span>
              <span data-when="done"><Icon name="check" size={14} strokeWidth={2} class="ui-draw" /></span>
              <span data-when="error"><Icon name="alert" size={14} strokeWidth={2} /></span>
            </span>
            <span class="ui-cap__label ui-stk">
              <span data-when="idle">Copy link</span>
              <span data-when="done">Copied</span>
              <span data-when="error">Retry</span>
            </span>
          </button>
          <span class="height-key">32 · glass</span>
        </div>
        <div class="height-item">
          <a class="ui-chip" href="/library/tags/">
            <span class="ui-cap__label"><span class="ui-chip__hash">#</span>payments</span>
          </a>
          <span class="height-key">28 · chip</span>
        </div>
        <div class="height-item">
          <span class="ui-badge" data-tone="live">live</span>
          <span class="height-key">20 · badge</span>
        </div>
      </div>

      <p>Every press goes down in 70 ms and springs back up, and none of it moves layout: width never animates, so a capsule that says Copy is as wide as the word Copied. State is never colour alone. Success shows a check and a word, and soon shows a dot and a word.</p>

      <h3>Arrow direction</h3>
      <p>One glyph per meaning, and it never hides. Hovering does not reveal an arrow, it moves one: the glyph leaves along its own direction while a twin arrives behind it. This is the complete set.</p>

      <ul class="arrow-grid">
        <li class="arrow-row">
          <a class="ui-cap ui-cap--glass ui-cap--32 ui-cap--trail" href="/library/" data-fx="spot">
            <span class="ui-cap__label">The library</span>
            <span class="ui-arw" aria-hidden="true">
              <Icon name="arrow-right" size={14} strokeWidth={2} />
              <Icon name="arrow-right" size={14} strokeWidth={2} />
            </span>
          </a>
          <span class="arrow-role">ArrowRight: another page on this site</span>
        </li>
        <li class="arrow-row">
          <a class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead" href="/" data-fx="spot">
            <span class="ui-arw ui-arw--back" aria-hidden="true">
              <Icon name="arrow-left" size={14} strokeWidth={2} />
              <Icon name="arrow-left" size={14} strokeWidth={2} />
            </span>
            <span class="ui-cap__label">Back home</span>
          </a>
          <span class="arrow-role">ArrowLeft: back, or the page before. The icon sits on the left.</span>
        </li>
        <li class="arrow-row">
          <a
            class="ui-cap ui-cap--glass ui-cap--32 ui-cap--trail"
            href={site.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-fx="spot"
          >
            <span class="ui-cap__label">Source</span>
            <span class="ui-arw ui-arw--ext" aria-hidden="true">
              <Icon name="arrow-up-right" size={14} strokeWidth={2} />
              <Icon name="arrow-up-right" size={14} strokeWidth={2} />
            </span>
