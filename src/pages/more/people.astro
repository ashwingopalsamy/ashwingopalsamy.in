---
import ComingSoon from "../../components/ComingSoon.astro";
import Page from "../../layouts/Page.astro";
import { ogPath } from "../../lib/og-url";

const description = "I am taking time with this list because the people on it deserve more than a row of names. It will arrive when every introduction has earned its place.";
---

<Page
  title="People"
  description={`${description} Coming soon.`}
  ogImage={ogPath("more/people")}
  ogImageAlt="People · Ashwin Gopalsamy"
  pagefind={false}
  robots="noindex,follow"
>
  <ComingSoon title="People" description={description} />
</Page>
