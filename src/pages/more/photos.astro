---
import ComingSoon from "../../components/ComingSoon.astro";
import Page from "../../layouts/Page.astro";
import { ogPath } from "../../lib/og-url";

const description = "I am editing this down to photographs that are worth another look. The quiet page is more honest until then.";
---

<Page
  title="Photos"
  description={`${description} Coming soon.`}
  ogImage={ogPath("more/photos")}
  ogImageAlt="Photos · Ashwin Gopalsamy"
  pagefind={false}
  robots="noindex,follow"
>
  <ComingSoon title="Photos" description={description} />
</Page>
