---
import { getCollection, render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { craftJsonLd } from "../../lib/jsonld";
import { ogPath } from "../../lib/og-url";
import { absUrl, slashPath } from "../../lib/urls";
import Icon from "../../components/Icon.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import RowTags from "../../components/RowTags.astro";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const entries = await getCollection("craft");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, description, tech, github, note } = entry.data;
const url = slashPath(`/work/${entry.data.slug}`);
---

<Page
  title={title}
  description={description}
  ogImage={ogPath(`work/${entry.data.slug}`)}
  ogImageAlt={title}
  jsonLd={craftJsonLd(entry, url)}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
>
  <article>
    <DetailHeader title={title} lede={description || note} back={{ href: "/work/", label: "Work" }}>
      <Fragment slot="meta">
        <time datetime={new Date(date).toISOString()}>{new Date(date).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}</time>
        <RowTags tags={tech} linked={new Set<string>()} label="Built with" />
      </Fragment>
      {github && (
        <Fragment slot="action">
          <a class="ui-cap ui-cap--glass ui-cap--32 ui-cap--trail" data-fx="spot" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
            <span class="ui-cap__label">GitHub</span>
            <span class="ui-arw ui-arw--ext">
              <Icon name="arrow-up-right" size={14} strokeWidth={2} />
              <Icon name="arrow-up-right" size={14} strokeWidth={2} />
            </span>
          </a>
        </Fragment>
      )}
    </DetailHeader>

    <div class="prose detail-body" data-enter>
      <Content />
    </div>
  </article>
</Page>

<style>
  .detail-body {
    max-width: 62ch;
  }
</style>
