---
import Page from "../layouts/Page.astro";
import { faqEntries, faqPageJsonLd } from "../data/faq";
import PageIntro from "../components/PageIntro.astro";
---

<Page
  title="FAQ"
  description="Frequently asked questions about Ashwin Gopalsamy, his engineering work, this site, and its read-only agent interfaces."
  jsonLd={faqPageJsonLd()}
>
  <PageIntro title="faq" lede="The questions that come up often enough to keep an answer here." />
  <div class="faq-layout" data-enter>
    <section class="faq-stream surface-stream" aria-label="Frequently asked questions">
      {
        faqEntries.map((entry) => (
          <article class="faq-row surface-row">
            <h2 class="faq-q">{entry.question}</h2>
            <p class="faq-a">{entry.answer}</p>
          </article>
        ))
      }
    </section>
  </div>
</Page>

<style>
  .faq-layout {
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .faq-stream {
    display: flex;
    flex-direction: column;
    gap: var(--step-1);
    margin-top: 0;
  }

  .faq-row {
    padding: var(--step-4) calc(var(--step) * 5);
    margin-inline: calc(var(--step) * -5);
    border-radius: var(--r-3);
    background: transparent;
    border: none;
    box-shadow: none;
    transition:
      background-color var(--t-color),
      opacity var(--dur-tint) var(--ease-enter),
      filter var(--dur-tint) var(--ease-enter);
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-row:hover {
      background: color-mix(in oklch, var(--ink) 3.5%, transparent);
    }

    .faq-row:hover .faq-a {
      color: color-mix(in oklch, var(--ink) 85%, var(--muted));
    }
  }

  .faq-q {
    margin: 0 0 var(--step-1);
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: var(--font-semibold);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  .faq-a {
    margin: 0;
    color: var(--ghost);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
    transition: color var(--t-color);
  }

  @media (max-width: 38rem) {
    .faq-row {
      padding: var(--step-3) var(--step-4);
      margin-inline: -1rem;
    }

    .faq-a {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
      -webkit-hyphens: auto;
      text-wrap: pretty;
    }
  }
</style>
