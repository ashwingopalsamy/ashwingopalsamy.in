---
import Page from "../layouts/Page.astro";
import { faqEntries, faqPageJsonLd } from "../data/faq";
import PageIntro from "../components/PageIntro.astro";
---

<Page
  title="FAQ"
  description="Frequently asked questions about Ashwin Gopalsamy, his engineering work, this site, and its read-only agent interfaces."
  jsonLd={faqPageJsonLd()}
>
  <PageIntro title="faq" lede="The questions that come up often enough to keep an answer here." />
  <div class="faq-layout" data-enter>
    {/* Static rows: reading content, so no puddle, no press, and no part in
         the sibling dim. Answers stay in the DOM for agents. */}
    <section class="faq-stream" aria-label="Frequently asked questions">
      {
        faqEntries.map((entry) => (
          <article class="ui-row ui-row--static ui-row--multiline faq-row">
            <div class="faq-body">
              <h2 class="faq-q">{entry.question}</h2>
              <p class="faq-a">{entry.answer}</p>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</Page>

<style>
  .faq-layout {
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .faq-stream {
    display: flex;
    flex-direction: column;
    gap: var(--step-2);
  }

  .faq-body {
    flex: 1;
    min-inline-size: 0;
  }

  .faq-q {
    margin: 0 0 var(--step-1);
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: var(--font-semibold);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  .faq-a {
    margin: 0;
    color: var(--ghost);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  @media (max-width: 38rem) {
    .faq-a {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
      -webkit-hyphens: auto;
      text-wrap: pretty;
    }
  }
</style>
