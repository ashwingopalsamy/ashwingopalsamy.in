---
import Page from "../layouts/Page.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import { CANONICAL_KNOWLEDGE } from "../data/canonical-knowledge";
import { profileLinks } from "../data/profile-links";
import { profileIconPaths } from "../lib/profile-icons";
import { ogPath } from "../lib/og-url";

const ogImage = ogPath("contact");
const { email, canonicalLinks } = CANONICAL_KNOWLEDGE;

// Name and handle come from the shared profile data; the href stays the
// canonical one so this page and knowledge.json can never disagree.
const profiles = (["github", "linkedin", "x", "scholar", "researchgate"] as const).flatMap((id) => {
  const link = profileLinks.find((item) => item.id === id);
  return link ? [{ id, name: link.platform, handle: link.handle, href: canonicalLinks[id] }] : [];
});
---

<Page
  title="Contact"
  description="Direct contact channels, calendar booking, response commitments, and security disclosure for Ashwin Gopalsamy."
  ogImage={ogImage}
  ogImageAlt="Contact · Ashwin Gopalsamy"
>
  <PageIntro title="contact" lede="The quickest ways to reach me." />

  <div class="page-prose" data-enter>
    <section class="contact-section">
      <h2 class="contact-h">Email</h2>
      <p class="contact-p">Email is best. I reply within two days.</p>
      <div class="contact-mail">
        <a class="ui-link contact-addr mono" href={canonicalLinks.email}>{email}</a>
        <button
          type="button"
          class="ui-cap ui-cap--glass ui-cap--32 ui-cap--lead"
          data-fx="spot"
          data-copy={email}
          data-state="idle"
          aria-label="Copy email address"
        >
          <span class="ui-stk ui-stk--icon">
            <span data-when="idle"><Icon name="copy" size={14} strokeWidth={2} /></span>
            <span data-when="done"><Icon name="check" size={14} strokeWidth={2} class="ui-draw" /></span>
            <span data-when="error"><Icon name="alert" size={14} strokeWidth={2} /></span>
          </span>
          <span class="ui-cap__label ui-stk">
            <span data-when="idle">Copy</span>
            <span data-when="done">Copied</span>
            <span data-when="error">Retry</span>
          </span>
        </button>
      </div>
    </section>

    <section class="contact-section">
      <h2 class="contact-h">Calls</h2>
      <p class="contact-p">
        Payment infrastructure, card networks, agent systems or a collaboration: pick a slot that suits you.
      </p>
      <a
        class="ui-cap ui-cap--glass ui-cap--48 ui-cap--trail"
        data-fx="spot"
        href={canonicalLinks.cal}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="ui-cap__label">Book a call</span>
        <span class="ui-arw ui-arw--ext">
          <Icon name="arrow-up-right" size={16} />
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
    </section>

    <section class="contact-section">
      <h2 class="contact-h">Elsewhere</h2>
      <ul class="contact-profiles surface-stack" role="list">
        {
          profiles.map((profile) => (
            <li>
              <a class="ui-row" data-fx="spot" href={profile.href} target="_blank" rel="noopener noreferrer">
                <svg class="contact-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                  <path d={profileIconPaths[profile.id]} />
                </svg>
                <span class="ui-row__title">{profile.name}</span>
                <span class="ui-row__meta contact-handle">{profile.handle}</span>
                <span class="ui-row__glyph ui-row__glyph--ext" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="contact-section">
      <h2 class="contact-h">Location and Time Zone</h2>
      <p class="contact-p">
        I am based in <span class="contact-k">Pollachi, Tamil Nadu</span> operating in the{" "}
        <span class="contact-k">IST (UTC+05:30)</span> timezone.
        For international discussions, I accommodate flexible scheduling across European and US time zones.
      </p>
    </section>

    <section class="contact-section">
      <h2 class="contact-h">Security and Vulnerability Disclosure</h2>
      <p class="contact-p">
        To report security vulnerabilities or technical issues regarding this website and its endpoints,
        refer to our RFC 9116 security disclosure guidelines at{" "}
        <a class="ui-link mono" href="/.well-known/security.txt">/.well-known/security.txt</a>.
      </p>
    </section>
  </div>
</Page>

<script>
  import "../scripts/clipboard";
</script>

<style>
  .contact-section {
    margin-bottom: 2rem;
  }

  .contact-h {
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--ink);
    margin: 2rem 0 0.75rem;
  }

  .contact-p {
    max-width: 100%;
    margin-bottom: var(--step-4);
    color: var(--ghost);
    line-height: var(--leading-relaxed);
    transition: color var(--t-color);
  }

  /* the address and its Copy capsule share a line, and wrap together */
  .contact-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2) var(--step-4);
  }

  .contact-addr {
    overflow-wrap: anywhere;
  }

  .contact-k {
    color: var(--ink);
  }

  .contact-profiles {
    max-width: 100%;
  }

  .contact-icon {
    flex: none;
    inline-size: calc(var(--step) * 5);
    block-size: calc(var(--step) * 5);
    color: var(--ghost);
    transition: color var(--t-color);
  }

  .contact-handle {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (hover: hover) and (pointer: fine) {
    .ui-row:hover > .contact-icon {
      color: var(--ink);
    }
  }

  .ui-row:focus-visible > .contact-icon {
    color: var(--ink);
  }

  .mono {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.9em;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-p:hover {
      color: color-mix(in oklch, var(--ink) 80%, var(--muted));
    }
  }

  @media (max-width: 38rem) {
    .contact-p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
      -webkit-hyphens: auto;
      text-wrap: pretty;
    }
  }
</style>
