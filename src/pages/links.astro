---
import Page from "../layouts/Page.astro";
import { ogPath } from "../lib/og-url";
import { profileLinks, profileLinkSections } from "../data/profile-links";
import { profileIconPaths } from "../lib/profile-icons";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";

/**
 * /links - every way to find me, in one place. Platform name leads as the
 * primary label; the handle trails quiet and muted. Whole row is the link.
 * Grouped into domain-based sections with SectionHeading.
 */

const sections = profileLinkSections.map((sec) => ({
  ...sec,
  links: profileLinks.filter((l) => l.category === sec.id),
}));

---

<Page title="Links" description="Every way to find Ashwin Gopalsamy (GitHub, LinkedIn, X, email, and the rest) in one place."
  ogImage={ogPath("links")}
  ogImageAlt="Links · Ashwin Gopalsamy"
>
  <PageIntro title="links" lede="Every way to find me, in one place." />

  <div class="links-sections" data-enter-batch>
    {
      sections.map((section) => (
        <section class="links-group" data-enter>
          <SectionHeading title={section.title} />
          <ul class="links-grid">
            {
              section.links.map((l) => (
                <li class="link-item">
                  <a
                    class="link-row"
                    href={l.href}
                    target={l.mail ? undefined : "_blank"}
                    rel={l.mail ? undefined : "me noopener noreferrer"}
                  >
                    <svg class="link-icon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="currentColor">
                      <path d={profileIconPaths[l.id]} />
                    </svg>
                    <span class="link-platform">{l.platform}</span>
                    <span class="link-handle">{l.handle}</span>
                    {!l.mail && (
                      <span class="link-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={14} /></span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .links-sections {
    display: flex;
    flex-direction: column;
    margin-top: 2.25rem;
  }

  .links-group {
    display: flex;
    flex-direction: column;
    margin-top: 0;
  }

  .links-group + .links-group {
    border-top: 1px solid var(--rule);
    padding-top: 2.25rem;
    margin-top: 2.25rem;
  }

  .links-group :global(.section-heading) {
    margin-bottom: 0.45rem;
  }

  .links-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.2rem 1.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .links-grid:hover .link-item {
      opacity: var(--dim-opacity);
      filter: blur(var(--dim-blur));
      transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
    }
    .links-grid:hover .link-item:hover,
    .links-grid:hover .link-item:focus-within {
      opacity: 1;
      filter: none;
    }
  }

  @media (max-width: 32rem) {
    .links-grid {
      grid-template-columns: 1fr;
    }
  }

  .link-item {
    min-width: 0;
    transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
  }

  .link-row {
    display: grid;
    grid-template-columns: 1.45rem auto minmax(0, 1fr) 1.25rem;
    min-height: 42px;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.45rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--r-3);
    background: transparent;
    border: none;
    box-shadow: none;
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--t-color),
      transform var(--dur-1) var(--ease-out);
  }

  .link-row:active {
    background: color-mix(in oklch, var(--ink) 6.5%, transparent);
    transform: scale(var(--press-scale-inline));
  }

  .link-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    color: var(--ghost);
    transition: color var(--t-color);
  }

  .link-platform {
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
    color: var(--ink);
    transition: color var(--t-color), font-weight var(--t-color);
  }

  .link-handle {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-xs);
    color: var(--ghost);
    transition: color var(--t-color);
  }

  .link-arrow {
    justify-self: end;
    color: var(--ghost);
    opacity: 0.6;
    transform: none;
    transition:
      opacity var(--t-color),
      transform var(--dur-shift) var(--ease-spring-pop),
      color var(--t-color);
  }

  @media (hover: hover) and (pointer: fine) {
    .link-row:hover,
    .link-row:focus-visible {
      background: color-mix(in oklch, var(--ink) 3.5%, transparent);
    }

    .link-row:hover .link-icon,
    .link-row:focus-visible .link-icon {
      color: var(--ink);
    }

    .link-row:hover .link-platform,
    .link-row:focus-visible .link-platform {
      font-weight: var(--font-hover-lift);
    }

    .link-row:hover .link-handle,
    .link-row:focus-visible .link-handle {
      color: color-mix(in oklch, var(--ink) 80%, var(--muted));
    }

    .link-row:hover .link-arrow,
    .link-row:focus-visible .link-arrow {
      opacity: 1;
      color: var(--ink);
      transform: translate3d(2px, -2px, 0);
    }
  }

  .link-row:focus-visible .link-platform {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 38rem) {
    .links-group + .links-group {
      padding-top: 1.85rem;
      margin-top: 1.85rem;
    }

    .link-row {
      grid-template-columns: 1.45rem minmax(0, 1fr) 1.25rem;
      gap: 0.15rem 0.75rem;
      border-radius: var(--r-3);
      padding: 0.5rem 0.75rem;
      min-height: 40px;
    }

    .link-platform,
    .link-handle {
      grid-column: 2;
    }

    .link-handle {
      grid-row: 2;
      line-height: 1.25;
    }

    .link-icon,
    .link-arrow {
      grid-row: 1 / span 2;
    }
  }
</style>
