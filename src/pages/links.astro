---
import Page from "../layouts/Page.astro";
import { ogPath } from "../lib/og-url";
import { profileLinks, profileLinkSections } from "../data/profile-links";
import { profileIconPaths } from "../lib/profile-icons";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";

/**
 * /links - every way to find me, in one place. Platform name leads as the
 * primary label; the handle sits quiet beneath it. Each row is a two-line
 * .ui-row with the brand mark leading and the external glyph trailing.
 * Grouped into domain-based sections with SectionHeading.
 */

const sections = profileLinkSections.map((sec) => ({
  ...sec,
  links: profileLinks.filter((l) => l.category === sec.id),
}));

---

<Page title="Links" description="Every way to find Ashwin Gopalsamy (GitHub, LinkedIn, X, email, and the rest) in one place."
  ogImage={ogPath("links")}
  ogImageAlt="Links · Ashwin Gopalsamy"
>
  <PageIntro title="links" lede="Every way to find me, in one place." />

  <div class="links-sections" data-enter-batch>
    {
      sections.map((section) => (
        <section class="links-group" data-enter>
          <SectionHeading title={section.title} />
          <ul class="links-grid surface-stack">
            {
              section.links.map((l) => (
                <li class="link-item">
                  <a
                    class="ui-row ui-row--multiline"
                    data-fx="spot"
                    href={l.href}
                    target={l.mail ? undefined : "_blank"}
                    rel={l.mail ? undefined : "me noopener noreferrer"}
                  >
                    <svg class="link-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                      <path d={profileIconPaths[l.id]} />
                    </svg>
                    <span class="ui-row__title link-text">
                      {l.platform}
                      <span class="ui-row__sub">{l.handle}</span>
                    </span>
                    <span class="ui-row__glyph ui-row__glyph--ext" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .links-sections {
    display: flex;
    flex-direction: column;
    margin-top: 2.25rem;
  }

  .links-group {
    display: flex;
    flex-direction: column;
    margin-top: 0;
  }

  .links-group + .links-group {
    border-top: 1px solid var(--rule);
    padding-top: 2.25rem;
    margin-top: 2.25rem;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--step-1) var(--step-5);
  }

  @media (max-width: 32rem) {
    .links-grid {
      grid-template-columns: 1fr;
    }
  }

  .link-item {
    min-inline-size: 0;
  }

  .link-icon {
    flex: none;
    inline-size: calc(var(--step) * 5);
    block-size: calc(var(--step) * 5);
    color: var(--ghost);
    transition: color var(--t-color);
  }

  .link-text {
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .ui-row:hover > .link-icon {
      color: var(--ink);
    }
  }

  .ui-row:focus-visible > .link-icon {
    color: var(--ink);
  }

  @media (max-width: 38rem) {
    .links-group + .links-group {
      padding-top: calc(var(--step) * 7);
      margin-top: calc(var(--step) * 7);
    }
  }
</style>
