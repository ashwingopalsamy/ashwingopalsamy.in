---
import Page from "../layouts/Page.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import { iconMarkup } from "../lib/ui-icons";
import { ogPath } from "../lib/og-url";

const ogImage = ogPath("developers");

// The copy circle's glyph cell (the markup contract is contact.astro's): a
// symbol and never a word. Copy, check and alert stack in one grid cell, so
// the circle keeps its size through all three.
const copyCells =
  '<span class="ui-stk ui-stk--icon">' +
  `<span data-when="idle">${iconMarkup("copy", { size: 14, strokeWidth: 2 })}</span>` +
  `<span data-when="done">${iconMarkup("check", { size: 14, strokeWidth: 2, className: "ui-draw" })}</span>` +
  `<span data-when="error">${iconMarkup("alert", { size: 14, strokeWidth: 2 })}</span>` +
  "</span>";

const sdks = [
  {
    id: "typescript",
    name: "TypeScript",
    ecosystem: "npm · TypeScript",
    package: "@ashwingopalsamy/sdk",
    install: "npm install @ashwingopalsamy/sdk",
    rawCode: `import { AshwinGopalsamyClient } from "@ashwingopalsamy/sdk";

const client = new AshwinGopalsamyClient();
const profile = await client.getProfile();
const results = await client.searchSite("rate limiters", 5);`,
    highlightedCode: `<span class="tok-kw">import</span> <span class="tok-punct">&#123;</span> <span class="tok-type">AshwinGopalsamyClient</span> <span class="tok-punct">&#125;</span> <span class="tok-kw">from</span> <span class="tok-str">"@ashwingopalsamy/sdk"</span><span class="tok-punct">;</span>

<span class="tok-kw">const</span> <span class="tok-text">client</span> <span class="tok-op">=</span> <span class="tok-kw">new</span> <span class="tok-type">AshwinGopalsamyClient</span><span class="tok-punct">()</span><span class="tok-punct">;</span>
<span class="tok-kw">const</span> <span class="tok-text">profile</span> <span class="tok-op">=</span> <span class="tok-kw">await</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">getProfile</span><span class="tok-punct">()</span><span class="tok-punct">;</span>
<span class="tok-kw">const</span> <span class="tok-text">results</span> <span class="tok-op">=</span> <span class="tok-kw">await</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">searchSite</span><span class="tok-punct">(</span><span class="tok-str">"rate limiters"</span><span class="tok-punct">,</span> <span class="tok-const">5</span><span class="tok-punct">)</span><span class="tok-punct">;</span>`,
  },
  {
    id: "python",
    name: "Python",
    ecosystem: "PyPI · Python",
    package: "ashwingopalsamy",
    install: "pip install ashwingopalsamy",
    rawCode: `from ashwingopalsamy import Client

client = Client()
profile = client.get_profile()
results = client.search_site("rate limiters", limit=5)`,
    highlightedCode: `<span class="tok-kw">from</span> <span class="tok-text">ashwingopalsamy</span> <span class="tok-kw">import</span> <span class="tok-type">Client</span>

<span class="tok-text">client</span> <span class="tok-op">=</span> <span class="tok-type">Client</span><span class="tok-punct">()</span>
<span class="tok-text">profile</span> <span class="tok-op">=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">get_profile</span><span class="tok-punct">()</span>
<span class="tok-text">results</span> <span class="tok-op">=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">search_site</span><span class="tok-punct">(</span><span class="tok-str">"rate limiters"</span><span class="tok-punct">,</span> <span class="tok-text">limit</span><span class="tok-op">=</span><span class="tok-const">5</span><span class="tok-punct">)</span>`,
  },
  {
    id: "go",
    name: "Go",
    ecosystem: "Go Modules · Go",
    package: "github.com/ashwingopalsamy/ashwingopalsamy.in/packages/go",
    install: "go get github.com/ashwingopalsamy/ashwingopalsamy.in/packages/go",
    rawCode: `import (
    "context"
    ashwingopalsamy "github.com/ashwingopalsamy/ashwingopalsamy.in/packages/go"
)

client := ashwingopalsamy.NewClient()
profile, err := client.GetProfile(ctx)
results, err := client.SearchSite(ctx, "rate limiters", 5)`,
    highlightedCode: `<span class="tok-kw">import</span> <span class="tok-punct">(</span>
    <span class="tok-str">"context"</span>
    <span class="tok-text">ashwingopalsamy</span> <span class="tok-str">"github.com/ashwingopalsamy/ashwingopalsamy.in/packages/go"</span>
<span class="tok-punct">)</span>

<span class="tok-text">client</span> <span class="tok-op">:=</span> <span class="tok-text">ashwingopalsamy</span><span class="tok-punct">.</span><span class="tok-func">NewClient</span><span class="tok-punct">()</span>
<span class="tok-text">profile</span><span class="tok-punct">,</span> <span class="tok-text">err</span> <span class="tok-op">:=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">GetProfile</span><span class="tok-punct">(</span><span class="tok-text">ctx</span><span class="tok-punct">)</span>
<span class="tok-text">results</span><span class="tok-punct">,</span> <span class="tok-text">err</span> <span class="tok-op">:=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">SearchSite</span><span class="tok-punct">(</span><span class="tok-text">ctx</span><span class="tok-punct">,</span> <span class="tok-str">"rate limiters"</span><span class="tok-punct">,</span> <span class="tok-const">5</span><span class="tok-punct">)</span>`,
  },
  {
    id: "ruby",
    name: "Ruby",
    ecosystem: "RubyGems · Ruby",
    package: "ashwingopalsamy",
    install: "gem install ashwingopalsamy",
    rawCode: `require "ashwingopalsamy"

client = AshwinGopalsamy::Client.new
profile = client.get_profile
results = client.search_site("rate limiters", limit: 5)`,
    highlightedCode: `<span class="tok-kw">require</span> <span class="tok-str">"ashwingopalsamy"</span>

<span class="tok-text">client</span> <span class="tok-op">=</span> <span class="tok-type">AshwinGopalsamy</span><span class="tok-punct">::</span><span class="tok-type">Client</span><span class="tok-punct">.</span><span class="tok-func">new</span>
<span class="tok-text">profile</span> <span class="tok-op">=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">get_profile</span>
<span class="tok-text">results</span> <span class="tok-op">=</span> <span class="tok-text">client</span><span class="tok-punct">.</span><span class="tok-func">search_site</span><span class="tok-punct">(</span><span class="tok-str">"rate limiters"</span><span class="tok-punct">,</span> <span class="tok-text">limit:</span> <span class="tok-const">5</span><span class="tok-punct">)</span>`,
  },
];

const cliTools = [
  {
    runtime: "NPX / Node.js",
    command: "npx ashwingopalsamy <command>",
    description: "Zero-install Node CLI for profile inspection, global search, and note retrieval.",
    rawSnippet: `npx ashwingopalsamy profile
npx ashwingopalsamy search "rate limiters"
npx ashwingopalsamy note designing-rate-limiters-for-payment-systems`,
    highlightedSnippet: `<span class="tok-kw">npx</span> <span class="tok-func">ashwingopalsamy</span> <span class="tok-type">profile</span>
<span class="tok-kw">npx</span> <span class="tok-func">ashwingopalsamy</span> <span class="tok-type">search</span> <span class="tok-str">"rate limiters"</span>
<span class="tok-kw">npx</span> <span class="tok-func">ashwingopalsamy</span> <span class="tok-type">note</span> <span class="tok-str">designing-rate-limiters-for-payment-systems</span>`,
  },
  {
    runtime: "Curl / POSIX Shell",
    command: "curl -sSL https://ashwingopalsamy.in/cli.sh | sh -s -- <command>",
    description: "Lightweight POSIX shell runner for Unix environments without Node installed.",
    rawSnippet: `curl -sSL https://ashwingopalsamy.in/cli.sh | sh -s -- profile
curl -sSL https://ashwingopalsamy.in/cli.sh | sh -s -- search "ISO 8583"`,
    highlightedSnippet: `<span class="tok-kw">curl</span> <span class="tok-const">-sSL</span> <span class="tok-str">https://ashwingopalsamy.in/cli.sh</span> <span class="tok-op">|</span> <span class="tok-kw">sh</span> <span class="tok-const">-s</span> <span class="tok-const">--</span> <span class="tok-type">profile</span>
<span class="tok-kw">curl</span> <span class="tok-const">-sSL</span> <span class="tok-str">https://ashwingopalsamy.in/cli.sh</span> <span class="tok-op">|</span> <span class="tok-kw">sh</span> <span class="tok-const">-s</span> <span class="tok-const">--</span> <span class="tok-type">search</span> <span class="tok-str">"ISO 8583"</span>`,
  },
];

const endpoints = [
  {
    method: "GET",
    path: "/api/v1/profile",
    description: "Authoritative career summary, current role, location, and verified profile facts.",
    example: "curl -s https://ashwingopalsamy.in/api/v1/profile",
  },
  {
    method: "GET",
    path: "/api/v1/search?query={q}&limit={n}",
    description: "Search technical notes, craft projects, and reading list entries.",
    example: "curl -s 'https://ashwingopalsamy.in/api/v1/search?query=rate+limiters&limit=3'",
  },
  {
    method: "GET",
    path: "/api/v1/content?kind={kind}&limit={n}",
    description: "List public entries by kind (note, craft, book, watch, or all).",
    example: "curl -s 'https://ashwingopalsamy.in/api/v1/content?kind=note&limit=5'",
  },
  {
    method: "GET",
    path: "/api/v1/notes/{slug}",
    description: "Retrieve raw Markdown content and metadata for a published note.",
    example: "curl -s https://ashwingopalsamy.in/api/v1/notes/designing-rate-limiters-for-payment-systems",
  },
  {
    method: "GET",
    path: "/api/v1/status",
    description: "API operational status, versioning policy, and capability catalog.",
    example: "curl -s https://ashwingopalsamy.in/api/v1/status",
  },
];

const protocols = [
  {
    name: "Model Context Protocol (MCP)",
    path: "/mcp",
    spec: "Streamable HTTP · JSON-RPC 2.0",
    description: "Production MCP endpoint offering native tool execution (search_site, get_profile, list_content, get_note_markdown), resources, and prompt templates for autonomous AI agents.",
    testCommand: "npx -y @modelcontextprotocol/inspector https://ashwingopalsamy.in/mcp",
    highlightedTest: `<span class="tok-kw">npx</span> <span class="tok-const">-y</span> <span class="tok-func">@modelcontextprotocol/inspector</span> <span class="tok-str">https://ashwingopalsamy.in/mcp</span>`,
  },
  {
    name: "Agent-to-Agent (A2A)",
    path: "/a2a",
    spec: "JSON-RPC 2.0 Task Routing",
    description: "Direct agent message exchange protocol for task delegation, profile extraction, and capability handoff.",
    testCommand: `curl -s -X POST https://ashwingopalsamy.in/a2a -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"parts":[{"kind":"text","text":"profile"}]}}}'`,
    highlightedTest: `<span class="tok-kw">curl</span> <span class="tok-const">-s -X POST</span> <span class="tok-str">https://ashwingopalsamy.in/a2a</span> <span class="tok-const">-H</span> <span class="tok-str">'Content-Type: application/json'</span> <span class="tok-const">-d</span> <span class="tok-str">'{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"parts":[{"kind":"text","text":"profile"}]}}}'</span>`,
  },
  {
    name: "OpenAPI Specification",
    path: "/openapi.json",
    spec: "OpenAPI 3.1.0",
    description: "Complete machine-readable REST API schema defining strongly typed parameters, request contracts, and response schemas.",
    testCommand: "curl -s https://ashwingopalsamy.in/openapi.json",
    highlightedTest: `<span class="tok-kw">curl</span> <span class="tok-const">-s</span> <span class="tok-str">https://ashwingopalsamy.in/openapi.json</span>`,
  },
  {
    name: "Web Bot Auth Directory (RFC 9421)",
    path: "/.well-known/http-message-signatures-directory",
    spec: "RFC 9421 · Ed25519 JWK",
    description: "Cryptographic public signature keys directory for verifying authentic bot identities and mitigating spoofing.",
    testCommand: "curl -s https://ashwingopalsamy.in/.well-known/http-message-signatures-directory",
    highlightedTest: `<span class="tok-kw">curl</span> <span class="tok-const">-s</span> <span class="tok-str">https://ashwingopalsamy.in/.well-known/http-message-signatures-directory</span>`,
  },
];

const responseHeaders = [
  { header: "API-Version", tag: "2026-08-22", desc: "Contract release timestamp defining endpoint behavior." },
];

const discoveryGroups = [
  {
    title: "Developer APIs & Specifications",
    items: [
      { path: "/openapi.json", desc: "OpenAPI 3.1.0 complete REST API specification." },
      { path: "/developers.md", desc: "Developer integration guide in plain Markdown format." },
      { path: "/auth.md", desc: "Authentication notes: public interfaces require none." },
    ],
  },
  {
    title: "AI & Agent Discovery",
    items: [
      { path: "/mcp", desc: "Model Context Protocol endpoint (Streamable HTTP · JSON-RPC 2.0)." },
      { path: "/mcp/catalog.json", desc: "Catalog of registered MCP tools, resources, and prompt templates." },
      { path: "/.well-known/mcp/server-card.json", desc: "MCP Server Card metadata for automatic client configuration." },
      { path: "/a2a", desc: "Agent-to-Agent communication endpoint for task delegation." },
      { path: "/.well-known/agents.md", desc: "System prompt instructions and capabilities for autonomous agents." },
      { path: "/.well-known/ai-catalog.json", desc: "Agent Resource Directory (ARD) index of accessible surfaces." },
    ],
  },
  {
    title: "LLM Context & Machine Catalogs",
    items: [
      { path: "/llms.txt", desc: "Concise profile and content summary for language models." },
      { path: "/llms-full.txt", desc: "Complete context bundle covering all technical notes and craft history." },
      { path: "/knowledge.json", desc: "JSON-LD graph dump of all verified biographical and career facts." },
      { path: "/cli.sh", desc: "Official zero-dependency POSIX shell command-line interface." },
      { path: "/.well-known/http-message-signatures-directory", desc: "RFC 9421 HTTP Message Signatures Ed25519 public key directory." },
    ],
  },
];

const rawErrorPayload = `{
  "type": "https://ashwingopalsamy.in/developers#errors",
  "title": "Resource Not Found",
  "status": 404,
  "detail": "Note slug 'non-existent' was not found in published index.",
  "code": "note_not_found",
  "resolution_hint": "Check /api/v1/content?kind=note for a complete list of valid note slugs."
}`;

const highlightedErrorPayload = `<span class="tok-punct">&#123;</span>
  <span class="tok-func">"type"</span><span class="tok-punct">:</span> <span class="tok-str">"https://ashwingopalsamy.in/developers#errors"</span><span class="tok-punct">,</span>
  <span class="tok-func">"title"</span><span class="tok-punct">:</span> <span class="tok-str">"Resource Not Found"</span><span class="tok-punct">,</span>
  <span class="tok-func">"status"</span><span class="tok-punct">:</span> <span class="tok-const">404</span><span class="tok-punct">,</span>
  <span class="tok-func">"detail"</span><span class="tok-punct">:</span> <span class="tok-str">"Note slug 'non-existent' was not found in published index."</span><span class="tok-punct">,</span>
  <span class="tok-func">"code"</span><span class="tok-punct">:</span> <span class="tok-str">"note_not_found"</span><span class="tok-punct">,</span>
  <span class="tok-func">"resolution_hint"</span><span class="tok-punct">:</span> <span class="tok-str">"Check /api/v1/content?kind=note for a complete list of valid note slugs."</span>
<span class="tok-punct">&#125;</span>`;

const developersJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebAPI",
    name: "Ashwin Gopalsamy Developer API & SDKs",
    description: "Official developer API, OpenAPI 3.1.0 specification, Model Context Protocol (MCP) server, and multi-language SDKs for Ashwin Gopalsamy's site.",
    url: "https://ashwingopalsamy.in/developers",
    documentation: "https://ashwingopalsamy.in/developers",
    provider: {
      "@type": "Person",
      "@id": "https://ashwingopalsamy.in/#person",
      name: "Ashwin Gopalsamy",
    },
    termsOfService: "https://ashwingopalsamy.in/privacy",
  },
];
---

<Page
  title="Ashwin Gopalsamy · Developer Resources, API Documentation & SDKs"
  description="Official developer API, OpenAPI 3.1.0 specification, Model Context Protocol server, multi-language SDKs (npm, PyPI, Go, RubyGems), and CLI tool for Ashwin Gopalsamy's site."
  ogImage={ogImage}
  ogImageAlt="Ashwin Gopalsamy · Developer Resources, API Documentation and SDKs"
  jsonLd={developersJsonLd}
>
  <PageIntro
    title="developers"
    lede="An OpenAPI spec, an MCP server and four SDKs. Every read endpoint is open: no key, no rate penalty."
  />

  <div class="dev-layout" data-enter>
    <div class="quick-cta-row">
      <a
        class="ui-cap ui-cap--ink ui-cap--48 ui-cap--trail"
        data-fx="magnet"
        href="/openapi.json"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="ui-cap__label">OpenAPI</span>
        <span class="ui-arw ui-arw--ext">
          <Icon name="arrow-up-right" size={16} />
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
      <a class="ui-cap ui-cap--glass ui-cap--48 ui-cap--trail" href="/ai/">
        <span class="ui-cap__label">Agents</span>
        <span class="ui-arw">
          <Icon name="arrow-right" size={16} />
          <Icon name="arrow-right" size={16} />
        </span>
      </a>
      <a class="ui-cap ui-cap--glass ui-cap--48 ui-cap--trail" href="/design/">
        <span class="ui-cap__label">Design</span>
        <span class="ui-arw">
          <Icon name="arrow-right" size={16} />
          <Icon name="arrow-right" size={16} />
        </span>
      </a>
    </div>

    <hr class="page-rule" data-enter />

    <!-- Official Multi-Language SDKs -->
    <section class="dev-section" aria-label="Official Multi-Language SDKs">
      <div class="section-heading-split">
        <h2 class="section-heading">SDKs</h2>
      </div>

      <div class="sdk-stream" data-sdk-widget>
        <div class="ui-card code-card">
          <div class="code-head">
            <div class="ui-seg ui-seg--sm ui-seg--bare">
              <div class="ui-seg__track" role="tablist" aria-label="Language">
                <span class="ui-seg__ind" aria-hidden="true"></span>
                {
                  sdks.map((sdk, idx) => (
                    <button
                      type="button"
                      role="tab"
                      class="ui-seg__item"
                      id={`tab-${sdk.id}`}
                      data-value={sdk.id}
                      data-tab-target={sdk.id}
                      aria-selected={idx === 0 ? "true" : "false"}
                      aria-controls={`panel-${sdk.id}`}
                      tabindex={idx === 0 ? 0 : -1}
                    >
                      <span class="ui-cap__label">{sdk.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          {
            sdks.map((sdk, idx) => (
              <div
                id={`panel-${sdk.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${sdk.id}`}
                class="sdk-body-panel"
                hidden={idx !== 0}
                data-ecosystem={sdk.ecosystem}
              >
                <button
                  type="button"
                  class="inst"
                  data-copy={sdk.install}
                  data-state="idle"
                  aria-label={`Copy ${sdk.name} install command`}
                >
                  <span class="prompt-glyph" aria-hidden="true">$</span>
                  <code class="install-text mono">{sdk.install}</code>
                  <span
                    class="ui-cap ui-cap--glass ui-cap--32 ui-cap--icon"
                    data-state="idle"
                    aria-hidden="true"
                    set:html={copyCells}
                  />
                </button>

                <div class="code-view">
                  <pre><code class="mono" set:html={sdk.highlightedCode} /></pre>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="page-rule" data-enter />

    <!-- Official CLI Tool -->
    <section class="dev-section" aria-label="Official CLI Tool">
      <h2 class="section-heading">CLI</h2>
      <p class="editorial-p p-grey">
        Inspect profile facts, technical notes, and search index directly from your terminal:
      </p>

      <div class="cli-stream">
        {
          cliTools.map((cli) => (
            <div class="cli-block">
              <div class="cli-header-row">
                <span class="ui-badge">{cli.runtime}</span>
                <span class="cli-desc p-grey">{cli.description}</span>
              </div>
              <div class="ui-card code-card">
                <div class="code-view code-view--copy">
                  <pre><code class="mono" set:html={cli.highlightedSnippet} /></pre>
                  <button
                    type="button"
                    class="ui-cap ui-cap--glass ui-cap--32 ui-cap--icon code-copy"
                    data-copy={cli.rawSnippet}
                    data-state="idle"
                    aria-label={`Copy ${cli.runtime} commands`}
                    set:html={copyCells}
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="page-rule" data-enter />

    <!-- REST v1 Endpoints -->
    <section class="dev-section" aria-label="REST v1 Endpoints">
      <div class="section-heading-split">
        <h2 class="section-heading">Endpoints</h2>
      </div>

      <ul class="endpoint-stream" role="list">
        {
          endpoints.map((ep) => (
            <li class="ui-row ui-row--static endpoint-row">
              <div class="endpoint-main">
                <div class="endpoint-badge-path">
                  <span class="ui-badge ui-badge--mono">{ep.method}</span>
                  <span class="endpoint-route mono">{ep.path}</span>
                </div>
                <p class="endpoint-summary">{ep.description}</p>
              </div>
              <button
                type="button"
                class="ui-cap ui-cap--glass ui-cap--32 ui-cap--icon"
                data-copy={ep.example}
                data-state="idle"
                aria-label={`Copy curl command for ${ep.path}`}
                set:html={copyCells}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="page-rule" data-enter />

    <!-- Protocol Interfaces -->
    <section class="dev-section" aria-label="Protocol Interfaces">
      <h2 class="section-heading">Protocols</h2>
      <ul class="proto-stream" role="list">
        {
          protocols.map((proto) => (
            <li class="ui-row ui-row--static proto-row">
              <div class="proto-header">
                <div class="proto-title-group">
                  <h3 class="proto-title">{proto.name}</h3>
                  <a class="ui-link mono proto-path" href={proto.path}>{proto.path}</a>
                </div>
                <span class="ui-badge">{proto.spec}</span>
              </div>
              <p class="proto-desc">{proto.description}</p>
              <div class="cmd-bar">
                <code class="cmd-code mono" set:html={proto.highlightedTest} />
                <button
                  type="button"
                  class="ui-cap ui-cap--glass ui-cap--32 ui-cap--icon"
                  data-copy={proto.testCommand}
                  data-state="idle"
                  aria-label={`Copy command for ${proto.name}`}
                  set:html={copyCells}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="page-rule" data-enter />

    <!-- Response Headers -->
    <section class="dev-section" aria-label="Response Headers">
      <h2 class="section-heading">Headers</h2>
      <p class="editorial-p p-grey">
        API responses carry a version header:
      </p>
      <div class="spec-stream">
        {
          responseHeaders.map((item) => (
            <div class="ui-row ui-row--static spec-row-item">
              <div class="spec-label-group">
                <span class="spec-name mono">{item.header}</span>
                <span class="ui-badge ui-badge--mono">{item.tag}</span>
              </div>
              <span class="spec-desc">{item.desc}</span>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="page-rule" data-enter />

    <!-- API Versioning & Errors -->
    <section class="dev-section" id="errors" aria-label="Versioning & Error Model">
      <h2 class="section-heading">Errors&nbsp;<span class="ui-badge ui-badge--mono">RFC 9457</span></h2>
      <p class="editorial-p p-grey">
        Explicit path versioning (<code>/api/v1</code>) paired with RFC 9457 Problem Details for typed error responses:
      </p>
      <div class="ui-card code-card">
        <div class="code-view code-view--copy">
          <pre><code class="mono" set:html={highlightedErrorPayload} /></pre>
          <button
            type="button"
            class="ui-cap ui-cap--glass ui-cap--32 ui-cap--icon code-copy"
            data-copy={rawErrorPayload}
            data-state="idle"
            aria-label="Copy error JSON example"
            set:html={copyCells}
          />
        </div>
      </div>
    </section>

    <hr class="page-rule" data-enter />

    <!-- Machine Discovery Index -->
    <section class="dev-section" aria-label="Machine Discovery Index">
      <h2 class="section-heading">Discovery</h2>
      <div class="discovery-groups">
        {
          discoveryGroups.map((group) => (
