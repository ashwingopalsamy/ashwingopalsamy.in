</Page>

<script>
  import "../scripts/clipboard";
  import { playAccent } from "../scripts/sound";
  import { pageSignal } from "../scripts/lifecycle";
  import { initSegmented } from "../scripts/segmented";

  let initializedSignal: AbortSignal | undefined;

  function initDeveloperPage() {
    const widget = document.querySelector<HTMLElement>("[data-sdk-widget]");
    if (!widget) return;
    const signal = pageSignal();
    if (initializedSignal === signal) return;
    initializedSignal = signal;

    // SDK tabs: segmented.ts owns selection, roving focus and the panels
    // (aria-controls). Each panel holds its own install row, so its Copy
    // follows the open tab with no script.
    const [tabs] = initSegmented(widget, { signal });
    tabs?.element.addEventListener("seg:change", () => playAccent("tab"), { signal });
  }

  initDeveloperPage();
  document.addEventListener("astro:page-load", initDeveloperPage);
</script>

