---
import Page from "../../../layouts/Page.astro";
import { collectionPageJsonLd } from "../../../lib/jsonld";
import { getTagBuckets, tagHref, tagPageDescription, type TagBucket } from "../../../lib/tags";
import { ogPath } from "../../../lib/og-url";
import { absUrl } from "../../../lib/urls";
import Icon from "../../../components/Icon.astro";
import PageIntro from "../../../components/PageIntro.astro";

const buckets: TagBucket[] = await getTagBuckets();
const description =
  "Topics with enough notes and library entries to browse: Go, payments, distributed systems, and related engineering tags.";

const jsonLd = collectionPageJsonLd({
  url: "/library/tags",
  name: "Library tags",
  description,
  items: buckets.map((b) => ({
    url: tagHref(b.tag),
    name: `#${b.tag}`,
  })),
});
---

<Page
  title="Tags"
  description={description}
  ogImage={ogPath("library/tags")}
  ogImageAlt="Library tags · Ashwin Gopalsamy"
  jsonLd={jsonLd}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
>
  <PageIntro title="tags" lede="Topics that appear often enough to browse across the library." />

  <ul class="surface-stack" data-enter>
    {buckets.map((b) => (
      <li>
        <a class="ui-row ui-row--multiline" data-fx="spot" href={tagHref(b.tag)}>
          <span class="ui-row__title">
            #{b.tag}
            <span class="ui-row__sub">{tagPageDescription(b.tag, b.count)}</span>
          </span>
          <span class="ui-row__meta tag-count">{b.count}</span>
          <span class="ui-row__glyph" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
        </a>
      </li>
    ))}
  </ul>
</Page>

<style>
  /* the count shares the title's first baseline: 15px title, 13px meta */
  .tag-count {
    margin-block-start: calc(var(--step) / 2);
  }
</style>
