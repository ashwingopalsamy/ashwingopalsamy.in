---
import Page from "../../../layouts/Page.astro";
import {
  getTagBuckets,
  tagHref,
  tagPageDescription,
  type TagBucket,
} from "../../../lib/tags";
import { collectionPageJsonLd } from "../../../lib/jsonld";
import { ogPath } from "../../../lib/og-url";
import { absUrl, slashPath } from "../../../lib/urls";

export async function getStaticPaths() {
  const buckets = await getTagBuckets();
  return buckets.map((bucket) => ({
    params: { tag: bucket.tag },
    props: { bucket },
  }));
}

const { bucket } = Astro.props as { bucket: TagBucket };
const description = tagPageDescription(bucket.tag, bucket.count);
const notes = [...bucket.notes].sort((a, b) => b.date.getTime() - a.date.getTime());

const jsonLd = collectionPageJsonLd({
  url: tagHref(bucket.tag),
  name: `#${bucket.tag}`,
  description,
  items: notes.map((n) => ({
    url: slashPath(`/blog/${n.id}`),
    name: n.title,
  })),
});

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<Page
  title={`#${bucket.tag}`}
  description={description}
  ogImage={ogPath(`library/tags/${bucket.tag}`)}
  ogImageAlt={`#${bucket.tag} · Ashwin Gopalsamy`}
  jsonLd={jsonLd}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
>
  <header class="tag-header" data-enter>
    <h1 class="tag-title">#{bucket.tag}</h1>
    {description && <p class="tag-lede">{description}</p>}
    <div class="tag-meta-bar">
      <span class="tag-count-badge mono">{bucket.count} {bucket.count === 1 ? "entry" : "entries"}</span>
    </div>
  </header>

  <ul class="note-list" data-enter>
    {notes.map((n) => (
      <li class="note-row">
        <a class="note-link" href={slashPath(`/blog/${n.id}`)}>
          <span class="note-title">{n.title}</span>
          <time class="note-date mono" datetime={n.date.toISOString()}>{fmt(n.date)}</time>
        </a>
      </li>
    ))}
  </ul>
</Page>

<style>
  .tag-header {
    display: grid;
    max-inline-size: 65ch;
    gap: clamp(1rem, 2.5vw, 1.25rem);
    margin-bottom: clamp(1.25rem, 3vw, 1.5rem);
  }

  .tag-title,
  .tag-lede {
    margin: 0;
  }

  .tag-title {
    max-inline-size: 22ch;
    font-size: clamp(1.85rem, 4.5vw, 2.5rem);
    font-weight: 640;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .tag-lede {
    max-inline-size: 56ch;
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .tag-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .tag-count-badge {
    font-size: 0.8rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .note-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 100%;
  }
  @media (hover: hover) and (pointer: fine) {
    .note-list:hover .note-link {
      opacity: 0.45;
      filter: blur(0.2px);
      transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
    }
    .note-list:hover .note-link:hover,
    .note-list:hover .note-link:focus-visible {
      opacity: 1;
      filter: none;
    }
  }
  .note-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--r-3);
    background: transparent;
    border: none;
    box-shadow: none;
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color var(--t-color),
      opacity var(--dur-2) var(--ease),
      filter var(--dur-2) var(--ease),
      transform var(--dur-1) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .note-link:hover,
    .note-link:focus-visible {
      background: color-mix(in oklch, var(--ink) 3.5%, transparent);
    }
    .note-link:hover .note-date,
    .note-link:focus-visible .note-date {
      color: var(--muted);
    }
  }
  .note-link:active {
    background: color-mix(in oklch, var(--ink) 6.5%, transparent);
    transform: scale(0.995);
  }
  .note-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
  }
  .note-date {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--t-color);
  }
  .mono {
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
  }

  @media (max-width: 38rem) {
    .note-link {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem 1rem;
    }
  }
</style>
