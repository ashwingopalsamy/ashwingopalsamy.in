---
import Page from "../../../layouts/Page.astro";
import {
  getTagBuckets,
  tagHref,
  tagPageDescription,
  type TagBucket,
} from "../../../lib/tags";
import { collectionPageJsonLd } from "../../../lib/jsonld";
import { ogPath } from "../../../lib/og-url";
import { absUrl, slashPath } from "../../../lib/urls";
import Icon from "../../../components/Icon.astro";

export async function getStaticPaths() {
  const buckets = await getTagBuckets();
  return buckets.map((bucket) => ({
    params: { tag: bucket.tag },
    props: { bucket },
  }));
}

const { bucket } = Astro.props as { bucket: TagBucket };
const description = tagPageDescription(bucket.tag, bucket.count);
const notes = [...bucket.notes].sort((a, b) => b.date.getTime() - a.date.getTime());

const jsonLd = collectionPageJsonLd({
  url: tagHref(bucket.tag),
  name: `#${bucket.tag}`,
  description,
  items: notes.map((n) => ({
    url: slashPath(`/blog/${n.id}`),
    name: n.title,
  })),
});

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<Page
  title={`#${bucket.tag}`}
  description={description}
  ogImage={ogPath(`library/tags/${bucket.tag}`)}
  ogImageAlt={`#${bucket.tag} · Ashwin Gopalsamy`}
  jsonLd={jsonLd}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
>
  <header class="tag-header" data-enter>
    <h1 class="tag-title"><Icon name="hash" size={14} strokeWidth={2} class="ui-chip__hash ui-chip__hash--inline" />{bucket.tag}</h1>
    {description && <p class="tag-lede">{description}</p>}
    <div class="tag-meta-bar">
      <span class="ui-badge">{bucket.count} {bucket.count === 1 ? "entry" : "entries"}</span>
    </div>
  </header>

  <ul class="surface-stack" data-enter>
    {notes.map((n) => (
      <li>
        <a class="ui-row" data-fx="spot" href={slashPath(`/blog/${n.id}`)}>
          <span class="ui-row__title">{n.title}</span>
          <time class="ui-row__meta" datetime={n.date.toISOString()}>{fmt(n.date)}</time>
          <span class="ui-row__glyph" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
        </a>
      </li>
    ))}
  </ul>
</Page>

<style>
  .tag-header {
    display: grid;
    max-inline-size: 65ch;
    gap: clamp(1rem, 2.5vw, 1.25rem);
    margin-bottom: clamp(1.25rem, 3vw, 1.5rem);
  }

  .tag-title,
  .tag-lede {
    margin: 0;
  }

  .tag-title {
    max-inline-size: 22ch;
    font-size: var(--type-detail-title-size);
    font-weight: 640;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  /* the title's own symbol: it scales with the title (14px would read as a
     subscript at this size), stays ghost, and sits on the x-height */
  .tag-title :global(.ui-chip__hash--inline) {
    inline-size: 0.6em;
    block-size: 0.6em;
    vertical-align: 0.04em;
  }

  .tag-lede {
    max-inline-size: 56ch;
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .tag-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
</style>
