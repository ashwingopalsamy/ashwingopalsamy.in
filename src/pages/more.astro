---
import Page from "../layouts/Page.astro";
import { ogPath } from "../lib/og-url";
import { moreDestinations } from "../data/more";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import { getPhotoEntries } from "../data/photos";

const photos = await getPhotoEntries();
const hasPublishedPhotos = photos.some(({ data }) => !data.draft);
const destinations = moreDestinations.map((destination) =>
  destination.id === "photos" && hasPublishedPhotos
    ? { ...destination, status: "live" as const }
    : destination,
);
---

<Page title="More" description="Beyond the homepage: library, photos, cafes, people, and other corners Ashwin Gopalsamy keeps tending."
  ogImage={ogPath("more")}
  ogImageAlt="More · Ashwin Gopalsamy"
>
  <PageIntro title="more" lede="The parts that don't fit anywhere else." />
  <div class="bento" data-enter-batch>
    {destinations.map((destination) => {
      const soon = destination.status === "coming-soon";
      const Tile = soon ? "div" : "a";
      const classes = ["ui-tile", destination.className, soon ? "ui-tile--soon" : ""].filter(Boolean).join(" ");
      return (
        <Tile
          class={classes}
          data-enter
          data-status={destination.status}
          data-fx={soon ? undefined : "spot"}
          data-more-tile={soon ? undefined : ""}
          href={soon ? undefined : destination.href}
          aria-disabled={soon ? "true" : undefined}
        >
          <span class="ui-tile__title">{destination.title}</span>
          <span class="ui-tile__desc">{destination.description}</span>
          {soon ? (
            <span class="visually-hidden">Coming soon.</span>
          ) : (
            <span class="ui-tile__corner">
              <span class="ui-tile__go" aria-hidden="true">
                <span class="ui-arw">
                  <Icon name="arrow-right" size={14} strokeWidth={2} />
                  <Icon name="arrow-right" size={14} strokeWidth={2} />
                </span>
              </span>
            </span>
          )}
          <div class="ui-tile__art" aria-hidden="true">
            {destination.id === "library" ? (
              <div class="spines">
                <span class="spine"></span>
                <span class="spine"></span>
                <span class="spine"></span>
                <span class="spine"></span>
                <span class="spine"></span>
              </div>
            ) : destination.id === "photos" ? (
              <div class="frames">
                <span class="frame"></span>
                <span class="frame"></span>
                <span class="frame"></span>
              </div>
            ) : destination.id === "ai" ? (
              <div class="code-glyph"><span class="brace">&#123;</span><span class="caret"></span><span class="brace">&#125;</span></div>
            ) : destination.id === "cafe" ? (
              <svg class="cup-svg" width="40" height="42" viewBox="0 0 40 42">
                <path class="steam" d="M15,13 C15,10 18,10 18,7 C18,4 15,4 15,1"></path>
                <path class="steam s2" d="M23,13 C23,10 26,10 26,7 C26,4 23,4 23,1"></path>
                <path class="cup" d="M8,17 h21 v9 a8,8 0 0 1 -8,8 h-5 a8,8 0 0 1 -8,-8 z"></path>
                <path class="cup" d="M29,19 h3.5 a4,4 0 0 1 0,8 h-3.5"></path>
                <path class="cup" d="M7,39 h25"></path>
              </svg>
            ) : destination.id === "people" ? (
              <div class="avatars"><span class="avatar large"></span><span class="avatar small"></span><span class="avatar medium"></span></div>
            ) : (
              <div class="placeholder-mark"><span></span><span></span><span></span></div>
            )}
          </div>
        </Tile>
      );
    })}
  </div>
</Page>


<script>
  import { onPageCleanup, pageSignal } from "../scripts/lifecycle";
  import { tokenMs } from "../scripts/toast";

  /* Touch has no hover, so a live tile plays its illustration once, the
     first time it is mostly in view (data-play flips --tile-play to running). */
  function playTilesOnce() {
    const signal = pageSignal();
    if (signal.aborted || !matchMedia("(hover: none)").matches) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const tiles = document.querySelectorAll<HTMLElement>("[data-more-tile]:not([data-watching])");
    if (!tiles.length) return;

    const hold = tokenMs("--dur-drift", 4200);
    const timers = new Set<number>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const tile = entry.target as HTMLElement;
        observer.unobserve(tile);
        tile.dataset.play = "";
        timers.add(window.setTimeout(() => delete tile.dataset.play, hold));
      }
    }, { threshold: 0.6 });

    tiles.forEach((tile) => {
      tile.dataset.watching = "";
      observer.observe(tile);
    });
    onPageCleanup(() => {
      observer.disconnect();
      timers.forEach((timer) => window.clearTimeout(timer));
    }, signal);
  }

  playTilesOnce();
  document.addEventListener("astro:page-load", playTilesOnce);
</script>

<style>
  /* The tile itself is the .ui-tile primitive (controls.css): glass surface,
     corner slot, spotlight, --tile-play. This sheet only places tiles on
     the bento grid and draws the illustrations. */
  .bento {
    position: relative;
    z-index: var(--z-base);
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--step-4);
    margin: 1.5rem 0 3rem;
  }

  /* bento shape - library tall, photos + people wide */
  .t-library { grid-column: 1; grid-row: 1 / span 2; }
  .t-photos { grid-column: 2 / span 2; grid-row: 1; }
  .t-ai { grid-column: 2; grid-row: 2; }
  .t-cafe { grid-column: 3; grid-row: 2; }
  .t-someday { grid-column: 1; grid-row: 3; }
  .t-people { grid-column: 2 / span 2; grid-row: 3; }

  .ui-tile__desc {
    overflow-wrap: anywhere;
  }

  /* ---- illustrations: drawn in the art slot's colour (ghost at rest,
     muted on hover, dim on a soon tile), so none carries its own ---- */

  .spines { display: flex; flex-direction: column; gap: var(--step-1); inline-size: 100%; }
  .spine {
    block-size: var(--step-2);
    border-radius: var(--r-pill);
    background: currentColor;
    opacity: 0.85;
    transform-origin: left;
  }
  .spine:nth-child(1) { inline-size: 70%; }
  .spine:nth-child(2) { inline-size: 95%; }
  .spine:nth-child(3) { inline-size: 55%; }
  .spine:nth-child(4) { inline-size: 82%; }
  .spine:nth-child(5) { inline-size: 65%; }

  .frames { position: relative; inline-size: 100%; block-size: calc(var(--step) * 14); }
  .frame {
    position: absolute;
    inline-size: calc(var(--step) * 10);
    block-size: calc(var(--step) * 13);
    border: calc(var(--step) / 2) solid currentColor;
    border-radius: var(--r-pill);
    background: color-mix(in oklch, currentColor 8%, transparent);
    transform: rotate(var(--rotation-start));
  }
  .frame:nth-child(1) { inset-inline-start: 0; inset-block-start: calc(var(--step) * 1.5); --rotation-start: -6deg; --rotation-end: -9deg; }
  .frame:nth-child(2) { inset-inline-start: calc(var(--step) * 7.5); inset-block-start: 0; --rotation-start: 3deg; --rotation-end: 6deg; }
  .frame:nth-child(3) { inset-inline-start: calc(var(--step) * 15); inset-block-start: calc(var(--step) * 2); --rotation-start: -2deg; --rotation-end: 1deg; }

  .code-glyph {
    display: flex;
    align-items: center;
    gap: var(--step-1);
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1;
  }
  .caret {
    inline-size: var(--step-2);
    block-size: calc(var(--step) * 5);
    border-radius: var(--r-pill);
    background: currentColor;
  }

  .cup-svg { overflow: visible; }
  .cup,
  .steam {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cup { stroke-width: 2; }
  .steam { stroke-width: 1.6; opacity: 0.7; }

  .placeholder-mark {
    display: flex;
    gap: var(--step-2);
  }
  .placeholder-mark span {
    inline-size: var(--dot-5);
    block-size: var(--dot-5);
    border-radius: 50%;
    background: currentColor;
  }

  .avatars { display: flex; align-items: flex-end; }
  .avatar { border: calc(var(--step) / 2) solid currentColor; border-radius: 50%; background: var(--canvas); margin-inline-start: calc(var(--step-2) * -1); }
  .avatar:first-child { margin-inline-start: 0; }
  .avatar.large { inline-size: calc(var(--step) * 7); block-size: calc(var(--step) * 7); }
  .avatar.medium { inline-size: calc(var(--step) * 6); block-size: calc(var(--step) * 6); }
  .avatar.small { inline-size: calc(var(--step) * 5); block-size: calc(var(--step) * 5); }

  /* --phase offsets each loop so neighbours drift out of step. The loops
     read --tile-play: they run while the tile is hovered or focused (or
     carries data-play on touch) and hold their pose otherwise. */
  .spine { animation: spine-bob var(--dur-pulse) var(--ease-sway) var(--phase, 0s) infinite; }
  .spine:nth-child(2) { --phase: -0.5s; }
  .spine:nth-child(3) { --phase: -1s; }
  .spine:nth-child(4) { --phase: -1.5s; }
  .spine:nth-child(5) { --phase: -2s; }
  @keyframes spine-bob { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(var(--travel-nudge)); } }

  .frame { animation: frame-drift var(--dur-drift) var(--ease-sway) var(--phase, 0s) infinite; }
  .frame:nth-child(2) { --phase: -1.4s; }
  .frame:nth-child(3) { --phase: -2.8s; }
  @keyframes frame-drift { 0%, 100% { transform: rotate(var(--rotation-start)); } 50% { transform: rotate(var(--rotation-end)); } }

  .caret { animation: blink var(--dur-blink) steps(1) infinite; }
  @keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  /* both wisps start mid-rise, so a held pose still shows steam */
  .steam { --phase: -0.8s; animation: rise var(--dur-rise) var(--ease-sway) var(--phase) infinite; }
  .steam.s2 { --phase: -2s; }
  @keyframes rise { 0% { opacity: 0; } 30% { opacity: 0.9; } 100% { opacity: 0; } }

  .placeholder-mark span { animation: breathe var(--dur-breathe) var(--ease-sway) var(--phase, 0s) infinite; }
  .placeholder-mark span:nth-child(2) { --phase: -0.3s; }
  .placeholder-mark span:nth-child(3) { --phase: -0.6s; }
  @keyframes breathe { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .avatar { animation: avatar-bob var(--dur-bob) var(--ease-sway) var(--phase, 0s) infinite; }
  .avatar:nth-child(2) { --phase: -1.1s; }
  .avatar:nth-child(3) { --phase: -2.2s; }
  @keyframes avatar-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(calc(var(--travel-nudge) * -1)); } }

  .spine,
  .frame,
  .caret,
  .steam,
  .placeholder-mark span,
  .avatar {
    animation-play-state: var(--tile-play, paused);
  }

  /* mobile - 2 columns, spans reset */
  @media (max-width: 34rem) {
    .bento { grid-template-columns: 1fr 1fr; gap: var(--step-3); }
    .t-library, .t-photos, .t-ai, .t-cafe, .t-someday, .t-people {
      grid-column: auto;
      grid-row: auto;
    }
    .t-library, .t-people { grid-column: span 2; }
    .ui-tile {
      min-block-size: calc(var(--step) * 31);
      padding: var(--step-4);
    }
    /* a half-width tile leaves the corner arrow 4px of air at 18px; 17px
       leaves room, and a file name must never hyphenate or justify into rivers */
    .ui-tile__title {
      font-size: var(--text-md);
    }
    .ui-tile__desc {
      hyphens: manual;
      text-wrap: pretty;
    }
  }

  /* below this a half-width tile cannot hold a title and its arrow */
  @media (max-width: 23rem) {
    .bento { grid-template-columns: 1fr; }
    .t-library, .t-people { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spine,
    .frame,
    .caret,
    .steam,
    .placeholder-mark span,
    .avatar {
      animation: none;
    }
  }
</style>
