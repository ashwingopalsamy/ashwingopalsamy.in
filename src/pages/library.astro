---
import { getCollection } from "astro:content";
import LibraryRows from "../components/LibraryRows.astro";
import LibraryShelf from "../components/LibraryShelf.astro";
import PageIntro from "../components/PageIntro.astro";
import Page from "../layouts/Page.astro";
import { articleHostname, articleSource, bookHref, noteHref, watchHref } from "../lib/library";
import {
  filterLibraryCatalogItems,
  isLibraryView,
  libraryLabels,
  libraryShelves,
  normalizeLibraryCatalogItem,
  sortLibraryCatalogItems,
  type LibraryCatalogItem,
} from "../lib/library-list";
import { libraryCollectionPageJsonLd } from "../lib/jsonld";
import { ogPath } from "../lib/og-url";
import { linkedTagSet } from "../lib/tags";
import { absUrl } from "../lib/urls";

const [allBooks, allWatch, allNotes, allArticles] = await Promise.all([
  getCollection("books"), getCollection("watch"), getCollection("notes"), getCollection("articles"),
]);
const isProd = import.meta.env.PROD;
const notes = isProd ? allNotes.filter((entry) => !entry.data.draft) : allNotes;
const byDateDesc = <T extends { data: { date: Date } }>(items: T[]) =>
  [...items].sort((left, right) => right.data.date.getTime() - left.data.date.getTime());

const sortedBooks = byDateDesc(allBooks);
const sortedWatch = byDateDesc(allWatch);
const sortedNotes = byDateDesc(notes);
const sortedArticles = byDateDesc(allArticles);
const catalogItems: LibraryCatalogItem[] = sortLibraryCatalogItems([
  ...sortedBooks.map((entry) => normalizeLibraryCatalogItem({
    kind: "books", title: entry.data.title, date: entry.data.date, author: entry.data.author,
    status: entry.data.status, rating: entry.data.rating, href: bookHref(entry) ?? null, tags: entry.data.tags,
  })),
  ...sortedWatch.map((entry) => normalizeLibraryCatalogItem({
    kind: "watch", title: entry.data.title, date: entry.data.date, platform: entry.data.platform,
    status: entry.data.status, rating: entry.data.rating, href: watchHref(entry) ?? null, tags: entry.data.tags,
  })),
  ...sortedNotes.map((entry) => normalizeLibraryCatalogItem({
    kind: "notes", title: entry.data.title, date: entry.data.date, description: entry.data.description,
    href: noteHref(entry), tags: entry.data.tags,
  })),
  ...sortedArticles.map((entry) => normalizeLibraryCatalogItem({
    kind: "articles", title: entry.data.title, date: entry.data.date, source: articleSource(entry),
    hostname: articleHostname(entry.data.url), href: entry.data.url, tags: entry.data.tags,
  })),
]);
const shelves = libraryShelves(catalogItems);
const itemsByKind = Object.fromEntries(
  shelves.map((shelf) => [shelf.kind, filterLibraryCatalogItems(catalogItems, shelf.kind)]),
) as Record<LibraryCatalogItem["kind"], LibraryCatalogItem[]>;
// "All" counts what the library holds, not the rows the overview shows.
const libraryTotal = shelves.reduce((total, shelf) => total + shelf.total, 0);
const requestedView = Astro.url.searchParams.get("view");
const initialView = isLibraryView(requestedView) ? requestedView : "all";
const tabs = [
  { id: "all", label: "All", count: libraryTotal },
  ...shelves.map((shelf) => ({ id: shelf.kind, label: libraryLabels[shelf.kind], count: shelf.total })),
] as const;
const linkedTags = await linkedTagSet();
const collectionPage = libraryCollectionPageJsonLd([
  ...sortedBooks.map((entry) => ({ url: bookHref(entry) ? absUrl(bookHref(entry)!) : absUrl("/library/"), name: entry.data.title })),
  ...sortedWatch.map((entry) => ({ url: watchHref(entry) ? absUrl(watchHref(entry)!) : absUrl("/library/"), name: entry.data.title })),
  ...sortedNotes.map((entry) => ({ url: absUrl(noteHref(entry)), name: entry.data.title })),
  ...sortedArticles.map((entry) => ({ url: entry.data.url, name: entry.data.title })),
]);
---

<Page
  title="Library"
  description="Writings, books, bookmarks, and things watched that Ashwin Gopalsamy keeps returning to."
  bodyClass="library"
  ogImage={ogPath("library")}
  ogImageAlt="Library · Ashwin Gopalsamy"
  jsonLd={collectionPage}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
>
  <PageIntro title="library" lede="Things I keep close, newest first." />
  <div class="library-tabs" data-library>
    <span class="library-sentinel" aria-hidden="true"></span>
    <div class="library-veil" aria-hidden="true"></div>
    <div class="ui-seg library-seg">
      <div class="ui-seg__track" role="tablist" aria-label="Library sections">
        <span class="ui-seg__ind" aria-hidden="true"></span>
        {tabs.map((tab) => (
          <button
            type="button"
            class="ui-seg__item"
            role="tab"
            id={`library-tab-${tab.id}`}
            data-value={tab.id}
            aria-selected={tab.id === initialView ? "true" : "false"}
            aria-controls={`library-panel-${tab.id}`}
            tabindex={tab.id === initialView ? 0 : -1}
          >
            <span class="ui-cap__label">{tab.label}{" "}<span class="ui-count">{tab.count}</span></span>
          </button>
        ))}
      </div>
    </div>

    <div class="library-panels">
      <section id="library-panel-all" class="library-panel" role="tabpanel" aria-labelledby="library-tab-all" hidden={initialView !== "all"}>
        {shelves.map((shelf) => <LibraryShelf shelf={shelf} linkedTags={linkedTags} />)}
      </section>
      {shelves.map((shelf) => (
        <section
          id={`library-panel-${shelf.kind}`}
          class="library-panel"
          role="tabpanel"
          aria-labelledby={`library-tab-${shelf.kind}`}
          tabindex="-1"
          hidden={initialView !== shelf.kind}
        >
          <h2 class="visually-hidden">{libraryLabels[shelf.kind]}</h2>
          <LibraryRows items={itemsByKind[shelf.kind]} linkedTags={linkedTags} />
        </section>
      ))}
    </div>
    {/* Before first paint: the page is static, so ?view= is applied here, not at build. */}
    <script is:inline data-astro-rerun>
      (() => {
        const view = new URLSearchParams(location.search).get("view");
        if (!["notes", "books", "articles", "watch"].includes(view ?? "")) return;
        const root = document.querySelector("[data-library]");
        root?.querySelectorAll("[role=tab]").forEach((tab) => {
          const on = tab.getAttribute("data-value") === view;
          tab.setAttribute("aria-selected", String(on));
          tab.tabIndex = on ? 0 : -1;
        });
        root?.querySelectorAll("[role=tabpanel]").forEach((panel) => {
          panel.hidden = panel.id !== "library-panel-" + view;
        });
      })();
    </script>
  </div>
</Page>

<script>
  import { isLibraryView } from "../lib/library-list";
  import { onPageCleanup, pageSignal } from "../scripts/lifecycle";
  import { initSegmented } from "../scripts/segmented";
  import { playAccent } from "../scripts/sound";

  // the breakpoint the tabs dock from (the sticky rule below)
  const WIDE = "(min-width: 42.5rem)";

  function enhanceLibrary() {
    const root = document.querySelector<HTMLElement>("[data-library]");
    if (!root || root.dataset.enhanced === "true") return;
    const signal = pageSignal();
    const [tabs] = initSegmented(root, { signal });
    if (!tabs) return;
    root.dataset.enhanced = "true";
    const seg = tabs.element;
    const sentinel = root.querySelector<HTMLElement>(".library-sentinel");
    const wide = matchMedia(WIDE);
    let above = false;
    let focusFrame = 0;

    const replaceView = (view: string) => {
      const url = new URL(location.href);
      if (view === "all") url.searchParams.delete("view");
      else url.searchParams.set("view", view);
      history.replaceState(history.state, "", `${url.pathname}${url.search}${url.hash}`);
    };

    /* A switch made below the tabs starts the new panel right under them,
       not wherever the old panel happened to be scrolled. The line is the
       sticky offset where the tabs dock, and the header zone on phones,
       where nothing docks. */
    const dock = () => {
      const sticky = parseFloat(getComputedStyle(seg).top);
      const line = Number.isFinite(sticky)
        ? sticky
        : parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const top = root.getBoundingClientRect().top;
      if (top < line) window.scrollTo({ top: window.scrollY + top - line, behavior: "instant" });
    };

    const syncLocation = () => {
      const requested = new URL(location.href).searchParams.get("view");
      if (requested && !isLibraryView(requested)) replaceView("all");
      tabs.select(isLibraryView(requested) ? requested : "all");
    };

    seg.addEventListener("seg:change", (event) => {
      playAccent("tab");
      replaceView(event.detail.value);
      dock();
    }, { signal });

    // the shelves' "All N" capsules hand over to their tab
    root.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("[data-library-show-all]");
      if (!link) return;
      const view = link.dataset.libraryView ?? new URL(link.href, location.href).searchParams.get("view");
      if (!isLibraryView(view)) return;
      event.preventDefault();
      tabs.select(view, { emit: true });
      cancelAnimationFrame(focusFrame);
      focusFrame = requestAnimationFrame(() => {
        if (!signal.aborted) document.getElementById(`library-panel-${view}`)?.focus({ preventScroll: true });
      });
    }, { signal });

    window.addEventListener("popstate", syncLocation, { signal });

    /* Chrome glass only while docked. The sentinel sits one dock offset
       above the tabs, so it leaves the viewport exactly when they stick:
       no scroll listener, no per-frame reads. */
    if (sentinel) {
      const setStuck = () => {
        const stuck = wide.matches && above;
        if (seg.hasAttribute("data-stuck") !== stuck) seg.toggleAttribute("data-stuck", stuck);
      };
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[entries.length - 1];
        above = !entry.isIntersecting && entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0);
        setStuck();
      });
      observer.observe(sentinel);
      wide.addEventListener("change", setStuck, { signal });
      onPageCleanup(() => observer.disconnect(), signal);
    }

    onPageCleanup(() => {
      cancelAnimationFrame(focusFrame);
      delete root.dataset.enhanced;
    }, signal);
    syncLocation();
  }

  enhanceLibrary();
  document.addEventListener("astro:page-load", enhanceLibrary);
</script>

<style>
  .library-tabs {
    /* 16px under the header chips, as on the board */
    --library-dock: calc(var(--header-zone) + var(--step-1));
    position: relative;
  }

  /* zero-height, one dock offset above the tabs (see the script) */
  .library-sentinel {
    position: absolute;
    inset-block-start: calc(var(--library-dock) * -1);
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 0;
    pointer-events: none;
  }

  /* The rim and padding hang outside the rail, so the first segment's ink
     sits on it. */
  .library-seg {
    display: flex;
    inline-size: fit-content;
    margin-inline-start: calc(var(--track-inset) * -1);
  }

  /* The count shares the label's line so the two meet on one baseline;
     centred as separate flex items, the mono digits ride high. The space
     keeps the tab's name "All 56"; this margin tops it up to the 8px gap. */
  .library-seg .ui-count {
    margin-inline-start: var(--step-1);
  }

  .library-panels {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .library-panel {
    margin-top: 0;
  }

  .library-veil {
    display: none;
  }

  /* Docked under the header. The glass turns to chrome (blur and all) only
     while stuck: segmented's data-stuck, set by the sentinel above. */
  @media (min-width: 42.5rem) {
    .library-seg {
      position: sticky;
      inset-block-start: var(--library-dock);
      z-index: var(--z-raised);
    }

    /* Docked, the tabs are chrome too, so the header's veil carries on
       under them: the same recipe at the same constant radius, fixed,
       below the tabs and above the rows, on only while they are stuck. Its
       top fades in where the header's veil fades out. The header's own
       veil cannot reach this far: it sits in the header's layer, above
       the tabs, and would blur them. */
    .library-veil {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: var(--z-veil);
      display: block;
      block-size: calc(var(--library-dock) + var(--cap-48) + var(--step-6));
      background: linear-gradient(
        180deg,
        color-mix(in oklch, var(--canvas) 78%, transparent),
        color-mix(in oklch, var(--canvas) 0%, transparent)
      );
      -webkit-backdrop-filter: blur(calc(var(--step) * 2.5));
      backdrop-filter: blur(calc(var(--step) * 2.5));
      -webkit-mask-image: linear-gradient(180deg, transparent calc(var(--header-zone) * 0.62), black var(--header-zone), black 62%, transparent);
      mask-image: linear-gradient(180deg, transparent calc(var(--header-zone) * 0.62), black var(--header-zone), black 62%, transparent);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity var(--dur-shift) var(--ease-enter),
        visibility 0s linear var(--dur-shift);
    }

    .library-tabs:has(> .library-seg[data-stuck]) > .library-veil {
      visibility: visible;
      opacity: 1;
      transition:
        opacity var(--dur-shift) var(--ease-enter),
        visibility 0s;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .library-veil {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media print, (forced-colors: active) {
    .library-veil {
      display: none;
    }
  }
</style>
