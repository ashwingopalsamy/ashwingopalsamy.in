---
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import fontStyles from "../styles/fonts.css?inline";
// geometry first (global.css consumes --step-*/--r-*), motion last so its
// retuned duration and easing tokens win over the legacy values.
import "../styles/geometry.css";
import "../styles/global.css";
import "../styles/motion.css";
import { site } from "../data/home";
import { buildMeta } from "../lib/build";
import { organizationJsonLd, personJsonLd } from "../lib/jsonld";
import { stringifyJsonLd } from "../lib/jsonld-safe";
import { CANVAS_DARK, CANVAS_LIGHT } from "../lib/theme";
import { OG_HEIGHT, OG_WIDTH } from "../lib/og";
import { coreMarkdownMirrorPath } from "../lib/urls";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  /** visible page heading ("{label}"). Optional; omit for pages that
      carry their own on-page title (e.g. article detail routes, homepage). */
  label?: string;
  bodyClass?: string;
  /** Optional page-specific JSON-LD node(s), emitted after the Person node.
      Pages pass ProfilePage/Article/etc. and reference the Person by @id. */
  jsonLd?: object | object[];
  /** Absolute URL to a 1200x630 card. Defaults to the generated /og.png. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  /** RSS/JSON Feed autodiscovery links, emitted in <head>. */
  alternateFeeds?: { href: string; title: string; type: string }[];
  /** Optional alternate representations (e.g. text/markdown). */
  alternates?: { href: string; type: string; title?: string }[];
  /** Dimensions/type for a custom Open Graph image; defaults match the generated site card. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  /** robots meta. Default indexes; pass "noindex" (etc.) for utility/error pages. */
  robots?: string;
  /** Exclude the whole page from the Pagefind index (stubs, 404). */
  pagefind?: boolean;
  /** Article times for ogType=article notes. */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = site.title,
  description = site.description,
  label,
  bodyClass,
  jsonLd,
  ogImage = `${site.url}/og.png`,
  ogImageAlt = `${site.name} · builds the infrastructure behind global payments`,
  ogImageWidth = OG_WIDTH,
  ogImageHeight = OG_HEIGHT,
  ogImageType = "image/png",
  ogType = "website",
  alternateFeeds,
  alternates,
  robots = "index,follow,max-image-preview:large,max-snippet:-1",
  pagefind = true,
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const explicitMarkdownAlternate = alternates?.find((alt) => alt.type === "text/markdown");
const generatedMarkdownMirror = coreMarkdownMirrorPath(Astro.url.pathname);
const markdownAlternate = explicitMarkdownAlternate ?? (generatedMarkdownMirror
  ? { href: generatedMarkdownMirror, type: "text/markdown", title: "Markdown version" }
  : undefined);
const otherAlternates = alternates?.filter((alt) => alt.type !== "text/markdown");
const structuredData = [personJsonLd(), organizationJsonLd()];
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const documentTitle = isHome
  ? `${site.name} · Staff Software Engineer, Payments Infrastructure`
  : title === site.title || title.includes(site.name)
    ? title
    : `${title} · ${site.name}`;
---

<!doctype html>
<html
  lang="en"
  data-build-at={buildMeta.builtAt}
  data-build-commit={buildMeta.commit ?? undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Font faces ship first, before any route stylesheet. -->
    <style is:inline set:html={fontStyles} />

    <!-- Each viewport preloads only the face it sets body text in. -->
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      media="(min-width: 38.0625rem)"
      crossorigin
    />
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      media="(max-width: 38rem)"
      crossorigin
    />
    <script
      is:inline
      set:html={`(function () {
        if (window.__siteThemeController) {
          window.__siteThemeController.sync(document);
          return;
        }
        var CANVAS_DARK = ${JSON.stringify(CANVAS_DARK)};
        var CANVAS_LIGHT = ${JSON.stringify(CANVAS_LIGHT)};
        var colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
        var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        function storedTheme() {
          try {
            var t = localStorage.getItem("theme");
            return t === "light" || t === "dark" ? t : null;
          } catch (e) {}
          return null;
        }
        function canvas(theme) {
          return theme === "dark" ? CANVAS_DARK : CANVAS_LIGHT;
        }
        var stored = storedTheme();
        var current = stored || (colorScheme.matches ? "dark" : "light");
        var explicitTheme = stored !== null;
        function apply(theme, persist, target) {
          target = target || document;
          if (persist) {
            explicitTheme = true;
            try { localStorage.setItem("theme", theme); } catch (e) {}
          }
          current = theme;
          var root = target.documentElement;
          if (root.dataset.theme !== theme) root.dataset.theme = theme;
          if (reducedMotion.matches) {
            if (root.hasAttribute("data-motion")) delete root.dataset.motion;
          } else if (root.dataset.motion !== "on") {
            root.dataset.motion = "on";
          }
          var tc = target.querySelector('meta[name="theme-color"]:not([media])');
          if (!tc) {
            tc = target.createElement("meta");
            tc.setAttribute("name", "theme-color");
            target.head.appendChild(tc);
          }
          if (tc.getAttribute("content") !== canvas(theme)) tc.setAttribute("content", canvas(theme));
          target.querySelectorAll(".theme-toggle").forEach(function (button) {
            var pressed = String(theme === "dark");
            if (button.getAttribute("aria-pressed") !== pressed) button.setAttribute("aria-pressed", pressed);
          });
        }
        function introHasAnimated() {
          if (window.__siteIntroAnimated || document.documentElement.dataset.introAnimated === "true") return true;
          try { return sessionStorage.getItem("intro-animated") === "true"; } catch (e) {}
          return false;
        }
        function sync(target) {
          target = target || document;
          apply(current, false, target);
          if (target !== document && introHasAnimated()) target.documentElement.dataset.introAnimated = "true";
        }

        window.__siteThemeController = {
          current: function () { return current; },
          canvas: canvas,
          apply: apply,
          sync: sync
        };
        sync(document);
        try {
          if (sessionStorage.getItem("intro-animated") === "true") document.documentElement.dataset.introAnimated = "true";
        } catch (e) {}
        // A prerendered page (speculation rules) may be activated long after it
        // was built; hold its CSS animations until someone is looking.
        if (document.prerendering) {
          document.documentElement.dataset.prerendering = "";
          document.addEventListener("prerenderingchange", function () {
            delete document.documentElement.dataset.prerendering;
          }, { once: true });
        }
        // Route direction for the cross-document view transition: motion.css
        // reverses the axis for history traversals back. pagereveal fires
        // before the first frame, so it has to be registered in the head.
        window.addEventListener("pagereveal", function (event) {
          if (!event.viewTransition) return;
          var activation = window.navigation && window.navigation.activation;
          var back = Boolean(activation && activation.navigationType === "traverse" &&
            activation.from && activation.entry && activation.entry.index < activation.from.index);
          var root = document.documentElement;
          root.dataset.routeDir = back ? "back" : "forward";
          // The logo swaps between the home mark and the back arrow only when
          // one side of the navigation is the home page.
          var fromPath = null;
          try { fromPath = activation && activation.from && activation.from.url ? new URL(activation.from.url).pathname : null; } catch (e) {}
          if (fromPath !== null && (fromPath === "/") !== (location.pathname === "/")) root.dataset.logoSwap = "";
          else delete root.dataset.logoSwap;
        });
        // Without cross-document view transitions (Firefox today) an internal
        // navigation still arrives with the same gesture: opacity and travel
        // on the content, settled two frames after the DOM is parsed.
        if (!("CSSViewTransitionRule" in window) && document.documentElement.dataset.motion === "on") {
          var internal = false;
          try { internal = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin; } catch (e) {}
          var navEntry = performance.getEntriesByType ? performance.getEntriesByType("navigation")[0] : null;
          if (internal && (!navEntry || navEntry.type !== "reload")) {
            var root = document.documentElement;
            root.dataset.routeFallback = "entering";
            if (navEntry && navEntry.type === "back_forward") root.dataset.routeDir = "back";
            var settle = function () {
              requestAnimationFrame(function () {
                requestAnimationFrame(function () { root.dataset.routeFallback = "idle"; });
              });
            };
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", settle, { once: true });
            else settle();
          }
        }
        colorScheme.addEventListener("change", function (event) {
          if (!explicitTheme) apply(event.matches ? "dark" : "light", false, document);
        });
        reducedMotion.addEventListener("change", function () { sync(document); });
        // A page restored from the back/forward cache missed any theme change
        // made on the pages after it (storage events are not replayed).
        window.addEventListener("pageshow", function (event) {
          if (!event.persisted) return;
          var restored = storedTheme();
          explicitTheme = restored !== null;
          apply(restored || (colorScheme.matches ? "dark" : "light"), false, document);
        });
        window.addEventListener("storage", function (event) {
          if (event.key !== "theme" && event.key !== null) return;
          var next = event.key === "theme" ? event.newValue : storedTheme();
          explicitTheme = next === "light" || next === "dark";
          apply(explicitTheme ? next : (colorScheme.matches ? "dark" : "light"), false, document);
        });
      })();`}
    />

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogType === "article" && <meta property="article:author" content={site.name} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ashwin2125" />
    <meta name="twitter:creator" content="@ashwin2125" />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={stringifyJsonLd(structuredData)} />
    {Array.isArray(jsonLd)
      ? jsonLd.map((node) => (
          <script type="application/ld+json" is:inline set:html={stringifyJsonLd(node)} />
        ))
      : jsonLd && <script type="application/ld+json" is:inline set:html={stringifyJsonLd(jsonLd)} />}

    {alternateFeeds?.map((feed) => (
      <link
        rel="alternate"
        type={feed.type}
        title={feed.title}
        href={feed.href.startsWith("http") ? feed.href : new URL(feed.href, site.url).href}
      />
    ))}
    {markdownAlternate && (
        <link
          rel="alternate"
          type={markdownAlternate.type}
          title={markdownAlternate.title}
          href={markdownAlternate.href.startsWith("http") ? markdownAlternate.href : new URL(markdownAlternate.href, site.url).href}
          data-astro-prefetch="false"
        />
    )}
    {otherAlternates?.map((alt) =>
        <link
          rel="alternate"
          type={alt.type}
          title={alt.title}
          href={alt.href.startsWith("http") ? alt.href : new URL(alt.href, site.url).href}
        />
    )}

    <link rel="author" href="/humans.txt" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={CANVAS_LIGHT} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={CANVAS_DARK} media="(prefers-color-scheme: dark)" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="site-chrome" data-pagefind-ignore>
      <div class="column column-header">
        <SiteHeader />
      </div>
      <CommandPalette />
    </div>
    <div class:list={["column", "column-body", bodyClass]}>
      <main
        id="main"
        data-route-content
        data-pagefind-body={pagefind ? "" : undefined}
        data-pagefind-ignore={pagefind ? undefined : "true"}
      >
        {label && <h1 class="page-label">{label}</h1>}
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="viewport-frame" aria-hidden="true"></div>

    <script>
      import { onPageCleanup, pageSignal } from "../scripts/lifecycle";
      import "../scripts/navigation-shell";
      import "../scripts/navigation-prefetch";
      import "../scripts/floating-toc";
      import "../scripts/grid-overlay";

      /* Nothing below affects the first interaction: the devtools console
         art, the telemetry queue, the web-vitals observers and the WebMCP
         bridge are all observers.
         Keeping them in the critical entry chunk meant the browser parsed
         and ran them before the page could respond to anything. They now
         load once the main thread is actually free. */
      const whenIdle: (fn: () => void) => unknown =
        typeof window.requestIdleCallback === "function"
          ? (fn) => window.requestIdleCallback(fn, { timeout: 2000 })
          : (fn) => setTimeout(fn, 200);

      whenIdle(() => {
        void import("../scripts/console").then((m) => m.initConsole()).catch(() => undefined);
        void import("../scripts/telemetry").then((m) => m.initTelemetry()).catch(() => undefined);
        void import("../scripts/vitals").then((m) => m.initVitals()).catch(() => undefined);
        const supportsWebMcp = [document, navigator, window].some(
          (host) => "modelContext" in host && Boolean(host.modelContext),
        );
        if (supportsWebMcp) {
          void import("../scripts/webmcp").then((m) => m.initWebMcp()).catch(() => undefined);
        }
      });

      declare global {
        interface Window {
          __siteIntroAnimated?: boolean;
        }
      }

      let enhancedPage: AbortSignal | null = null;

      function enhance() {
        const signal = pageSignal();
        if (enhancedPage === signal) return;
        enhancedPage = signal;
        const isHomePage = Boolean(document.querySelector(".column-body.home"));
        if (isHomePage) {
          window.__siteIntroAnimated = true;
          try {
            sessionStorage.setItem("intro-animated", "true");
          } catch (e) {}
        }

        const items = document.querySelectorAll<HTMLElement>("[data-enter]:not(.entered)");
        // Entrances belong to the first page of a visit, not to every
        // navigation inside it: skip them when this document was reached from
        // another page of the site or from history.
        const navEntry = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
        let internal = false;
        try {
          internal = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
        } catch {}
        const firstOfVisit = navEntry?.type === "reload" || (navEntry?.type !== "back_forward" && !internal);
        if (!firstOfVisit) {
          items.forEach((el) => el.classList.add("entered"));
          return;
        }
        const motionOn = document.documentElement.dataset.motion === "on";
        // Cap the stagger so a long list never turns into a queue.
        const REVEAL_ORDER_CAP = isHomePage ? 5 : 2;

        if (!motionOn || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("entered"));
          return;
        }

        // Read phase FIRST (before mutating styles/classes to prevent forced reflow)
        //
        // Every page now uses the viewport test. Non-home pages used to
        // treat only the first element as above the fold and hand the rest
        // to the observer, so content that was already on screen at first
        // paint still started at opacity 0 and waited for an observer
        // callback plus its stagger before appearing. On a page like /more,
        // where the whole grid is visible immediately, that is the entire
        // page arriving late for no reason.
        const viewportCutoff = window.innerHeight * 0.92;
        const aboveFold: HTMLElement[] = [];
        const toObserve: HTMLElement[] = [];

        items.forEach((el) => {
          if (el.getBoundingClientRect().top < viewportCutoff) {
            aboveFold.push(el);
          } else {
            toObserve.push(el);
          }
        });

        // Above-fold content renders immediately with 0 render delay
        aboveFold.forEach((el) => el.classList.add("entered"));

        // Below-fold content gets initial-enter and reveals when scrolled in
        toObserve.forEach((el) => el.classList.add("initial-enter"));

        function reveal(el: HTMLElement, order: number) {
          if (
            el.classList.contains("revealing") ||
            el.classList.contains("entered")
          )
            return;
          el.style.setProperty(
            "--reveal-order",
            String(Math.min(order, REVEAL_ORDER_CAP))
          );
          let settled = false;
          const settle = () => {
            if (settled) return;
            settled = true;
            el.removeEventListener("animationend", onAnimationDone);
            el.removeEventListener("animationcancel", onAnimationDone);
            el.classList.remove("revealing");
            el.classList.add("entered");
            el.style.willChange = "auto";
          };
          const onAnimationDone = (event: AnimationEvent) => {
            if (event.target !== el) return;
            settle();
          };
          el.addEventListener("animationend", onAnimationDone);
          el.addEventListener("animationcancel", onAnimationDone);
          onPageCleanup(() => {
            el.removeEventListener("animationend", onAnimationDone);
            el.removeEventListener("animationcancel", onAnimationDone);
          }, signal);
          el.classList.add("revealing");
        }

        if (toObserve.length) {
          const io = new IntersectionObserver(
            (entries, obs) => {
              let order = 0;
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                reveal(el, order++);
                obs.unobserve(el);
              });
            },
            { rootMargin: "0px", threshold: 0 }
          );
          toObserve.forEach((el) => io.observe(el));
          onPageCleanup(() => io.disconnect(), signal);
        }
      }

      enhance();

      const chord = (e: KeyboardEvent) =>
        e.altKey && e.shiftKey && (e.key === "v" || e.key === "V");
      document.addEventListener("keydown", (e) => {
        if (chord(e)) {
          document.documentElement.dataset.accent = "off-hours";
          // The Web Audio engine is pulled in on the gesture that needs
          // it, not on every page load.
          void import("../scripts/sound").then((m) => m.playAccent("pop")).catch(() => undefined);
        }
      });
      document.addEventListener("keyup", () => {
        if (document.documentElement.dataset.accent === "off-hours") {
          delete document.documentElement.dataset.accent;
        }
      });

    </script>
  </body>
</html>

<style>
  .page-label {
    margin: 0;
    max-inline-size: 18ch;
    color: var(--ink);
    font-size: clamp(1.85rem, 4vw, 2.45rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  main:has(.page-label) :global(> .page-label + *) {
    margin-top: var(--space-content-lead);
  }
</style>
