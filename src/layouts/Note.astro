---
/**
 * Note.astro - the long-form reading layout for `/library/notes/*`.
 *
 * Everything the blog engine offers is assembled here:
 *   - article chrome: back link, "notes" label, balanced H1, meta row
 *     (date · reading time · tags, "Updated" stamp, lede)
 *   - an auto table of contents (render()'s `headings`), with scroll-spy
 *   - the `.prose` body, scrolled into by the balcony's reading-progress hairline
 *   - after the article: prev/next navigation, related-by-tag notes
 *   - JSON-LD: enriched BlogPosting + BreadcrumbList
 *   - KaTeX CSS linked only when the note body contains math
 *
 * The layout is presentation; the markdown pipeline (mermaid, callouts, math,
 * code figures, anchors) already ran at build. Client behaviour lives in
 * `src/scripts/prose.ts`, loaded by this layout.
 */
import { render, type CollectionEntry } from "astro:content";
import Page from "./Page.astro";
import { noteJsonLd, noteBreadcrumbJsonLd } from "../lib/jsonld";
import { wordCount } from "../lib/jsonld-safe";
import { plainText, readingTimeMinutes, excerpt } from "../lib/markdown-text";
import { ogPath } from "../lib/og-url";
import { linkedTagSet } from "../lib/tags";
import { absUrl, slashPath } from "../lib/urls";
import Icon from "../components/Icon.astro";
import DetailHeader from "../components/DetailHeader.astro";
import Pager from "../components/Pager.astro";
import RowTags from "../components/RowTags.astro";
import GoTourEnhancement from "../components/GoTourEnhancement.astro";
import katexCss from "katex/dist/katex.min.css?url";
import "../styles/prose.css";

interface Props {
  entry: CollectionEntry<"notes">;
  prev?: { id: string; title: string; date: Date } | null;
  next?: { id: string; title: string; date: Date } | null;
  related?: { id: string; title: string }[];
}

const { entry, prev, next, related = [] } = Astro.props;
const { Content } = await render(entry);

const body = entry.body ?? "";
const minutes = readingTimeMinutes(body);
const words = wordCount(plainText(body));
const autoExcerpt = excerpt(body, 200);
const description = entry.data.description ?? autoExcerpt;
const notePath = slashPath(`/blog/${entry.id}`);
const mdPath = `/blog/${entry.id}.md`;
const image = ogPath(`blog/${entry.id}`);
const linkedTags = await linkedTagSet();

/** True when the note body contains KaTeX-bound math ($…$ / $$…$$). */
function bodyHasMath(md: string): boolean {
  if (/\$\$[\s\S]+?\$\$/.test(md)) return true;
  return /(?<!\$)\$(?!\$)[^$\n]+?\$(?!\$)/.test(md);
}
const hasMath = bodyHasMath(body);


const writingsHref = "/library/?view=notes";
const pagerItem = (n?: { id: string; title: string } | null) =>
  n ? { href: slashPath(`/blog/${n.id}`), title: n.title } : null;

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const jsonLd = [
  noteJsonLd(entry, notePath, {
    description,
    readingMinutes: minutes,
    tags: entry.data.tags,
    wordCount: words,
    image,
  }),
  noteBreadcrumbJsonLd(entry.data.title, notePath),
];
  const isGoTour = entry.id === "go-1-27-interactive-tour";
---

<Page
  title={entry.data.title}
  description={description}
  ogType="article"
  ogImage={image}
  ogImageAlt={entry.data.title}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  jsonLd={jsonLd}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
  alternates={[
    { href: absUrl(mdPath), type: "text/markdown", title: "Markdown source" },
  ]}
>
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <article class="note" data-note data-has-math={hasMath ? "true" : undefined} data-note-tour={isGoTour ? "go-1-27" : undefined}>
    <div class="note-progress" aria-hidden="true"><div class="note-progress-bar"></div></div>

    <div class="note-layout">
      <div class="note-main">
        <DetailHeader
          title={entry.data.title}
          lede={entry.data.description}
          back={{ href: writingsHref, label: "Writings" }}
        >
          <Fragment slot="meta">
            <span class="note-facts">
              <time class="note-date mono" datetime={entry.data.date.toISOString()}>
                {fmtDate(entry.data.date)}
              </time>
              <span class="note-read">{minutes} min read</span>
              {entry.data.updated && <span class="note-updated">Updated {fmtDate(entry.data.updated)}</span>}
            </span>
            {entry.data.tags && <RowTags tags={entry.data.tags} linked={linkedTags} />}
          </Fragment>
          <Fragment slot="action">
            <button type="button" class="ui-cap ui-cap--glass ui-cap--32" data-fx="spot" data-copy data-state="idle">
              <span class="ui-cap__label ui-stk">
                <span data-when="idle">Copy link</span>
                <span data-when="done">Copied</span>
                <span data-when="error">Retry</span>
              </span>
            </button>
          </Fragment>
        </DetailHeader>


        <div class="prose" data-enter>
          <Content />
        </div>

        <footer class="note-foot">
          <div class="note-bar">
            <a class="ui-cap ui-cap--quiet ui-cap--32 ui-cap--lead note-back" href={writingsHref}>
              <span class="ui-arw ui-arw--back">
                <Icon name="arrow-left" size={14} strokeWidth={2} />
                <Icon name="arrow-left" size={14} strokeWidth={2} />
              </span>
              <span class="ui-cap__label">All writings</span>
            </a>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="note-bar-tags"><RowTags tags={entry.data.tags} linked={linkedTags} /></div>
            )}
            <button type="button" class="ui-cap ui-cap--glass ui-cap--32 note-copy" data-fx="spot" data-copy data-state="idle">
              <span class="ui-cap__label ui-stk">
                <span data-when="idle">Copy link</span>
                <span data-when="done">Copied</span>
                <span data-when="error">Retry</span>
              </span>
            </button>
          </div>

          <Pager prev={pagerItem(prev)} next={pagerItem(next)} label="More notes" noteNav />

          {related.length > 0 && (
            <section class="note-related">
              <h2 class="note-related-title">Related</h2>
              <ul class="note-related-list surface-stack">
                {related.map((r) => (
                  <li>
                    <a class="ui-row" href={slashPath(`/blog/${r.id}`)}>
                      <span class="ui-row__title">{r.title}</span>
                      <span class="ui-row__glyph"><Icon name="arrow-right" size={16} /></span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </footer>
      </div>
    </div>
    {isGoTour && <GoTourEnhancement />}
  </article>
</Page>

<script>
  import "../scripts/prose";
  import "../scripts/clipboard";
</script>

<style>
  .note {
    position: relative;
    max-inline-size: min(100%, var(--measure-prose));
    min-inline-size: 0;
  }

  .note-layout,
  .note-main,
  .note-foot {
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .note-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: var(--z-progress);
    background: transparent;
    pointer-events: none;
  }
  .note-progress-bar {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--ink);
  }

  /* Where the browser supports it, reading progress is driven by a
     scroll-driven animation instead of by JavaScript. The bar then
     updates on the compositor in lockstep with the scroll — it cannot
     lag, cannot tear away from the scroll position under load, and costs
     no main-thread work at all. prose.ts detects this support and skips
     binding its own handler.

     `contain 0%` to `contain 100%` is the range where the article fully
     contains the viewport: article top at viewport top, through to
     article bottom at viewport bottom. Same definition of progress the
     JS used, expressed declaratively. */
  @supports (animation-timeline: view()) {
    .note[data-note] {
      view-timeline: --note-read block;
    }

    .note-progress-bar {
      animation: note-read-progress linear both;
      animation-timeline: --note-read;
      animation-range: contain 0% contain 100%;
    }

    @keyframes note-read-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-progress { display: none; }
  }

  .note-layout {
    position: relative;
  }

  .note-facts {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2);
    font-size: var(--text-sm);
    color: var(--ghost);
  }

  .note-facts > * + *::before {
    content: "·";
    margin-right: var(--step-2);
    color: var(--faint);
    font-weight: var(--font-bold);
  }

  .note-date {
    color: var(--muted);
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .note-read,
  .note-updated { color: var(--faint); }

  .note-foot {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  /* End of note: back to the list on the left, the note's own controls on
     the right. On a phone the chips drop to a row of their own so back and
     copy keep the first. */
  .note-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--step-2);
    padding-block: var(--step-4);
    border-top: 1px solid var(--rule);
    transition: border-color var(--t-color);
  }

  .note-back {
    margin-inline-start: calc(var(--step-2) * -1);
  }

  .note-bar-tags {
    margin-inline-start: auto;
    min-inline-size: 0;
  }

  .note-copy {
    margin-inline-start: auto;
  }

  .note-bar-tags + .note-copy {
    margin-inline-start: var(--step-2);
  }

  @media (max-width: 38rem) {
    .note-bar-tags {
      order: 1;
      flex: 1 0 100%;
      margin-inline-start: 0;
    }

    .note-bar-tags + .note-copy {
      margin-inline-start: auto;
    }
  }

  .note-foot :global(.ui-pager) {
    margin-block-start: var(--step-2);
  }

  .note-related {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }
  .note-related-title {
    margin: 0 0 var(--step-1);
    color: var(--ghost);
    font-size: var(--text-sm);
    font-weight: 580;
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
  }
  .note-related-list {
    --surface-row-gap: 0;
  }
</style>
