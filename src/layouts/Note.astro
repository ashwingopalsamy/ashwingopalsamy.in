---
/**
 * Note.astro - the long-form reading layout for `/library/notes/*`.
 *
 * Everything the blog engine offers is assembled here:
 *   - article chrome: back link, "notes" label, balanced H1, meta row
 *     (date · reading time · tags, "Updated" stamp, lede)
 *   - an auto table of contents (render()'s `headings`), with scroll-spy
 *   - the `.prose` body, scrolled into by the balcony's reading-progress hairline
 *   - after the article: prev/next navigation, related-by-tag notes
 *   - JSON-LD: enriched BlogPosting + BreadcrumbList
 *   - KaTeX CSS linked only when the note body contains math
 *
 * The layout is presentation; the markdown pipeline (mermaid, callouts, math,
 * code figures, anchors) already ran at build. Client behaviour lives in
 * `src/scripts/prose.ts`, loaded by this layout.
 */
import { render, type CollectionEntry } from "astro:content";
import Page from "./Page.astro";
import { noteJsonLd, noteBreadcrumbJsonLd } from "../lib/jsonld";
import { wordCount } from "../lib/jsonld-safe";
import { plainText, readingTimeMinutes, excerpt } from "../lib/markdown-text";
import { ogPath } from "../lib/og-url";
import { linkedTagSet, tagHref, isLinkedTag } from "../lib/tags";
import { absUrl, slashPath } from "../lib/urls";
import Icon from "../components/Icon.astro";
import DetailHeader from "../components/DetailHeader.astro";
import GoTourEnhancement from "../components/GoTourEnhancement.astro";
import katexCss from "katex/dist/katex.min.css?url";
import "../styles/prose.css";

interface Props {
  entry: CollectionEntry<"notes">;
  prev?: { id: string; title: string; date: Date } | null;
  next?: { id: string; title: string; date: Date } | null;
  related?: { id: string; title: string }[];
}

const { entry, prev, next, related = [] } = Astro.props;
const { Content } = await render(entry);

const body = entry.body ?? "";
const minutes = readingTimeMinutes(body);
const words = wordCount(plainText(body));
const autoExcerpt = excerpt(body, 200);
const description = entry.data.description ?? autoExcerpt;
const notePath = slashPath(`/blog/${entry.id}`);
const mdPath = `/blog/${entry.id}.md`;
const image = ogPath(`blog/${entry.id}`);
const linkedTags = await linkedTagSet();

/** True when the note body contains KaTeX-bound math ($…$ / $$…$$). */
function bodyHasMath(md: string): boolean {
  if (/\$\$[\s\S]+?\$\$/.test(md)) return true;
  return /(?<!\$)\$(?!\$)[^$\n]+?\$(?!\$)/.test(md);
}
const hasMath = bodyHasMath(body);


const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const jsonLd = [
  noteJsonLd(entry, notePath, {
    description,
    readingMinutes: minutes,
    tags: entry.data.tags,
    wordCount: words,
    image,
  }),
  noteBreadcrumbJsonLd(entry.data.title, notePath),
];
  const isGoTour = entry.id === "go-1-27-interactive-tour";
---

<Page
  title={entry.data.title}
  description={description}
  ogType="article"
  ogImage={image}
  ogImageAlt={entry.data.title}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  jsonLd={jsonLd}
  alternateFeeds={[
    { href: absUrl("/library/feed.xml"), title: "Library RSS", type: "application/rss+xml" },
    { href: absUrl("/library/feed.json"), title: "Library JSON Feed", type: "application/feed+json" },
  ]}
  alternates={[
    { href: absUrl(mdPath), type: "text/markdown", title: "Markdown source" },
  ]}
>
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <article class="note" data-note data-has-math={hasMath ? "true" : undefined} data-note-tour={isGoTour ? "go-1-27" : undefined}>
    <div class="note-progress" aria-hidden="true"><div class="note-progress-bar"></div></div>

    <div class="note-layout">
      <div class="note-main">
        <DetailHeader title={entry.data.title} lede={entry.data.description}>
          <Fragment slot="meta">
            <span class="note-facts">
              <time class="note-date mono" datetime={entry.data.date.toISOString()}>
                {fmtDate(entry.data.date)}
              </time>
              <span class="note-read">{minutes} min read</span>
              {entry.data.updated && <span class="note-updated">Updated {fmtDate(entry.data.updated)}</span>}
            </span>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <>
                <span class="detail-sep" aria-hidden="true">·</span>
                <span class="note-tags">
                  {entry.data.tags.map((t) =>
                    isLinkedTag(t, linkedTags) ? (
                      <a class="note-tag" href={tagHref(t)}>#{t}</a>
                    ) : (
                      <span class="note-tag">#{t}</span>
                    ),
                  )}
                </span>
              </>
            )}
          </Fragment>
          <Fragment slot="action">
            <button type="button" class="note-copy-link" data-copy-link aria-label="Copy link" title="Copy link">
              <Icon name="copy" size={14} />
            </button>
          </Fragment>
        </DetailHeader>


        <div class="prose" data-enter>
          <Content />
        </div>

        <footer class="note-foot">
          {(prev || next) && (
            <nav class="note-pager" aria-label="More notes">
              {prev ? (
                <a class="note-page note-prev" href={`/blog/${prev.id}`} rel="prev" title="Previous note" data-note-nav="prev">
                  <span class="note-page-dir"><span class="note-page-icon"><Icon name="arrow-left" size={15} /></span>Previous note</span>
                  <span class="note-page-title">{prev.title}</span>
                </a>
              ) : <span class="note-page note-prev is-empty" aria-hidden="true"></span>}
              {next ? (
                <a class="note-page note-next" href={`/blog/${next.id}`} rel="next" title="Next note" data-note-nav="next">
                  <span class="note-page-dir">Next note<span class="note-page-icon"><Icon name="arrow-right" size={15} /></span></span>
                  <span class="note-page-title">{next.title}</span>
                </a>
              ) : <span class="note-page note-next is-empty" aria-hidden="true"></span>}
            </nav>
          )}

          {related.length > 0 && (
            <section class="note-related">
              <h2 class="note-related-title">Related notes</h2>
              <ul class="note-related-list">
                {related.map((r) => (
                  <li>
                    <a href={`/blog/${r.id}`}><span>{r.title}</span><Icon name="chevron-right" size={15} /></a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </footer>
      </div>
    </div>
    {isGoTour && <GoTourEnhancement />}
  </article>
</Page>

<script>
  import "../scripts/prose";
</script>

<style>
  .note {
    position: relative;
    max-inline-size: min(100%, var(--measure-prose));
    min-inline-size: 0;
  }

  .note-layout,
  .note-main,
  .note-header,
  .note-foot {
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .note-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: var(--z-progress);
    background: transparent;
    pointer-events: none;
  }
  .note-progress-bar {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--ink);
  }

  /* Where the browser supports it, reading progress is driven by a
     scroll-driven animation instead of by JavaScript. The bar then
     updates on the compositor in lockstep with the scroll — it cannot
     lag, cannot tear away from the scroll position under load, and costs
     no main-thread work at all. prose.ts detects this support and skips
     binding its own handler.

     `contain 0%` to `contain 100%` is the range where the article fully
     contains the viewport: article top at viewport top, through to
     article bottom at viewport bottom. Same definition of progress the
     JS used, expressed declaratively. */
  @supports (animation-timeline: view()) {
    .note[data-note] {
      view-timeline: --note-read block;
    }

    .note-progress-bar {
      animation: note-read-progress linear both;
      animation-timeline: --note-read;
      animation-range: contain 0% contain 100%;
    }

    @keyframes note-read-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-progress { display: none; }
  }

  .note-layout {
    position: relative;
  }

  .note-facts {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ghost);
  }

  .note-facts > * + *::before {
    content: "·";
    margin-right: 0.4rem;
    color: var(--faint);
    font-weight: var(--font-bold);
  }

  .note-date {
    color: var(--muted);
    font-family: "JetBrains Mono", "JetBrains Mono Fallback", ui-monospace, monospace;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .note-read,
  .note-updated { color: var(--faint); }

  .note-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    align-items: center;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }

  .note-tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    color: var(--ghost);
    background: var(--canvas);
    border: 1px solid var(--chrome-surface-border);
    box-shadow: var(--chrome-surface-shadow);
    padding: 0.12rem 0.55rem;
    border-radius: var(--r-pill);
    text-decoration: none;
    line-height: 1.25;
    transition:
      color var(--t-color),
      background-color var(--t-color),
      border-color var(--t-color),
      box-shadow var(--t-color);
  }

  a.note-tag:hover {
    color: var(--ink);
    border-color: color-mix(in oklch, var(--ink) 18%, transparent);
    background: color-mix(in oklch, var(--ink) 3%, var(--canvas));
  }

  .note-toc-rail {
    display: none;
  }

  .note-toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-inline-size: 100%;
    min-inline-size: 0;
  }
  .note-toc-item a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
    display: inline-block;
    transition: color var(--t-color);
    max-inline-size: 100%;
    overflow-wrap: anywhere;
  }
  .note-toc-item a:hover { color: var(--ink); }
  .note-toc-item.is-sub { padding-left: 1.1rem; }
  .note-toc-item a[aria-current="true"] {
    color: var(--ink);
  }

  @media (min-width: 72rem) {
    .note-toc-rail {
      display: block;
      position: fixed;
      right: clamp(0.75rem, 2.5vw, 2.5rem);
      top: 50%;
      transform: translateY(-50%);
      z-index: 40;
      user-select: none;
      pointer-events: none;
    }

    .note-toc-rail-track {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding: 0.5rem 0;
      pointer-events: auto;
    }

    .note-toc-btn {
      appearance: none;
      border: 0;
      background: transparent;
      padding: 0;
      margin: 0;
      width: 2.25rem;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      cursor: pointer;
      outline: none;
      border-radius: var(--r-pill);
      position: relative;
    }

    .note-toc-btn:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }

    .note-toc-dash {
      display: block;
      border-radius: var(--r-pill);
      transition: width var(--dur-2) var(--ease-out), height var(--dur-2) var(--ease-out), background-color var(--t-color), opacity var(--t-color), box-shadow var(--t-color);
      width: 14px;
      height: 1.5px;
      background: var(--muted);
      opacity: 0.35;
    }

    .note-toc-btn.is-sub .note-toc-dash {
      width: 9px;
      opacity: 0.25;
    }

    .note-toc-btn:hover .note-toc-dash {
      width: 20px;
      height: 2px;
      opacity: 0.85;
      background: var(--ink);
    }

    .note-toc-btn.is-sub:hover .note-toc-dash {
      width: 15px;
      height: 2px;
      opacity: 0.85;
      background: var(--ink);
    }

    .note-toc-btn.is-active .note-toc-dash {
      width: 26px;
      height: 2.5px;
      opacity: 1;
      background: var(--ink);
      box-shadow: none;
    }

    .note-toc-btn.is-sub.is-active .note-toc-dash {
      width: 22px;
      height: 2.5px;
      opacity: 1;
      background: var(--ink);
      box-shadow: none;
    }

    .note-toc-tooltip {
      position: absolute;
      right: calc(100% + 0.75rem);
      top: 0;
      transform: translateY(-50%);
      padding: 0.32rem 0.8rem;
      border-radius: var(--r-pill);
      background: var(--chrome-surface-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--chrome-surface-border);
      color: var(--ink);
      font-size: 0.75rem;
      font-weight: var(--font-medium);
      white-space: nowrap;
      pointer-events: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      transition: top 0.12s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease, transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      visibility: hidden;
    }

    :root[data-theme="dark"] .note-toc-tooltip {
      background: var(--chrome-surface-bg);
      border-color: var(--chrome-surface-border);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.25);
    }

    .note-toc-rail-track.is-hovered .note-toc-tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-toc-dash,
    .note-toc-tooltip {
      transition: none !important;
    }
  }

  .note-foot {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .note-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    margin-top: 0;
    max-inline-size: 100%;
    min-inline-size: 0;
  }
  .note-page {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.6rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--r-3);
    background: transparent;
    border: none;
    box-shadow: none;
    text-decoration: none;
    color: var(--ink);
    min-width: 0;
    transition:
      background-color var(--t-color),
      transform var(--dur-1) var(--ease-out);
  }
  .note-next { text-align: end; align-items: flex-end; }
  .note-page.is-empty { visibility: hidden; }
  .note-page-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: var(--font-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ghost);
    transition: color var(--t-color);
  }
  .note-page-icon {
    display: grid;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .note-page-title {
    font-size: 0.9375rem;
    font-weight: var(--font-medium);
    line-height: 1.4;
    color: var(--ink);
    transition: color var(--t-color);
    text-decoration: none;
    max-width: 100%;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .note-page:active {
    background: color-mix(in oklch, var(--ink) 6%, transparent);
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .note-page:hover,
    .note-page:focus-visible {
      background: color-mix(in oklch, var(--ink) 4%, transparent);
    }
    .note-page:hover .note-page-dir,
    .note-page:focus-visible .note-page-dir { color: var(--ink); }
    .note-prev:hover .note-page-icon,
    .note-prev:focus-visible .note-page-icon { transform: translateX(-2px); }
    .note-next:hover .note-page-icon,
    .note-next:focus-visible .note-page-icon { transform: translateX(2px); }
  }

  .note-related {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }
  .note-related-title {
    margin: 0 0 0.85rem;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 580;
    letter-spacing: -0.01em;
  }
  .note-related-list {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .note-related-list:hover a {
      opacity: var(--dim-opacity);
      filter: blur(var(--dim-blur));
      transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
    }
    .note-related-list:hover a:hover,
    .note-related-list:hover a:focus-visible {
      opacity: 1;
      filter: none;
    }
  }
  .note-related-list a {
    display: flex;
    min-block-size: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--r-3);
    background: transparent;
    border: none;
    box-shadow: none;
    font-size: var(--text-sm);
    color: var(--ghost);
    text-decoration: none;
    transition:
      color var(--t-color),
      background-color var(--t-color),
      opacity var(--dur-2) var(--ease),
      filter var(--dur-2) var(--ease),
      transform var(--dur-1) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .note-related-list a:hover,
    .note-related-list a:focus-visible {
      color: var(--ink);
      background: color-mix(in oklch, var(--ink) 3.5%, transparent);
    }
  }
  .note-related-list a:active {
    background: color-mix(in oklch, var(--ink) 6.5%, transparent);
    transform: scale(0.995);
  }

  @media (max-width: 38rem) {
    .note-lede {
      text-align: justify;
      text-justify: inter-word;
      hyphens: none;
      -webkit-hyphens: none;
      text-wrap: pretty;
    }
    .note-pager {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding-top: 1.5rem;
    }
    .note-next { text-align: start; align-items: flex-start; }
    .note-page { padding: 0.5rem 0.65rem; margin-inline: -0.65rem; }
    .note-page.is-empty { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-page-icon { transform: none !important; }
  }
</style>
